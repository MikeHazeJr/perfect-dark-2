{
  "scenario_name": "scenario_source_matrix_defection",
  "description": "c3844 runtime matrix smoke: boot base:scenario_defection with Scenario source-only enabled and prove core stage-load products come from public .pdscenario source.",
  "tags": [
    "modding",
    "pdxxx",
    "scenario",
    "source-gate",
    "stage-load",
    "source-matrix",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/scenario_source_runtime.c",
    "port/src/loader_walker_scenario.c",
    "src/game/setup.c",
    "src/lib/collision.c",
    "src/game/player.c",
    "tools/smoke-verify/run-scenario-source-matrix.ps1",
    "tools/smoke-verify/fixtures/archive_walker_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 120,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/archive_walker_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--boot-stage",
    "0x30"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "direct stage load should bind base:scenario_defection and compile core runtime products from public .pdscenario source."
    },
    {
      "at_ms": 105000,
      "type": "exit",
      "comment": "scripted exit after source-owned scene collision, portals, pads, and graph activation have logged."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=scenario_source_matrix_defection",
      "LOAD: lv\\.c entering stage load sequence for stagenum=0x0*30",
      "SCENARIO\\.SOURCE: added scene colmesh 'base:scenario_defection' tris=\\d+ source=.*base_scenario_defection\\.pdscenario::collision\\.obj",
      "SCENARIO\\.SOURCE: compiled portals\\.tsv '.*base_scenario_defection\\.pdscenario::portals\\.tsv' for stage '.*' as \\d+ portals \\(\\d+ bytes\\)",
      "SCENARIO\\.SOURCE: built native portal tables 'base:scenario_defection' portals=\\d+ room_refs=\\d+ source=portals\\.tsv",
      "SCENARIO\\.GRAPH: activated level graph 'base:scenario_defection' path=.*base_scenario_defection\\.pdscenario::level\\.graph\\.json bytes=\\d+ stage='.*'",
      "SCENARIO\\.GRAPH: table refs 'base:scenario_defection' pads=.*base_scenario_defection\\.pdscenario::pads\\.tsv spawns=.*base_scenario_defection\\.pdscenario::spawns\\.tsv setup=.*base_scenario_defection\\.pdscenario::setup\\.fields\\.tsv ai=.*base_scenario_defection\\.pdscenario::ai/ailists\\.tsv objects=.*base_scenario_defection\\.pdscenario::objects\\.tsv volumes=.*base_scenario_defection\\.pdscenario::volumes\\.tsv objectives=.*base_scenario_defection\\.pdscenario::objectives\\.tsv waypoints=.*base_scenario_defection\\.pdscenario::navigation/waypoints\\.tsv waygroups=.*base_scenario_defection\\.pdscenario::navigation/waygroups\\.tsv covers=.*base_scenario_defection\\.pdscenario::navigation/covers\\.tsv paths=.*base_scenario_defection\\.pdscenario::navigation/paths\\.tsv",
      "SCENARIO\\.SOURCE: compiled pads\\.tsv '.*base_scenario_defection\\.pdscenario::pads\\.tsv' for stage '.*' as \\d+ pads, \\d+ waypoints, \\d+ waygroups, \\d+ covers \\(\\d+ bytes\\)"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "RomProvider:filenum",
      "refusing fallback",
      "GROUNDSNAP: ignoring invalid chr->ground",
      "SETUP: failed to load pads",
      "SETUP\\.PADS: invalid waypoint"
    ],
    "required_counts": [
      {
        "pattern": "SCENARIO\\.SOURCE: added scene colmesh 'base:scenario_defection'",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "SCENARIO\\.SOURCE: compiled portals\\.tsv '.*base_scenario_defection\\.pdscenario::portals\\.tsv'",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "SCENARIO\\.SOURCE: built native portal tables 'base:scenario_defection'",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "SCENARIO\\.GRAPH: activated level graph 'base:scenario_defection'",
        "min": 1,
        "max": 1
      }
    ]
  }
}
