{
  "scenario_name": "all_family_source_matrix_batch_125",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 125 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m2_no_escape_for_you,sfx=base:sfx_m2_retreat,sfx=base:sfx_m2_run_for_it,sfx=base:sfx_m2_scatter,sfx=base:sfx_m2_someones_nearby,sfx=base:sfx_m2_stay_back,sfx=base:sfx_m2_stop_moving,sfx=base:sfx_m2_surrender_or_die,sfx=base:sfx_m2_take_this,sfx=base:sfx_m2_target_sighted,sfx=base:sfx_m2_team_up_guys,sfx=base:sfx_m2_that_was_close,sfx=base:sfx_m2_that_was_my_best_friend,sfx=base:sfx_m2_there_attack,sfx=base:sfx_m2_try_this_for_size,sfx=base:sfx_m2_watch_out,sfx=base:sfx_m2_were_gonna_die,sfx=base:sfx_m2_weve_got_an_intruder,sfx=base:sfx_m2_why_you,sfx=base:sfx_m2_you_want_beat_me"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_125",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_no_escape_for_you' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_no_escape_for_you' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_retreat' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_retreat' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_run_for_it' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_run_for_it' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_scatter' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_scatter' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_someones_nearby' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_someones_nearby' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_stay_back' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_stay_back' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_stop_moving' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_stop_moving' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_surrender_or_die' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_surrender_or_die' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_take_this' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_take_this' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_target_sighted' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_target_sighted' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_team_up_guys' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_team_up_guys' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_that_was_close' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_that_was_close' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_that_was_my_best_friend' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_that_was_my_best_friend' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_there_attack' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_there_attack' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_try_this_for_size' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_try_this_for_size' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_watch_out' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_watch_out' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_were_gonna_die' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_were_gonna_die' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_weve_got_an_intruder' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_weve_got_an_intruder' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_why_you' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_why_you' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_you_want_beat_me' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_you_want_beat_me' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 20,
        "max": 20
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
  }
}
