      "BOOT: --debug-load-catalog-assets result type=head id='base:head_carrington' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_carter' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_carter' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_cassandra' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_cassandra' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
