      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:king_of_the_hill' result=OK",
      "BOOT: --debug-load-catalog-assets request type=gamemode id='base:pop_a_cap' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:pop_a_cap' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_a51faceplate' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_a51faceplate' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_alex' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_alex' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_andy_r' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_andy_r' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_anka' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_anka' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_beau1' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_beau1' result=OK",
      "BOOT: --debug-load-catalog-assets request type=head id='base:head_ben_r' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_ben_r' result=OK",
