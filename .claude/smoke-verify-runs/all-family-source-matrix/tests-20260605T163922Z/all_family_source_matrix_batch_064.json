{
  "scenario_name": "all_family_source_matrix_batch_064",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 64 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "effect=base:effect_shimmer,effect=base:effect_tint,font=base:font_fontjpnsingle,gamemode=base:capture_the_case,gamemode=base:combat,gamemode=base:hacker_central,gamemode=base:hold_the_briefcase,gamemode=base:king_of_the_hill,gamemode=base:pop_a_cap,head=base:head_a51faceplate,head=base:head_alex,head=base:head_andy_r,head=base:head_anka,head=base:head_beau1,head=base:head_ben_r,head=base:head_biotech,head=base:head_brian,head=base:head_carrington,head=base:head_carter,head=base:head_cassandra"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_064",
      "BOOT: --debug-load-catalog-assets request type=effect id='base:effect_shimmer' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=effect id='base:effect_shimmer' result=OK",
      "BOOT: --debug-load-catalog-assets request type=effect id='base:effect_tint' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=effect id='base:effect_tint' result=OK",
      "BOOT: --debug-load-catalog-assets request type=font id='base:font_fontjpnsingle' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=font id='base:font_fontjpnsingle' result=OK",
      "BOOT: --debug-load-catalog-assets request type=gamemode id='base:capture_the_case' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:capture_the_case' result=OK",
      "BOOT: --debug-load-catalog-assets request type=gamemode id='base:combat' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:combat' result=OK",
      "BOOT: --debug-load-catalog-assets request type=gamemode id='base:hacker_central' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:hacker_central' result=OK",
      "BOOT: --debug-load-catalog-assets request type=gamemode id='base:hold_the_briefcase' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:hold_the_briefcase' result=OK",
