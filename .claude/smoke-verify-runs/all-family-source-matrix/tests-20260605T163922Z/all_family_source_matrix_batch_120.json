{
  "scenario_name": "all_family_source_matrix_batch_120",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 120 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m0_whats_this,sfx=base:sfx_m0_who_the,sfx=base:sfx_m0_wipe_her_out,sfx=base:sfx_m0_withdraw,sfx=base:sfx_m0_you_shot_me,sfx=base:sfx_m0_you_win_i_surrender,sfx=base:sfx_m1_another_one_bites_the_dust,sfx=base:sfx_m1_bring_it_on,sfx=base:sfx_m1_catch_this,sfx=base:sfx_m1_choking,sfx=base:sfx_m1_cover_me_now,sfx=base:sfx_m1_dont_shoot,sfx=base:sfx_m1_dont_touch_it,sfx=base:sfx_m1_evacuate_the_area,sfx=base:sfx_m1_everybody_get_her,sfx=base:sfx_m1_everyone_get_back,sfx=base:sfx_m1_fall_back,sfx=base:sfx_m1_freeze,sfx=base:sfx_m1_get_some_backup,sfx=base:sfx_m1_go_for_it"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_120",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m0_whats_this' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m0_whats_this' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m0_who_the' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m0_who_the' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m0_wipe_her_out' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m0_wipe_her_out' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m0_withdraw' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m0_withdraw' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m0_you_shot_me' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m0_you_shot_me' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m0_you_win_i_surrender' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m0_you_win_i_surrender' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_another_one_bites_the_dust' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_another_one_bites_the_dust' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_bring_it_on' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_bring_it_on' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_catch_this' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_catch_this' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_choking' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_choking' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_cover_me_now' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_cover_me_now' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_dont_shoot' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_dont_shoot' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_dont_touch_it' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_dont_touch_it' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_evacuate_the_area' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_evacuate_the_area' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_everybody_get_her' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_everybody_get_her' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_everyone_get_back' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_everyone_get_back' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_fall_back' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_fall_back' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_freeze' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_freeze' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_get_some_backup' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_get_some_backup' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_go_for_it' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_go_for_it' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 20,
        "max": 20
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
  }
}
