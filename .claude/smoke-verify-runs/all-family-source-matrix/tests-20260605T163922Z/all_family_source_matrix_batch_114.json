{
  "scenario_name": "all_family_source_matrix_batch_114",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 114 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_disguise_on,sfx=base:sfx_door_042b,sfx=base:sfx_door_042c,sfx=base:sfx_drcaroll_0249,sfx=base:sfx_drcaroll_come_on,sfx=base:sfx_drcaroll_dont_they_know,sfx=base:sfx_drcaroll_get_out_of_here,sfx=base:sfx_drcaroll_going_to_the_helipad,sfx=base:sfx_drcaroll_goodbye,sfx=base:sfx_drcaroll_goodness_gracious,sfx=base:sfx_drcaroll_i_cant_make_it,sfx=base:sfx_drcaroll_im_dying,sfx=base:sfx_drcaroll_know_what_youre_doing,sfx=base:sfx_drcaroll_oh_crikey,sfx=base:sfx_drcaroll_quite_enough,sfx=base:sfx_drcaroll_stop_that,sfx=base:sfx_drcaroll_systems_failure,sfx=base:sfx_drcaroll_taking_your_time,sfx=base:sfx_drcaroll_what,sfx=base:sfx_drcaroll_you_go_on"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_114",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_disguise_on' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_disguise_on' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_door_042b' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_door_042b' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_door_042c' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_door_042c' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_0249' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_0249' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_come_on' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_come_on' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_dont_they_know' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_dont_they_know' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_get_out_of_here' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_get_out_of_here' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_going_to_the_helipad' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_going_to_the_helipad' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_goodbye' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_goodbye' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_goodness_gracious' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_goodness_gracious' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_i_cant_make_it' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_i_cant_make_it' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_im_dying' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_im_dying' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_know_what_youre_doing' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_know_what_youre_doing' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_oh_crikey' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_oh_crikey' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_quite_enough' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_quite_enough' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_stop_that' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_stop_that' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_systems_failure' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_systems_failure' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_taking_your_time' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_taking_your_time' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_what' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_what' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_drcaroll_you_go_on' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_drcaroll_you_go_on' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 20,
        "max": 20
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
  }
}
