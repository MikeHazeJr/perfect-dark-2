{
  "scenario_name": "all_family_source_matrix_batch_060",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 60 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "botprofile=base:bot_hard,botprofile=base:bot_judge,botprofile=base:bot_kaze,botprofile=base:bot_meat,botprofile=base:bot_normal,botprofile=base:bot_peace,botprofile=base:bot_perfect,botprofile=base:bot_prey,botprofile=base:bot_rocket,botprofile=base:bot_shield,botprofile=base:bot_speed,botprofile=base:bot_turtle,botprofile=base:bot_venge,character=base:character_a51airman,character=base:character_a51trooper,character=base:character_alaskan_guard,character=base:character_area51guard,character=base:character_biotech,character=base:character_carreveningsuit,character=base:character_carrington"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_060",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_hard' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_hard' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_judge' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_judge' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_kaze' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_kaze' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_meat' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_meat' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_normal' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_normal' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_peace' source_only=1",
