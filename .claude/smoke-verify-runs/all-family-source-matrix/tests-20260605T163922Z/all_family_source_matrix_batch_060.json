      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_rocket' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_shield' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_shield' result=OK",
      "BOOT: --debug-load-catalog-assets request type=botprofile id='base:bot_speed' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_speed' result=OK",
