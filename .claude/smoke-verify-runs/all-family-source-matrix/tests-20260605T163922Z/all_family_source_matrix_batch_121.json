{
  "scenario_name": "all_family_source_matrix_batch_121",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 121 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m1_go_go_go,sfx=base:sfx_m1_grenade,sfx=base:sfx_m1_gunfire,sfx=base:sfx_m1_halt,sfx=base:sfx_m1_help_me_out,sfx=base:sfx_m1_here_keep_it,sfx=base:sfx_m1_how_did_that_get_here,sfx=base:sfx_m1_i_cant_see_anybody,sfx=base:sfx_m1_im_bleeding,sfx=base:sfx_m1_im_going_for_cover,sfx=base:sfx_m1_im_hit_im_hit,sfx=base:sfx_m1_im_in_trouble,sfx=base:sfx_m1_im_just_too_good,sfx=base:sfx_m1_im_only_doing_my_job,sfx=base:sfx_m1_is_that_a_bullet,sfx=base:sfx_m1_last_mistake,sfx=base:sfx_m1_m2_look_out_look_out,sfx=base:sfx_m1_m2_look_out_shes_coming,sfx=base:sfx_m1_m2_take_cover,sfx=base:sfx_m1_my_gun_its_useless"
