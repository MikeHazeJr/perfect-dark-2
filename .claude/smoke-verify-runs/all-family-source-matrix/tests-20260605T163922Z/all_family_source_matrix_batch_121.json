      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_m2_look_out_look_out' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_m2_look_out_shes_coming' source_only=1",
