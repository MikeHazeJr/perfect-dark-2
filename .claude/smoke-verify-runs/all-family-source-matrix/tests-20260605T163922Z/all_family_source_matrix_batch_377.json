{
  "scenario_name": "all_family_source_matrix_batch_377",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 377 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "weapon=base:superdragon,weapon=base:targetamplifier,weapon=base:tester,weapon=base:timedmine,weapon=base:tracerbug,weapon=base:tranquilizer,weapon=base:unarmed,weapon=base:watchlaser,weapon=base:xrayscanner"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_377",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:superdragon' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:superdragon' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:targetamplifier' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:targetamplifier' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:tester' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:tester' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:timedmine' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:timedmine' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:tracerbug' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:tracerbug' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:tranquilizer' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:tranquilizer' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:unarmed' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:unarmed' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:watchlaser' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:watchlaser' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:xrayscanner' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:xrayscanner' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 9,
        "max": 9
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 9,
        "max": 9
      }
    ]
  }
}
