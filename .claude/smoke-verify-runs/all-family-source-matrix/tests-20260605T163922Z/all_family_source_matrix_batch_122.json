      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_split_up' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_split_up' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_spread_out' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_spread_out' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_stop_dodging' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_stop_dodging' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_surround_her' source_only=1",
