      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_outstanding' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_outstanding' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_over_there' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_over_there' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_please_dont' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_please_dont' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_run' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_run' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_shes_too_good_run' source_only=1",
