{
  "scenario_name": "all_family_source_matrix_batch_122",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 122 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m1_outstanding,sfx=base:sfx_m1_over_there,sfx=base:sfx_m1_please_dont,sfx=base:sfx_m1_run,sfx=base:sfx_m1_shes_too_good_run,sfx=base:sfx_m1_someone_hit_her,sfx=base:sfx_m1_split_up,sfx=base:sfx_m1_spread_out,sfx=base:sfx_m1_stop_dodging,sfx=base:sfx_m1_surround_her,sfx=base:sfx_m1_take_her_down,sfx=base:sfx_m1_that_sounded_like,sfx=base:sfx_m1_theres_no_one_here,sfx=base:sfx_m1_warn_the_others,sfx=base:sfx_m1_wha,sfx=base:sfx_m1_what_are_you_waiting_for,sfx=base:sfx_m1_what_is_it,sfx=base:sfx_m1_why_me,sfx=base:sfx_m1_withdraw,sfx=base:sfx_m1_yeehah_got_one"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
