    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 20,
        "max": 20
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
