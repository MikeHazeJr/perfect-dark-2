      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_what_is_it' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_why_me' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_why_me' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_withdraw' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_withdraw' result=OK",
