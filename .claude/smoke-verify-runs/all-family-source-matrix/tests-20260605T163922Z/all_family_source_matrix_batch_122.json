      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_take_her_down' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_that_sounded_like' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_that_sounded_like' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m1_theres_no_one_here' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m1_theres_no_one_here' result=OK",
