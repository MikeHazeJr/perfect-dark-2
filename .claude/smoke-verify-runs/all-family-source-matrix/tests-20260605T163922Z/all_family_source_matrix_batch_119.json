    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m0_my_gun,sfx=base:sfx_m0_one_for_the_morgue,sfx=base:sfx_m0_ow,sfx=base:sfx_m0_rest_in_peace,sfx=base:sfx_m0_retreat,sfx=base:sfx_m0_she_got_me,sfx=base:sfx_m0_shes_a_tricky_one,sfx=base:sfx_m0_surrender_now,sfx=base:sfx_m0_surround_her,sfx=base:sfx_m0_take_cover_028d,sfx=base:sfx_m0_take_cover,sfx=base:sfx_m0_take_that,sfx=base:sfx_m0_taking_damage,sfx=base:sfx_m0_trigger_the_alarm,sfx=base:sfx_m0_waste_her,sfx=base:sfx_m0_watch_my_back,sfx=base:sfx_m0_weve_got_problems,sfx=base:sfx_m0_weve_got_trouble,sfx=base:sfx_m0_what_the,sfx=base:sfx_m0_whats_that_noise"
