      "BOOT: --debug-load-catalog-assets request type=texture id='base:texture_unlabeled_zz' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=texture id='base:texture_unlabeled_zz' result=OK",
      "BOOT: --debug-load-catalog-assets request type=theme id='base:theme_blackgold' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=theme id='base:theme_blackgold' result=OK",
      "BOOT: --debug-load-catalog-assets request type=theme id='base:theme_blue' source_only=1",
