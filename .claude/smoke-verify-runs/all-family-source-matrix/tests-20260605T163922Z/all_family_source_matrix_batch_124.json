{
  "scenario_name": "all_family_source_matrix_batch_124",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 124 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m2_heres_a_little_present_for_ya,sfx=base:sfx_m2_hey_distract_her,sfx=base:sfx_m2_hey_you_stop,sfx=base:sfx_m2_i_bet_this_is_another_drill,sfx=base:sfx_m2_i_dont_believe_it,sfx=base:sfx_m2_i_dont_like_this_any_more,sfx=base:sfx_m2_i_dont_want_to_die,sfx=base:sfx_m2_i_have_you_now,sfx=base:sfx_m2_i_never_liked_him_anyway,sfx=base:sfx_m2_im_hit_im_hit,sfx=base:sfx_m2_im_injured,sfx=base:sfx_m2_im_the_man,sfx=base:sfx_m2_is_it_dangerous,sfx=base:sfx_m2_its_all_over_for_this_one,sfx=base:sfx_m2_keep_her_occupied,sfx=base:sfx_m2_let_her_have_it,sfx=base:sfx_m2_listen_gunshots,sfx=base:sfx_m2_move_in,sfx=base:sfx_m2_move_it_move_it,sfx=base:sfx_m2_move_out"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_124",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_heres_a_little_present_for_ya' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_heres_a_little_present_for_ya' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_hey_distract_her' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_hey_distract_her' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_hey_you_stop' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_hey_you_stop' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_i_bet_this_is_another_drill' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_i_bet_this_is_another_drill' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_i_dont_believe_it' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_i_dont_believe_it' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_i_dont_like_this_any_more' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_i_dont_like_this_any_more' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_i_dont_want_to_die' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_i_dont_want_to_die' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_i_have_you_now' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_i_have_you_now' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_i_never_liked_him_anyway' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_i_never_liked_him_anyway' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_im_hit_im_hit' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_im_hit_im_hit' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_im_injured' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_im_injured' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_im_the_man' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_im_the_man' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_is_it_dangerous' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_is_it_dangerous' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_its_all_over_for_this_one' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_its_all_over_for_this_one' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_keep_her_occupied' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_keep_her_occupied' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_let_her_have_it' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_let_her_have_it' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_listen_gunshots' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_listen_gunshots' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_move_in' source_only=1",
