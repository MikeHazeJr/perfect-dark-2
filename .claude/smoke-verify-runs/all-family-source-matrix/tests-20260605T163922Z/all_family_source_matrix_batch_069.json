{
  "scenario_name": "all_family_source_matrix_batch_069",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 69 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "lang=base:lang_arch_en,lang=base:lang_arec_en,lang=base:lang_ark_en,lang=base:lang_ash_en,lang=base:lang_ate_en,lang=base:lang_azt_en,lang=base:lang_cat_en,lang=base:lang_cave_en,lang=base:lang_crad_en,lang=base:lang_cryp_en,lang=base:lang_dam_en,lang=base:lang_depo_en,lang=base:lang_dest_en,lang=base:lang_dish_en,lang=base:lang_ear_en,lang=base:lang_eld_en,lang=base:lang_gun_en,lang=base:lang_imp_en,lang=base:lang_jun_en,lang=base:lang_lam_en"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_069",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_arch_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_arch_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_arec_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_arec_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_ark_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_ark_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_ash_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_ash_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_ate_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_ate_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_azt_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_azt_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_cat_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_cat_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_cave_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_cave_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_crad_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_crad_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_cryp_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_cryp_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_dam_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_dam_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_depo_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_depo_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_dest_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_dest_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_dish_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_dish_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_ear_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_ear_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_eld_en' source_only=1",
