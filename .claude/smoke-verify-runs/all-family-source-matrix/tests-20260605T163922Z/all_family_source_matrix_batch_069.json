      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_imp_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_jun_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_jun_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_lam_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_lam_en' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 20,
        "max": 20
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
