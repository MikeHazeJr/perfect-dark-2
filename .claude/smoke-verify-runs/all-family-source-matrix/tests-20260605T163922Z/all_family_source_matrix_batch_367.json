      "BOOT: --debug-load-catalog-assets request type=ui id='base:ui_noise_sm' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=ui id='base:ui_noise_sm' result=OK",
      "BOOT: --debug-load-catalog-assets request type=ui id='base:ui_nuke' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=ui id='base:ui_nuke' result=OK",
      "BOOT: --debug-load-catalog-assets request type=ui id='base:ui_particles' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=ui id='base:ui_particles' result=OK",
