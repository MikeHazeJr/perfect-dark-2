{
  "scenario_name": "all_family_source_matrix_batch_109",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 109 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "model=base:model_ziggycard_hi,model=base:model_ziggycard_lo,model=base:model_ziggycard,mission=base:mission_airbase,mission=base:mission_airforceone,mission=base:mission_attackship,mission=base:mission_chicago,mission=base:mission_crashsite,mission=base:mission_deepsea,mission=base:mission_defection,mission=base:mission_defense,mission=base:mission_g5building,mission=base:mission_infiltration,mission=base:mission_investigation,mission=base:mission_pelagic,mission=base:mission_skedarruins,mission=base:mission_villa,prop=base:prop_chr,prop=base:prop_door,prop=base:prop_explosion"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_109",
      "BOOT: --debug-load-catalog-assets request type=model id='base:model_ziggycard_hi' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=model id='base:model_ziggycard_hi' result=OK",
      "BOOT: --debug-load-catalog-assets request type=model id='base:model_ziggycard_lo' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=model id='base:model_ziggycard_lo' result=OK",
      "BOOT: --debug-load-catalog-assets request type=model id='base:model_ziggycard' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=model id='base:model_ziggycard' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_airbase' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_airbase' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_airforceone' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_airforceone' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_attackship' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_attackship' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_chicago' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_chicago' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_crashsite' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_crashsite' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_deepsea' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_deepsea' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_defection' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_defection' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_defense' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_defense' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_g5building' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_g5building' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_infiltration' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_infiltration' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_investigation' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_investigation' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_pelagic' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_pelagic' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_skedarruins' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_skedarruins' result=OK",
      "BOOT: --debug-load-catalog-assets request type=mission id='base:mission_villa' source_only=1",
