      "BOOT: --debug-load-catalog-assets result type=prop id='base:prop_chr' result=OK",
      "BOOT: --debug-load-catalog-assets request type=prop id='base:prop_door' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=prop id='base:prop_door' result=OK",
      "BOOT: --debug-load-catalog-assets request type=prop id='base:prop_explosion' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=prop id='base:prop_explosion' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
      "--debug-load-catalog-assets token '.*' missing type=id form",
      "--debug-load-catalog-assets argument too long",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets request type=.* source_only=1",
        "min": 20,
        "max": 20
      },
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
