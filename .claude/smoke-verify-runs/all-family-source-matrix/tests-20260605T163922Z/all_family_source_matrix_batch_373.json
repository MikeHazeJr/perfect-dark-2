  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 373 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "voice=base:voice_stand_still_ait,voice=base:voice_take_cover_aiy,voice=base:voice_withdraw_aji,weapon=base:ar34,weapon=base:autosurgeon,weapon=base:backupdisk,weapon=base:bolt,weapon=base:briefcase,weapon=base:briefcase2,weapon=base:callisto,weapon=base:camspy,weapon=base:choppergun,weapon=base:cloakingdevice,weapon=base:cmp150,weapon=base:combatboost,weapon=base:combatknife,weapon=base:commsrider,weapon=base:crossbow,weapon=base:cyclone,weapon=base:datauplink"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_373",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:voice_stand_still_ait' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:voice_stand_still_ait' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:voice_take_cover_aiy' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:voice_take_cover_aiy' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:voice_withdraw_aji' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:voice_withdraw_aji' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:ar34' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:ar34' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:autosurgeon' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:autosurgeon' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:backupdisk' source_only=1",
