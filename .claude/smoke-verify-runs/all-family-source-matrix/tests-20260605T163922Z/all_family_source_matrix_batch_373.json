      "BOOT: --debug-load-catalog-assets result type=weapon id='base:cmp150' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:combatboost' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:combatboost' result=OK",
