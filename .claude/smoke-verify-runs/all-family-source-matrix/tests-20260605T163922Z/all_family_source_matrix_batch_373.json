      "BOOT: --debug-load-catalog-assets result type=weapon id='base:briefcase2' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:callisto' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:callisto' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:camspy' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:camspy' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:choppergun' source_only=1",
