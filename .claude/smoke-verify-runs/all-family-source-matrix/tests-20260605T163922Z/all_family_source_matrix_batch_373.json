    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "--debug-load-catalog-assets invalid token",
