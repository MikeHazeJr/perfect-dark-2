      "BOOT: --debug-load-catalog-assets request type=animation id='base:animation_big_sneeze' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=animation id='base:animation_big_sneeze' result=OK",
      "BOOT: --debug-load-catalog-assets request type=animation id='base:animation_blinded' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=animation id='base:animation_blinded' result=OK",
      "BOOT: --debug-load-catalog-assets request type=animation id='base:animation_character_aay' source_only=1",
