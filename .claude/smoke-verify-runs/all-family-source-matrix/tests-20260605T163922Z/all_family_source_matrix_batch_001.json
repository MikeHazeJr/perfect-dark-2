  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "animation=base:animation_big_sneeze,animation=base:animation_blinded,animation=base:animation_character_aay,animation=base:animation_character_ab,animation=base:animation_character_ad,animation=base:animation_character_adc,animation=base:animation_character_adu,animation=base:animation_character_adv,animation=base:animation_character_ae,animation=base:animation_character_aed,animation=base:animation_character_aee,animation=base:animation_character_aef,animation=base:animation_character_aeg,animation=base:animation_character_aeh,animation=base:animation_character_aei,animation=base:animation_character_aej,animation=base:animation_character_aek,animation=base:animation_character_ael,animation=base:animation_character_aem,animation=base:animation_character_aen"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
