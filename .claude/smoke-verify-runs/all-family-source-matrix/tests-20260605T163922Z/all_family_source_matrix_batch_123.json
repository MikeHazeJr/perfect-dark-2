      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_get_out_of_the_way' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_get_out_of_the_way' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_get_to_cover_now' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_get_to_cover_now' result=OK",
