{
  "scenario_name": "all_family_source_matrix_batch_123",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 123 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "sfx=base:sfx_m2_activate_the_alarm,sfx=base:sfx_m2_another_false_alarm,sfx=base:sfx_m2_ay_caramba,sfx=base:sfx_m2_body_counts_too_high,sfx=base:sfx_m2_come_on_around_the_side,sfx=base:sfx_m2_come_on_man,sfx=base:sfx_m2_come_on_man2,sfx=base:sfx_m2_did_you_see_that,sfx=base:sfx_m2_die,sfx=base:sfx_m2_dont_hurt_me,sfx=base:sfx_m2_dont_move,sfx=base:sfx_m2_fall_back,sfx=base:sfx_m2_fire_in_the_hole,sfx=base:sfx_m2_get_back_get_back,sfx=base:sfx_m2_get_back_quick,sfx=base:sfx_m2_get_her,sfx=base:sfx_m2_get_out_of_the_way,sfx=base:sfx_m2_get_to_cover_now,sfx=base:sfx_m2_help_me_out_here,sfx=base:sfx_m2_help_me_out"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_123",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_activate_the_alarm' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_activate_the_alarm' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_another_false_alarm' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_another_false_alarm' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_ay_caramba' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_ay_caramba' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_body_counts_too_high' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_body_counts_too_high' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_come_on_around_the_side' source_only=1",
