      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_come_on_man2' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_did_you_see_that' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_did_you_see_that' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='base:sfx_m2_die' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_m2_die' result=OK",
