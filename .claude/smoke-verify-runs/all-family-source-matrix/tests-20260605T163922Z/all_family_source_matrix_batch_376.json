      "BOOT: --debug-load-catalog-assets request type=weapon id='base:phoenix' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:phoenix' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:presidentscanner' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:presidentscanner' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:proximitymine' source_only=1",
