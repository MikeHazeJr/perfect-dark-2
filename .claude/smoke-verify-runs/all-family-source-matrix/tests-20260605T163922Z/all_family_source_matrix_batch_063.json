{
  "scenario_name": "all_family_source_matrix_batch_063",
  "BugId": "B-509",
  "category": "modding",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 63 for extracted non-Scenario public typed archives. Missing debug-load request/result blocks are B-509 harness observability failures.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "character=base:character_officeworker,character=base:character_officeworker2,character=base:character_overall,character=base:character_pelagic_guard,character=base:character_pilotaf1,character=base:character_pres_security,character=base:character_president_clone2,character=base:character_president,character=base:character_secretary,character=base:character_skedar,character=base:character_steward,character=base:character_stewardess_coat,character=base:character_stewardess,character=base:character_stripes,character=base:character_theking,character=base:character_trent,effect=base:effect_darken,effect=base:effect_glow,effect=base:effect_particle,effect=base:effect_screen"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_063",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_officeworker' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_officeworker' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_officeworker2' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_officeworker2' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_overall' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_overall' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_pelagic_guard' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_pelagic_guard' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_pilotaf1' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_pilotaf1' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_pres_security' source_only=1",
