      "BOOT: --debug-load-catalog-assets result type=character id='base:character_secretary' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_skedar' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_skedar' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_steward' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_steward' result=OK",
