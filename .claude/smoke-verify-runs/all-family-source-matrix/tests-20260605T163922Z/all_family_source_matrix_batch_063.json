      "BOOT: --debug-load-catalog-assets result type=character id='base:character_stripes' result=OK",
      "BOOT: --debug-load-catalog-assets request type=character id='base:character_theking' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_theking' result=OK",
