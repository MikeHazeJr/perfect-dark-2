      "BOOT: --debug-load-catalog-assets result type=model id='base:model_nlogo' result=OK",
      "BOOT: --debug-load-catalog-assets request type=model id='base:model_nlogo2' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=model id='base:model_nlogo2' result=OK",
