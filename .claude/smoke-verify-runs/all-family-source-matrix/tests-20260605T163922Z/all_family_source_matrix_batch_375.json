      "BOOT: --debug-load-catalog-assets result type=weapon id='base:laptopgun' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:laser' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:laser' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:magsec' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:magsec' result=OK",
