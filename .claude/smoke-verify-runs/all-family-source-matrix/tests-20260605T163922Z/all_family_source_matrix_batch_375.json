      "BOOT: --debug-load-catalog-assets request type=weapon id='base:keycard_slot66' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:keycard_slot66' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:keycard_slot67' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:keycard_slot67' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:keycard_slot68' source_only=1",
