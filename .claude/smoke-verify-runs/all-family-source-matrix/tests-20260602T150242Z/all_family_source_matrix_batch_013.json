{
  "scenario_name": "all_family_source_matrix_batch_013",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 13 for extracted non-Scenario public typed archives.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "weapon=base:doordecoder,weapon=base:dragon,weapon=base:dy357,weapon=base:dy357lx,weapon=base:ecmmine,weapon=base:explosives,weapon=base:falcon2_scope,weapon=base:falcon2_silencer,weapon=base:falcon2,weapon=base:farsight,weapon=base:flightplans,weapon=base:grenade,weapon=base:grenaderound,weapon=base:hammer_slot74,weapon=base:hammer_slot83,weapon=base:hammer_slot84,weapon=base:hammer,weapon=base:homingrocket,weapon=base:horizonscanner,weapon=base:irscanner"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_013",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:doordecoder' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:doordecoder' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:dragon' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:dragon' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:dy357' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:dy357' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:dy357lx' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:dy357lx' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:ecmmine' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:ecmmine' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:explosives' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:explosives' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:falcon2_scope' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:falcon2_scope' result=OK",
