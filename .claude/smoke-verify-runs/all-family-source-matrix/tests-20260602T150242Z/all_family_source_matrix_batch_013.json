      "BOOT: --debug-load-catalog-assets request type=weapon id='base:falcon2' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:falcon2' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:farsight' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:farsight' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:flightplans' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:flightplans' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:grenade' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:grenade' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:grenaderound' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:grenaderound' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:hammer_slot74' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:hammer_slot74' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:hammer_slot83' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:hammer_slot83' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:hammer_slot84' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:hammer_slot84' result=OK",
