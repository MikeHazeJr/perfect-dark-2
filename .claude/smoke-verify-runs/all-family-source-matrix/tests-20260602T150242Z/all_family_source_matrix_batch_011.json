{
  "scenario_name": "all_family_source_matrix_batch_011",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 11 for extracted non-Scenario public typed archives.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "lang=base:lang_oat_en,lang=base:lang_old_en,lang=base:lang_options_en,lang=base:lang_pam_en,lang=base:lang_pete_en,lang=base:lang_propobj_en,lang=base:lang_ref_en,lang=base:lang_rit_en,lang=base:lang_run_en,lang=base:lang_sev_en,lang=base:lang_sevb_en,lang=base:lang_sevx_en,lang=base:lang_sevxb_en,lang=base:lang_sho_en,lang=base:lang_silo_en,lang=base:lang_stat_en,lang=base:lang_title_en,lang=base:lang_tra_en,lang=base:lang_uff_en,lang=base:lang_wax_en"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_011",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_oat_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_oat_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_old_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_old_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_options_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_options_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_pam_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_pam_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_pete_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_pete_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_propobj_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_propobj_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_ref_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_ref_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_rit_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_rit_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_run_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_run_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_sev_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_sev_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_sevb_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_sevb_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_sevx_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_sevx_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_sevxb_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_sevxb_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_sho_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_sho_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_silo_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_silo_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_stat_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_stat_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_title_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_title_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_tra_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_tra_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_uff_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_uff_en' result=OK",
      "BOOT: --debug-load-catalog-assets request type=lang id='base:lang_wax_en' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_wax_en' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
  }
}
