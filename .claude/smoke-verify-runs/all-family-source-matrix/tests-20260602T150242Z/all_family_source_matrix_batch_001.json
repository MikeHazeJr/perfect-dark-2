{
  "scenario_name": "all_family_source_matrix_batch_001",
  "description": "c3844 runtime matrix smoke: source-only catalog load batch 1 for extracted non-Scenario public typed archives.",
  "tags": [
    "modding",
    "pdxxx",
    "source-gate",
    "source-matrix",
    "all-family",
    "c3844",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/run-all-family-source-matrix.ps1",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "body=base:a51airman,body=base:a51trooper,body=base:alaskan_guard,body=base:area51guard,body=base:biotech,body=base:carreveningsuit,body=base:carrington,body=base:cassandra,body=base:ciaguy,body=base:cifemtech,body=base:cilabtech,body=base:cisoldier,body=base:connery,body=base:dalton,body=base:dark_af1,body=base:dark_combat,body=base:dark_frock,body=base:dark_leather,body=base:dark_negotiator,body=base:dark_ripped"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire."
    },
    {
      "at_ms": 35000,
      "type": "exit",
      "comment": "exit after all requested typed assets have loaded or emitted source-only failures."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_matrix_batch_001",
      "BOOT: --debug-load-catalog-assets request type=body id='base:a51airman' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:a51airman' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:a51trooper' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:a51trooper' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:alaskan_guard' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:alaskan_guard' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:area51guard' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:area51guard' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:biotech' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:biotech' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:carreveningsuit' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:carreveningsuit' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:carrington' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:carrington' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:cassandra' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:cassandra' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:ciaguy' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:ciaguy' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:cifemtech' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:cifemtech' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:cilabtech' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:cilabtech' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:cisoldier' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:cisoldier' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:connery' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:connery' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:dalton' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:dalton' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:dark_af1' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:dark_af1' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:dark_combat' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:dark_combat' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:dark_frock' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:dark_frock' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:dark_leather' source_only=1",
