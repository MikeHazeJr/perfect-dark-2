      "BOOT: --debug-load-catalog-assets result type=body id='base:dark_negotiator' result=OK",
      "BOOT: --debug-load-catalog-assets request type=body id='base:dark_ripped' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=body id='base:dark_ripped' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "refusing fallback"
    ],
    "required_counts": [
      {
        "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK",
        "min": 20,
        "max": 20
      }
    ]
