+def contains_null(value) -> bool:
+    if isinstance(value, dict):
+        return any(contains_null(child) for child in value.values())
+    if isinstance(value, list):
+        return any(contains_null(child) for child in value)
+    return value is None
+
+
+def read_stage_rules(path: Path) -> bytes:
+    try:
+        source = path.read_bytes()
+        rules = parse_source_json(source)
+        require(not contains_null(rules), f"{path}: stage rules cannot contain null values")
+        errors = validate_stage_json(str(path), source.decode("utf-8"))
+    except (OSError, ValueError, TypeError) as exc:
+        raise la.BuildError(f"{path}: invalid stage rules: {exc}") from exc
+    require(not errors, "\n".join(errors))
+    return source
+
