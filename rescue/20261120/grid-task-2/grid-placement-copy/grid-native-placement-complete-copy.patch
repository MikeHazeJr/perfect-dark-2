+static bool forgePropProject(const f32 world[3], float scaleX, float scaleY, ImVec2 &screen)
+{
+	float x, y;
+	if (!forgeProjectWorldPos(world, &x, &y, nullptr)) return false;
+	screen = ImVec2(x * scaleX, y * scaleY);
+	return true;
+}
