-
-	/* Group by category for clarity */
-	for (int c = 0; c < (int)FORGE_CAT_COUNT; ++c) {
-		if (ed->category_filter != FORGE_CAT_COUNT && ed->category_filter != (u8)c) continue;
-		int matched = 0;
