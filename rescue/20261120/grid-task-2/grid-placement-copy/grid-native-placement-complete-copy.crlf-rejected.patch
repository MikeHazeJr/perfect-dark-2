+s32 forgeLevelDraftStageFailed(void)
+{
+	s32 recover = s_Draft.phase == FORGE_DRAFT_LOADING;
+	if (recover) s_Draft.phase = FORGE_DRAFT_RETURN_QUEUED;
+	forgeLevelDraftStageLeaving(recover ? s_Draft.stage : -1);
+	return recover;
+}
