-		for (int i = 0; i < forgeCatalogCount(); ++i) {
-			const forge_catalog_entry_t *e = forgeCatalogGet(i);
-			if (!e) continue;
-			if ((int)e->category != c) continue;
-			if (ed->search_filter[0]) {
-				if (!f_icontains(e->name, ed->search_filter) &&
