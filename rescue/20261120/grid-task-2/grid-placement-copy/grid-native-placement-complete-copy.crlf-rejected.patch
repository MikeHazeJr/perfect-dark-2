-	u32 catalog_generation, s32 stage_index, s32 require_resident, char *err, size_t err_cap)
-{
-	u8 before[2][SHA256_DIGEST_SIZE], after[2][SHA256_DIGEST_SIZE];
-	const s32 length = fsFileSize(target->archive_path);
