{
  "scenario_name": "grid_import_stage_atmosphere_smoke",
  "description": "Play an arena generated by the Grid model importer with native stage rules. Verify the exact scenario, applied sky, fog and ambient light, and the selected stock song reaching the native sequencer.",
  "tags": ["modding", "forge", "arena", "pdarena", "atmosphere", "smoke"],
  "paths_of_interest": [
    "tools/build_level_from_model.py",
    "port/src/scenario_source_runtime.c",
    "port/src/scenario_stage_rules.cpp",
    "src/game/env.c",
    "src/game/dlights.c",
    "src/game/stagemusic.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 300,
  "install_state": "current",
  "boot_args": [
    "--no-update-check", "--no-net", "--portable",
    "--savedir", "./grid-stage-verify", "--moddir", "./grid-stage-verify/mods",
    "--launch-mp-room", "mod_grid_stage_import:arena_grid_stage_import", "base:combat", "0",
    "--debug-auto-start-match"
  ],
  "screenshots": [{"at_ms": 3000, "name": "imported-stage-atmosphere"}],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 240000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900
    },
    {"at_ms": 8000, "type": "exit"}
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=grid_import_stage_atmosphere_smoke",
      "AUDIO\\.DIAG: init dev=[1-9][0-9]* ",
      "modmgr: loading mod 'grid_stage_import' from .*grid-stage-verify[/\\\\]mods[/\\\\]grid_stage_import",
      "PDARENA\\.SCENARIO: owner=mod_grid_stage_import:arena_grid_stage_import id=mod_grid_stage_import:scenario_grid_stage_import stagenum=0x[0-9a-f]+ source=",
      "BOOT: --launch-mp-room direct match start$",
      "SCENARIO\\.RENDER: activated source scene 'mod_grid_stage_import:scenario_grid_stage_import' ",
      "ENV\\.ATMOSPHERE: stage=0x[0-9a-f]+ sky=15,35,75 fog=1 range=120,480",
      "SCENARIO\\.SOURCE: atmosphere default room=1 brightness=104",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready .*stable_ms=3000",
      "SMOKE: screenshot at_ms=3000 -> .*imported-stage-atmosphere\\.bmp",
      "SMOKE: result=scripted_exit"
    ],
    "required_sequences": [
      {
        "name": "the imported atmosphere chooses and loads stock song track one",
        "patterns": [
          "SCENARIO\\.SOURCE: atmosphere for 'mod_grid_stage_import:scenario_grid_stage_import' sky=1 rgb=15,35,75 fog=1 range=120,480 ambient=1 level=104 music='base:song_sequence_b' track=1 source=stage\\.json",
          "MUSIC: musicStartPrimary track=1 qlen=[0-9]+",
          "CATALOG: music sequence 1 -> public sequence source mid=\".*sequence\\.mid\" events=\".*sequence\\.json\" \\([1-9][0-9]* events, [1-9][0-9]* bytes\\)"
        ]
      }
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "PDARENA\\.SCENARIO\\.REJECT",
      "CATALOG\\.SCAN\\.TRANSACTION\\.ROLLBACK",
      "BOOT: --launch-mp-room direct match start failed",
      "stage\\.json of .* refused",
      "ASSET\\.(SOURCE_ONLY|CHAIN): music sequence 1 ",
      "SDL_OpenAudio error:"
    ]
  }
}
