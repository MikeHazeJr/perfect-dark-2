+		current->stage_epoch, submitted.serial,
+		s_BoidScratch[0]._pad_m0, s_BoidScratch[1]._pad_m0,
+		s_BoidScratch[2]._pad_m0, s_BoidScratch[3]._pad_m0, actors);
