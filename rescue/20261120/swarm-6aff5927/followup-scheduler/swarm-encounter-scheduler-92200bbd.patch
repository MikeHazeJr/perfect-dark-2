diff --git a/port/include/skedar_swarm_encounter.h b/port/include/skedar_swarm_encounter.h
new file mode 100644
--- /dev/null
+++ b/port/include/skedar_swarm_encounter.h
@@ -0,0 +1,179 @@
+#ifndef PORT_SKEDAR_SWARM_ENCOUNTER_H
+#define PORT_SKEDAR_SWARM_ENCOUNTER_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+	SKEDAR_SWARM_TUNNEL_COUNT = 3,
+	SKEDAR_SWARM_ALL_TUNNELS = (1u << SKEDAR_SWARM_TUNNEL_COUNT) - 1,
+	SKEDAR_SWARM_MAX_WAVES = 16,
+	SKEDAR_SWARM_MAX_RAIDERS = 4096,
+};
+
+enum skedar_swarm_phase {
+	SKEDAR_SWARM_INACTIVE,
+	SKEDAR_SWARM_DEFENSE,
+	SKEDAR_SWARM_DRAINING,
+	SKEDAR_SWARM_FINALE,
+	SKEDAR_SWARM_COMPLETE,
+	SKEDAR_SWARM_FAILED,
+};
+
+enum skedar_swarm_spawn_kind {
+	SKEDAR_SWARM_RAIDER,
+	SKEDAR_SWARM_GIANT,
+};
+
+enum skedar_swarm_spawn_result {
+	SKEDAR_SWARM_SPAWN_STALE,
+	SKEDAR_SWARM_SPAWN_COMMITTED,
+	SKEDAR_SWARM_SPAWN_RETRY,
+	SKEDAR_SWARM_SPAWN_FAILED,
+};
+
+enum skedar_swarm_retirement {
+	SKEDAR_SWARM_DEFEATED,
+	SKEDAR_SWARM_REMOVED,
+};
+
+/* A configured mask uses runtime tunnel ordinals. The stage adapter resolves
+ * authored tunnel IDs and pads before calling the scheduler. */
+struct skedar_swarm_wave {
+	uint16_t raiders;
+	uint8_t tunnel_mask;
+	uint32_t delay_ticks;
+};
+
+enum skedar_swarm_attack_kind {
+	SKEDAR_SWARM_MELEE,
+	SKEDAR_SWARM_JUMP,
+	SKEDAR_SWARM_DROP,
+	SKEDAR_SWARM_ATTACK_KIND_COUNT,
+};
+
+enum {
+	SKEDAR_SWARM_TARGET_LIVE = 1u << 0,
+	SKEDAR_SWARM_TARGET_HOSTILE = 1u << 1,
+	SKEDAR_SWARM_TARGET_VISIBLE = 1u << 2,
+	SKEDAR_SWARM_TARGET_IN_RANGE = 1u << 3,
+	SKEDAR_SWARM_TARGET_QUALIFIED = (1u << 4) - 1,
+};
+
+struct skedar_swarm_attack_limits {
+	uint16_t active;
+	uint16_t active_by_kind[SKEDAR_SWARM_ATTACK_KIND_COUNT];
+	uint16_t starts_per_tick;
+	uint32_t telegraph_ticks;
+	uint32_t duration_ticks;
+	uint32_t cooldown_ticks;
+};
+
+struct skedar_swarm_config {
+	uint16_t max_live_raiders;
+	uint8_t wave_count;
+	uint8_t max_placement_failures;
+	uint32_t spawn_interval_ticks;
+	struct skedar_swarm_attack_limits attacks;
+	struct skedar_swarm_wave waves[SKEDAR_SWARM_MAX_WAVES];
+};
+
+struct skedar_swarm_actor {
+	uint32_t prop_index;
+	uint64_t prop_generation;
+};
+
+/* At most one placement is outstanding. Index -1 denotes the authored Giant
+ * pad, which the stage adapter resolves separately. */
+struct skedar_swarm_ticket {
+	uint64_t stage_epoch;
+	uint32_t sequence;
+	enum skedar_swarm_spawn_kind kind;
+	int tunnel_index;
+	int wave_index;
+};
+
+/* The stage adapter samples the same live target, LOS and range again at
+ * the damage commit. A target slot and its generation form one identity. */
+struct skedar_swarm_target {
+	struct skedar_swarm_actor actor;
+	uint32_t tick;
+	uint8_t flags;
+};
+
+struct skedar_swarm_attack {
+	uint64_t stage_epoch;
+	uint32_t sequence;
+	enum skedar_swarm_attack_kind kind;
+	struct skedar_swarm_actor attacker;
+	struct skedar_swarm_actor target;
+	uint32_t started_tick;
+};
+
+struct skedar_swarm_actor_slot {
+	struct skedar_swarm_actor actor;
+	struct skedar_swarm_attack attack;
+	uint32_t next_attack_tick;
+	uint8_t hit_committed;
+};
+
+struct skedar_swarm_encounter {
+	struct skedar_swarm_config config;
+	uint64_t stage_epoch;
+	enum skedar_swarm_phase phase;
+	uint8_t closed_mask;
+	uint8_t wave_index;
+	uint8_t next_tunnel;
+	uint8_t placement_failures;
+	uint16_t wave_admitted;
+	uint16_t live_raiders;
+	uint32_t next_spawn_tick;
+	uint32_t wave_ready_tick;
+	uint32_t last_request_tick;
+	uint32_t last_spawn_tick;
+	uint32_t sequence;
+	struct skedar_swarm_ticket pending;
+	uint32_t attack_sequence;
+	uint32_t last_attack_tick;
+	uint16_t active_attacks;
+	uint16_t active_by_kind[SKEDAR_SWARM_ATTACK_KIND_COUNT];
+	uint16_t starts_this_tick;
+	struct skedar_swarm_actor_slot raiders[SKEDAR_SWARM_MAX_RAIDERS];
+	struct skedar_swarm_actor_slot giant;
+};
+
+/* Reinitialization always uses a fresh nonzero stage epoch. Stop follows
+ * the adapter's retirement of engine actors and pending prepared props. */
+int skedarSwarmInit(struct skedar_swarm_encounter *state,
+		const struct skedar_swarm_config *config, uint64_t stage_epoch, uint32_t tick);
+void skedarSwarmStop(struct skedar_swarm_encounter *state);
+
+/* Only the stage authority calls these functions. A tunnel is closed after its
+ * physical blocker commits. A stale ticket may never publish a prepared prop. */
+int skedarSwarmCloseTunnel(struct skedar_swarm_encounter *state,
+		uint64_t stage_epoch, int tunnel_index, int blocker_committed);
+int skedarSwarmRequestSpawn(struct skedar_swarm_encounter *state,
+		uint64_t stage_epoch, uint32_t tick, struct skedar_swarm_ticket *ticket);
+enum skedar_swarm_spawn_result skedarSwarmResolveSpawn(struct skedar_swarm_encounter *state,
+		const struct skedar_swarm_ticket *ticket, struct skedar_swarm_actor actor);
+int skedarSwarmRetireActor(struct skedar_swarm_encounter *state, uint64_t stage_epoch,
+		struct skedar_swarm_actor actor, enum skedar_swarm_retirement retirement);
+
+/* Advance every authoritative tick, including ticks without new attacks. A
+ * successful hit authorizes one damage commit by the caller. */
+int skedarSwarmAdvanceAttacks(struct skedar_swarm_encounter *state, uint64_t stage_epoch, uint32_t tick);
+int skedarSwarmBeginAttack(struct skedar_swarm_encounter *state, uint64_t stage_epoch,
+		uint32_t tick, struct skedar_swarm_actor attacker, enum skedar_swarm_attack_kind kind,
+		const struct skedar_swarm_target *target, struct skedar_swarm_attack *attack);
+int skedarSwarmAcceptHit(struct skedar_swarm_encounter *state, uint32_t tick,
+		const struct skedar_swarm_attack *attack, const struct skedar_swarm_target *target);
+int skedarSwarmEndAttack(struct skedar_swarm_encounter *state, uint32_t tick,
+		const struct skedar_swarm_attack *attack);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/port/src/skedar_swarm_encounter.c b/port/src/skedar_swarm_encounter.c
new file mode 100644
--- /dev/null
+++ b/port/src/skedar_swarm_encounter.c
@@ -0,0 +1,373 @@
+#include "skedar_swarm_encounter.h"
+
+#include <limits.h>
+#include <string.h>
+
+static int is_active(const struct skedar_swarm_encounter *state, uint64_t epoch)
+{
+	return epoch != 0 && state->stage_epoch == epoch
+		&& (state->phase == SKEDAR_SWARM_DEFENSE
+			|| state->phase == SKEDAR_SWARM_DRAINING
+			|| state->phase == SKEDAR_SWARM_FINALE);
+}
+
+static uint32_t later_tick(uint32_t tick, uint32_t delay)
+{
+	return UINT32_MAX - tick < delay ? UINT32_MAX : tick + delay;
+}
+
+static int config_valid(const struct skedar_swarm_config *config)
+{
+	if (!config || !config->max_live_raiders
+			|| config->max_live_raiders > SKEDAR_SWARM_MAX_RAIDERS
+			|| !config->wave_count || config->wave_count > SKEDAR_SWARM_MAX_WAVES
+			|| !config->max_placement_failures || !config->spawn_interval_ticks) {
+		return 0;
+	}
+	const struct skedar_swarm_attack_limits *limits = &config->attacks;
+	if (!limits->active || limits->active > config->max_live_raiders
+			|| !limits->starts_per_tick || limits->starts_per_tick > limits->active
+			|| !limits->telegraph_ticks || limits->duration_ticks <= limits->telegraph_ticks
+			|| !limits->cooldown_ticks) {
+		return 0;
+	}
+	for (int i = 0; i < SKEDAR_SWARM_ATTACK_KIND_COUNT; i++) {
+		if (limits->active_by_kind[i] > limits->active) {
+			return 0;
+		}
+	}
+	for (int i = 0; i < config->wave_count; i++) {
+		const struct skedar_swarm_wave *wave = &config->waves[i];
+		if (!wave->raiders || !wave->tunnel_mask
+				|| (wave->tunnel_mask & ~SKEDAR_SWARM_ALL_TUNNELS)) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static void refresh_phase(struct skedar_swarm_encounter *state)
+{
+	if ((state->phase == SKEDAR_SWARM_DEFENSE || state->phase == SKEDAR_SWARM_DRAINING)
+			&& state->closed_mask == SKEDAR_SWARM_ALL_TUNNELS) {
+		state->phase = state->live_raiders ? SKEDAR_SWARM_DRAINING : SKEDAR_SWARM_FINALE;
+		state->placement_failures = 0;
+	}
+}
+
+static int same_actor(struct skedar_swarm_actor a, struct skedar_swarm_actor b)
+{
+	return a.prop_generation == b.prop_generation && a.prop_index == b.prop_index;
+}
+
+static int same_ticket(const struct skedar_swarm_ticket *a, const struct skedar_swarm_ticket *b)
+{
+	return a->stage_epoch == b->stage_epoch && a->sequence == b->sequence
+		&& a->kind == b->kind && a->tunnel_index == b->tunnel_index
+		&& a->wave_index == b->wave_index;
+}
+
+int skedarSwarmInit(struct skedar_swarm_encounter *state,
+		const struct skedar_swarm_config *config, uint64_t stage_epoch, uint32_t tick)
+{
+	if (!stage_epoch || !config_valid(config)) {
+		return 0;
+	}
+	const struct skedar_swarm_config next = *config;
+	memset(state, 0, sizeof(*state));
+	state->config = next;
+	state->stage_epoch = stage_epoch;
+	state->phase = SKEDAR_SWARM_DEFENSE;
+	state->last_request_tick = tick;
+	state->last_attack_tick = tick;
+	state->next_spawn_tick = tick;
+	state->wave_ready_tick = later_tick(tick, next.waves[0].delay_ticks);
+	return 1;
+}
+
+void skedarSwarmStop(struct skedar_swarm_encounter *state)
+{
+	memset(state, 0, sizeof(*state));
+}
+
+int skedarSwarmCloseTunnel(struct skedar_swarm_encounter *state,
+		uint64_t stage_epoch, int tunnel_index, int blocker_committed)
+{
+	if (!is_active(state, stage_epoch) || state->phase != SKEDAR_SWARM_DEFENSE
+			|| tunnel_index < 0 || tunnel_index >= SKEDAR_SWARM_TUNNEL_COUNT
+			|| !blocker_committed) {
+		return 0;
+	}
+	const uint8_t mask = 1u << tunnel_index;
+	if (state->closed_mask & mask) {
+		return 0;
+	}
+	state->closed_mask |= mask;
+	if (state->pending.sequence && state->pending.kind == SKEDAR_SWARM_RAIDER
+			&& state->pending.tunnel_index == tunnel_index) {
+		state->pending.sequence = 0;
+	}
+	refresh_phase(state);
+	return 1;
+}
+
+/* A completed wave drains its live raiders before advancing. A wave with no
+ * open authored route admits nobody and advances once that wave drains. */
+static unsigned next_allowed_tunnels(struct skedar_swarm_encounter *state, uint32_t tick)
+{
+	while (state->wave_index < state->config.wave_count) {
+		const struct skedar_swarm_wave *wave = &state->config.waves[state->wave_index];
+		const unsigned allowed = wave->tunnel_mask & ~state->closed_mask;
+		if (allowed && state->wave_admitted < wave->raiders) {
+			return allowed;
+		}
+		if (state->live_raiders) {
+			return 0;
+		}
+		state->wave_admitted = 0;
+		state->wave_index++;
+		if (state->wave_index < state->config.wave_count) {
+			state->wave_ready_tick = later_tick(tick, state->config.waves[state->wave_index].delay_ticks);
+		}
+	}
+	return 0;
+}
+
+int skedarSwarmRequestSpawn(struct skedar_swarm_encounter *state,
+		uint64_t stage_epoch, uint32_t tick, struct skedar_swarm_ticket *ticket)
+{
+	if (!ticket || !is_active(state, stage_epoch) || tick < state->last_request_tick) {
+		return 0;
+	}
+	state->last_request_tick = tick;
+	if (state->pending.sequence || tick < state->next_spawn_tick
+			|| (state->sequence && tick == state->last_spawn_tick)) {
+		return 0;
+	}
+	enum skedar_swarm_spawn_kind kind;
+	int tunnel = -1;
+	int wave = -1;
+	if (state->phase == SKEDAR_SWARM_DEFENSE) {
+		if (state->live_raiders >= state->config.max_live_raiders) {
+			return 0;
+		}
+		const unsigned allowed = next_allowed_tunnels(state, tick);
+		if (!allowed || tick < state->wave_ready_tick) {
+			return 0;
+		}
+		for (int offset = 0; offset < SKEDAR_SWARM_TUNNEL_COUNT; offset++) {
+			const int candidate = (state->next_tunnel + offset) % SKEDAR_SWARM_TUNNEL_COUNT;
+			if (allowed & (1u << candidate)) {
+				tunnel = candidate;
+				break;
+			}
+		}
+		kind = SKEDAR_SWARM_RAIDER;
+		wave = state->wave_index;
+	} else if (state->phase == SKEDAR_SWARM_FINALE && !state->giant.actor.prop_generation) {
+		kind = SKEDAR_SWARM_GIANT;
+	} else {
+		return 0;
+	}
+	state->pending = (struct skedar_swarm_ticket){stage_epoch, ++state->sequence, kind, tunnel, wave};
+	state->last_spawn_tick = tick;
+	state->next_spawn_tick = later_tick(tick, state->config.spawn_interval_ticks);
+	*ticket = state->pending;
+	return 1;
+}
+
+static enum skedar_swarm_spawn_result placement_failed(struct skedar_swarm_encounter *state)
+{
+	if (++state->placement_failures == state->config.max_placement_failures) {
+		state->phase = SKEDAR_SWARM_FAILED;
+		return SKEDAR_SWARM_SPAWN_FAILED;
+	}
+	return SKEDAR_SWARM_SPAWN_RETRY;
+}
+
+enum skedar_swarm_spawn_result skedarSwarmResolveSpawn(struct skedar_swarm_encounter *state,
+		const struct skedar_swarm_ticket *ticket, struct skedar_swarm_actor actor)
+{
+	if (!ticket || !ticket->sequence || !is_active(state, ticket->stage_epoch)
+			|| !same_ticket(ticket, &state->pending)) {
+		return SKEDAR_SWARM_SPAWN_STALE;
+	}
+	const struct skedar_swarm_ticket resolved = *ticket;
+	state->pending.sequence = 0;
+	if (!actor.prop_generation) {
+		return placement_failed(state);
+	}
+
+	if (resolved.kind == SKEDAR_SWARM_GIANT) {
+		state->giant.actor = actor;
+	} else {
+		int free_index = -1;
+		for (int i = 0; i < state->config.max_live_raiders; i++) {
+			if (!state->raiders[i].actor.prop_generation) {
+				if (free_index < 0) {
+					free_index = i;
+				}
+			} else if (state->raiders[i].actor.prop_index == actor.prop_index) {
+				return placement_failed(state);
+			}
+		}
+		if (free_index < 0) {
+			return placement_failed(state);
+		}
+		state->raiders[free_index].actor = actor;
+		state->wave_admitted++;
+		state->live_raiders++;
+		state->next_tunnel = (resolved.tunnel_index + 1) % SKEDAR_SWARM_TUNNEL_COUNT;
+	}
+	state->placement_failures = 0;
+	return SKEDAR_SWARM_SPAWN_COMMITTED;
+}
+
+static struct skedar_swarm_actor_slot *find_actor(struct skedar_swarm_encounter *state,
+		struct skedar_swarm_actor actor)
+{
+	if (!actor.prop_generation) {
+		return NULL;
+	}
+	if (same_actor(state->giant.actor, actor)) {
+		return &state->giant;
+	}
+	for (int i = 0; i < state->config.max_live_raiders; i++) {
+		if (same_actor(state->raiders[i].actor, actor)) {
+			return &state->raiders[i];
+		}
+	}
+	return NULL;
+}
+
+static void clear_attack(struct skedar_swarm_encounter *state, struct skedar_swarm_actor_slot *slot)
+{
+	if (slot->attack.sequence) {
+		state->active_attacks--;
+		state->active_by_kind[slot->attack.kind]--;
+		slot->attack.sequence = 0;
+		slot->hit_committed = 0;
+	}
+}
+
+int skedarSwarmRetireActor(struct skedar_swarm_encounter *state, uint64_t stage_epoch,
+		struct skedar_swarm_actor actor, enum skedar_swarm_retirement retirement)
+{
+	if (!is_active(state, stage_epoch)
+			|| (retirement != SKEDAR_SWARM_DEFEATED && retirement != SKEDAR_SWARM_REMOVED)) {
+		return 0;
+	}
+	struct skedar_swarm_actor_slot *slot = find_actor(state, actor);
+	if (!slot) {
+		return 0;
+	}
+	clear_attack(state, slot);
+	*slot = (struct skedar_swarm_actor_slot){0};
+	if (slot == &state->giant) {
+		state->phase = retirement == SKEDAR_SWARM_DEFEATED ? SKEDAR_SWARM_COMPLETE : SKEDAR_SWARM_FAILED;
+	} else {
+		state->live_raiders--;
+		refresh_phase(state);
+	}
+	return 1;
+}
+
+static void expire_attack(struct skedar_swarm_encounter *state,
+		struct skedar_swarm_actor_slot *slot, uint32_t tick)
+{
+	if (slot->attack.sequence && tick - slot->attack.started_tick >= state->config.attacks.duration_ticks) {
+		clear_attack(state, slot);
+	}
+}
+
+int skedarSwarmAdvanceAttacks(struct skedar_swarm_encounter *state, uint64_t stage_epoch, uint32_t tick)
+{
+	if (!is_active(state, stage_epoch) || tick < state->last_attack_tick) {
+		return 0;
+	}
+	if (tick == state->last_attack_tick) {
+		return 1;
+	}
+	state->last_attack_tick = tick;
+	state->starts_this_tick = 0;
+	if (state->active_attacks) {
+		expire_attack(state, &state->giant, tick);
+		for (int i = 0; i < state->config.max_live_raiders && state->active_attacks; i++) {
+			expire_attack(state, &state->raiders[i], tick);
+		}
+	}
+	return 1;
+}
+
+static int target_qualified(const struct skedar_swarm_target *target, uint32_t tick)
+{
+	return target && target->actor.prop_generation && target->tick == tick
+		&& (target->flags & SKEDAR_SWARM_TARGET_QUALIFIED) == SKEDAR_SWARM_TARGET_QUALIFIED;
+}
+
+int skedarSwarmBeginAttack(struct skedar_swarm_encounter *state, uint64_t stage_epoch,
+		uint32_t tick, struct skedar_swarm_actor attacker, enum skedar_swarm_attack_kind kind,
+		const struct skedar_swarm_target *target, struct skedar_swarm_attack *attack)
+{
+	if (!attack || (unsigned)kind >= SKEDAR_SWARM_ATTACK_KIND_COUNT
+			|| !target_qualified(target, tick) || attacker.prop_index == target->actor.prop_index
+			|| !skedarSwarmAdvanceAttacks(state, stage_epoch, tick)) {
+		return 0;
+	}
+	const struct skedar_swarm_attack_limits *limits = &state->config.attacks;
+	if (state->active_attacks >= limits->active || state->active_by_kind[kind] >= limits->active_by_kind[kind]
+			|| state->starts_this_tick >= limits->starts_per_tick || state->attack_sequence == UINT32_MAX) {
+		return 0;
+	}
+	struct skedar_swarm_actor_slot *slot = find_actor(state, attacker);
+	if (!slot || slot->attack.sequence || tick < slot->next_attack_tick) {
+		return 0;
+	}
+	slot->attack = (struct skedar_swarm_attack){stage_epoch, ++state->attack_sequence,
+		kind, attacker, target->actor, tick};
+	slot->next_attack_tick = later_tick(tick, limits->cooldown_ticks);
+	state->active_attacks++;
+	state->active_by_kind[kind]++;
+	state->starts_this_tick++;
+	*attack = slot->attack;
+	return 1;
+}
+
+static struct skedar_swarm_actor_slot *find_attack(struct skedar_swarm_encounter *state,
+		uint32_t tick, const struct skedar_swarm_attack *attack)
+{
+	if (!attack || !attack->sequence || !skedarSwarmAdvanceAttacks(state, attack->stage_epoch, tick)) {
+		return NULL;
+	}
+	struct skedar_swarm_actor_slot *slot = find_actor(state, attack->attacker);
+	if (!slot || slot->attack.sequence != attack->sequence
+			|| slot->attack.kind != attack->kind || slot->attack.started_tick != attack->started_tick
+			|| !same_actor(slot->attack.target, attack->target)) {
+		return NULL;
+	}
+	return slot;
+}
+
+int skedarSwarmAcceptHit(struct skedar_swarm_encounter *state, uint32_t tick,
+		const struct skedar_swarm_attack *attack, const struct skedar_swarm_target *target)
+{
+	struct skedar_swarm_actor_slot *slot = find_attack(state, tick, attack);
+	if (!slot || slot->hit_committed || !target_qualified(target, tick)
+			|| !same_actor(slot->attack.target, target->actor)
+			|| tick - slot->attack.started_tick < state->config.attacks.telegraph_ticks) {
+		return 0;
+	}
+	slot->hit_committed = 1;
+	return 1;
+}
+
+int skedarSwarmEndAttack(struct skedar_swarm_encounter *state, uint32_t tick,
+		const struct skedar_swarm_attack *attack)
+{
+	struct skedar_swarm_actor_slot *slot = find_attack(state, tick, attack);
+	if (!slot) {
+		return 0;
+	}
+	clear_attack(state, slot);
+	return 1;
+}
diff --git a/tests/test_skedar_swarm_encounter.cpp b/tests/test_skedar_swarm_encounter.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_skedar_swarm_encounter.cpp
@@ -0,0 +1,218 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <initializer_list>
+#include <memory>
+
+#include "skedar_swarm_encounter.h"
+
+namespace {
+
+constexpr uint64_t epoch = 11;
+constexpr skedar_swarm_actor first = {70, 100};
+constexpr skedar_swarm_actor second = {71, 101};
+constexpr skedar_swarm_actor giant = {72, 102};
+constexpr skedar_swarm_actor player = {2, 200};
+
+skedar_swarm_config configuration()
+{
+	skedar_swarm_config config{};
+	config.max_live_raiders = 2;
+	config.max_placement_failures = 3;
+	config.spawn_interval_ticks = 2;
+	config.wave_count = 2;
+	config.waves[0] = {2, SKEDAR_SWARM_ALL_TUNNELS, 0};
+	config.waves[1] = {2, 1u << 2, 5};
+	config.attacks.active = 2;
+	config.attacks.active_by_kind[SKEDAR_SWARM_MELEE] = 2;
+	config.attacks.active_by_kind[SKEDAR_SWARM_JUMP] = 1;
+	config.attacks.active_by_kind[SKEDAR_SWARM_DROP] = 1;
+	config.attacks.starts_per_tick = 1;
+	config.attacks.telegraph_ticks = 2;
+	config.attacks.duration_ticks = 6;
+	config.attacks.cooldown_ticks = 8;
+	return config;
+}
+
+void admit(skedar_swarm_encounter &state, uint32_t tick, skedar_swarm_actor actor)
+{
+	skedar_swarm_ticket ticket{};
+	REQUIRE(skedarSwarmRequestSpawn(&state, epoch, tick, &ticket));
+	REQUIRE(ticket.kind == SKEDAR_SWARM_RAIDER);
+	REQUIRE(skedarSwarmResolveSpawn(&state, &ticket, actor) == SKEDAR_SWARM_SPAWN_COMMITTED);
+}
+
+skedar_swarm_target target_at(uint32_t tick, skedar_swarm_actor actor = player)
+{
+	return {actor, tick, SKEDAR_SWARM_TARGET_QUALIFIED};
+}
+
+} // namespace
+
+TEST_CASE("Swarm commits physical closures once and drains raiders before one Giant", "[swarm][encounter]")
+{
+	auto state = std::make_unique<skedar_swarm_encounter>();
+	const auto config = configuration();
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch, 0));
+	REQUIRE_FALSE(skedarSwarmCloseTunnel(state.get(), epoch, 0, 0));
+	admit(*state, 0, first);
+	skedar_swarm_ticket pending{};
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 2, &pending));
+	REQUIRE(pending.tunnel_index == 1);
+
+	REQUIRE(skedarSwarmCloseTunnel(state.get(), epoch, 1, 1));
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &pending, second) == SKEDAR_SWARM_SPAWN_STALE);
+	REQUIRE_FALSE(skedarSwarmCloseTunnel(state.get(), epoch, 1, 1));
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 4, &pending));
+	REQUIRE(pending.tunnel_index == 2);
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &pending, second) == SKEDAR_SWARM_SPAWN_COMMITTED);
+
+	REQUIRE(skedarSwarmCloseTunnel(state.get(), epoch, 0, 1));
+	REQUIRE(skedarSwarmCloseTunnel(state.get(), epoch, 2, 1));
+	REQUIRE(state->phase == SKEDAR_SWARM_DRAINING);
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 6, &pending));
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, first, SKEDAR_SWARM_DEFEATED));
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 7, &pending));
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, second, SKEDAR_SWARM_DEFEATED));
+	REQUIRE(state->phase == SKEDAR_SWARM_FINALE);
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 8, &pending));
+	REQUIRE(pending.kind == SKEDAR_SWARM_GIANT);
+	REQUIRE(pending.tunnel_index == -1);
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &pending, giant) == SKEDAR_SWARM_SPAWN_COMMITTED);
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &pending, giant) == SKEDAR_SWARM_SPAWN_STALE);
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 20, &pending));
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, giant, SKEDAR_SWARM_DEFEATED));
+	REQUIRE(state->phase == SKEDAR_SWARM_COMPLETE);
+	REQUIRE_FALSE(skedarSwarmRetireActor(state.get(), epoch, giant, SKEDAR_SWARM_DEFEATED));
+}
+
+TEST_CASE("Swarm respects active, wave, spacing, and replacement budgets", "[swarm][encounter]")
+{
+	auto state = std::make_unique<skedar_swarm_encounter>();
+	auto config = configuration();
+	config.max_live_raiders = 1;
+	config.attacks.active = 1;
+	config.attacks.active_by_kind[SKEDAR_SWARM_MELEE] = 1;
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch, 40));
+
+	admit(*state, 40, first);
+	skedar_swarm_ticket ticket{};
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 41, &ticket));
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 42, &ticket));
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, first, SKEDAR_SWARM_DEFEATED));
+	const skedar_swarm_actor replacement = {first.prop_index, first.prop_generation + 1};
+	admit(*state, 42, replacement);
+	REQUIRE_FALSE(skedarSwarmRetireActor(state.get(), epoch, first, SKEDAR_SWARM_DEFEATED));
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, replacement, SKEDAR_SWARM_DEFEATED));
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 44, &ticket));
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 48, &ticket));
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 49, &ticket));
+	REQUIRE(ticket.tunnel_index == 2);
+	REQUIRE(ticket.wave_index == 1);
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch, 49, &ticket));
+}
+
+TEST_CASE("Swarm rejects old epoch work and fails repeated placement without a false clear", "[swarm][encounter]")
+{
+	auto state = std::make_unique<skedar_swarm_encounter>();
+	const auto config = configuration();
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch, 0));
+	skedar_swarm_ticket stale{};
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 0, &stale));
+	skedarSwarmStop(state.get());
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch + 1, 0));
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &stale, first) == SKEDAR_SWARM_SPAWN_STALE);
+	REQUIRE_FALSE(skedarSwarmCloseTunnel(state.get(), epoch, 2, 1));
+
+	skedar_swarm_ticket ticket{};
+	for (uint32_t tick: {0u, 2u, 4u}) {
+		REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch + 1, tick, &ticket));
+		const auto result = tick == 4 ? SKEDAR_SWARM_SPAWN_FAILED : SKEDAR_SWARM_SPAWN_RETRY;
+		REQUIRE(skedarSwarmResolveSpawn(state.get(), &ticket, {}) == result);
+	}
+	REQUIRE(state->phase == SKEDAR_SWARM_FAILED);
+	REQUIRE_FALSE(skedarSwarmRequestSpawn(state.get(), epoch + 1, 10, &ticket));
+}
+
+TEST_CASE("Giant route ignores an abandoned wave delay and cannot clear by removal", "[swarm][encounter]")
+{
+	auto state = std::make_unique<skedar_swarm_encounter>();
+	auto config = configuration();
+	config.waves[0].delay_ticks = 600;
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch, 0));
+	for (int route = 0; route < SKEDAR_SWARM_TUNNEL_COUNT; route++) {
+		REQUIRE(skedarSwarmCloseTunnel(state.get(), epoch, route, 1));
+	}
+	skedar_swarm_ticket ticket{};
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 1, &ticket));
+	REQUIRE(ticket.kind == SKEDAR_SWARM_GIANT);
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &ticket, giant) == SKEDAR_SWARM_SPAWN_COMMITTED);
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, giant, SKEDAR_SWARM_REMOVED));
+	REQUIRE(state->phase == SKEDAR_SWARM_FAILED);
+}
+
+TEST_CASE("Swarm attacks consume bounded tokens and recheck target at contact", "[swarm][encounter]")
+{
+	auto state = std::make_unique<skedar_swarm_encounter>();
+	const auto config = configuration();
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch, 0));
+	admit(*state, 0, first);
+	admit(*state, 2, second);
+
+	skedar_swarm_attack jump{}, drop{}, ignored{};
+	auto observed = target_at(2);
+	REQUIRE(skedarSwarmBeginAttack(state.get(), epoch, 2, first, SKEDAR_SWARM_JUMP, &observed, &jump));
+	REQUIRE_FALSE(skedarSwarmBeginAttack(state.get(), epoch, 2, second, SKEDAR_SWARM_DROP, &observed, &ignored));
+
+	observed = target_at(3);
+	REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 3, &jump, &observed));
+	REQUIRE_FALSE(skedarSwarmBeginAttack(state.get(), epoch, 3, second, SKEDAR_SWARM_JUMP, &observed, &ignored));
+	REQUIRE(skedarSwarmBeginAttack(state.get(), epoch, 3, second, SKEDAR_SWARM_DROP, &observed, &drop));
+	REQUIRE(state->active_attacks == 2);
+
+	REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 4, &jump, &observed));
+	observed = target_at(4, {player.prop_index, player.prop_generation + 1});
+	REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 4, &jump, &observed));
+	for (const unsigned invalid: {SKEDAR_SWARM_TARGET_LIVE, SKEDAR_SWARM_TARGET_HOSTILE,
+			SKEDAR_SWARM_TARGET_VISIBLE, SKEDAR_SWARM_TARGET_IN_RANGE}) {
+		observed = target_at(4);
+		observed.flags &= ~invalid;
+		REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 4, &jump, &observed));
+	}
+	observed = target_at(4);
+	REQUIRE(skedarSwarmAcceptHit(state.get(), 4, &jump, &observed));
+	REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 4, &jump, &observed));
+	REQUIRE(skedarSwarmEndAttack(state.get(), 4, &jump));
+	REQUIRE_FALSE(skedarSwarmBeginAttack(state.get(), epoch, 4, first, SKEDAR_SWARM_JUMP, &observed, &ignored));
+
+	REQUIRE(skedarSwarmRetireActor(state.get(), epoch, second, SKEDAR_SWARM_DEFEATED));
+	REQUIRE(state->active_attacks == 0);
+	observed = target_at(5);
+	REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 5, &drop, &observed));
+	observed = target_at(10);
+	REQUIRE(skedarSwarmBeginAttack(state.get(), epoch, 10, first, SKEDAR_SWARM_JUMP, &observed, &jump));
+	REQUIRE(skedarSwarmAdvanceAttacks(state.get(), epoch, 16));
+	REQUIRE(state->active_attacks == 0);
+	observed = target_at(16);
+	REQUIRE_FALSE(skedarSwarmAcceptHit(state.get(), 16, &jump, &observed));
+}
+
+TEST_CASE("Giant starts a fresh placement budget after tunnel shutdown", "[swarm][encounter]")
+{
+	auto state = std::make_unique<skedar_swarm_encounter>();
+	const auto config = configuration();
+	REQUIRE(skedarSwarmInit(state.get(), &config, epoch, 0));
+	skedar_swarm_ticket ticket{};
+	for (uint32_t tick: {0u, 2u}) {
+		REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, tick, &ticket));
+		REQUIRE(skedarSwarmResolveSpawn(state.get(), &ticket, {}) == SKEDAR_SWARM_SPAWN_RETRY);
+	}
+	for (int tunnel = 0; tunnel < SKEDAR_SWARM_TUNNEL_COUNT; tunnel++) {
+		REQUIRE(skedarSwarmCloseTunnel(state.get(), epoch, tunnel, 1));
+	}
+
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 4, &ticket));
+	REQUIRE(ticket.kind == SKEDAR_SWARM_GIANT);
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &ticket, {}) == SKEDAR_SWARM_SPAWN_RETRY);
+	REQUIRE(skedarSwarmRequestSpawn(state.get(), epoch, 6, &ticket));
+	REQUIRE(skedarSwarmResolveSpawn(state.get(), &ticket, giant) == SKEDAR_SWARM_SPAWN_COMMITTED);
+}
