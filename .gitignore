# Build artifacts
build/
ClaudeBuilds/
Cursor Build/
dist/

# Office app temp files (Word / Excel / PowerPoint open-document locks)
# AUDIT-23-M2 (2026-04-25): prevents `~$*.docx` etc. from leaking into commits
# when a tester opens a `.docx` reference document mid-session.
~$*
*.~lock.*
backups/
*.exe
*.dll
*.o
*.obj
!tests/fixtures/modpipe/external-folder/maps/tri_arena/geometry.obj
!tests/fixtures/modpipe/external-archive-entries/maps/tri_arena/geometry.obj
*.a
*.pdb
*.pyc
*.lnk

# ROM outputs
pd.*.z64

# Asset binaries (extracted from ROM — not committed)
src/assets/*/*.bin
src/assets/*/*.ctl
src/assets/*/*.tbl
src/assets/*/animations/*.bin
src/assets/*/files/audio/*.mp3
src/assets/*/files/bgdata/*.bin
src/assets/*/files/bgdata/*.seg
src/assets/*/files/chrs/*.bin
src/assets/*/files/guns/*.bin
src/assets/*/files/props/*.bin
src/assets/*/files/ob/ob_mid.seg
src/assets/*/fonts/*.bin
src/assets/*/sequences/*.seq
src/assets/*/textures/*.bin
src/generated

# Build tool (local machine state)
.build-settings.json
.build-release-cache.json
.dev-window-release-cache.json
.dev-window-settings.json
._dev-window-settings.json
devtools/dev-window-v2/settings.json
devtools/dev-window-v2/dev-window-v2-debug.log
devtools/dev-window-v2/dev-window-v2-console.log*
.pdxxx-dev-extracts/

# Tools
tools/mkrom/mkrom

# Build logs
build_errors.log
build/game_output.log
logs/

# Claude Code worktrees (prevent git add -A from scanning them)
.claude/worktrees/

# Per-session isolated build directories for concurrent code sessions
.claude/session-builds/

# Claude Code session build/verify directories (ephemeral build artifacts)
.claude/b8-dev-verify/
.claude/mb2/
.claude/merge-build/
.claude/post-merge-build/
.claude/temp-build/
.claude/verify-build/

# Claude Code pre-op git snapshots (devtools/git-snapshot.sh output)
.claude/git-snapshots/

# Claude Code per-session scratch (final reports, ad-hoc test scripts, etc.)
.claude/scratch/

# Smoke verification generated output and runtime caches (whole install +
# extraction cache is a full game install -- multi-GB, never committed).
.claude/smoke-verify-runs/
.claude/smoke-verify-install/
.claude/smoke-verify-cache/

# Claude Code transient session artifacts (logs, audit/codex/orchestrator runs,
# sprint reports, scratch tmp). The Dev Window git add -A used to sweep these in;
# some grew past GitHub's 100MB limit and blocked the push.
.claude/*.log
.claude/audit-logs/
.claude/codex-runs/
.claude/orchestrator/
.claude/sprint-reports/
.claude/tmp/
.claude/texview/
.claude/glshot/

# Root-level ad-hoc texture diagnostics (from decode/render debugging)
/tex_*.png

# Claude Code local settings (machine-specific, not committed)
.claude/settings.local.json

# Editor artifacts (Word/Excel lock files, temp files)
~$*
*.tmp
*~
.DS_Store

# Word document extract trees -- regenerated on demand from the .docx;
# .md in context/ is the canonical knowledge base. AUDIT-23-L1 fix:
# stop tracking new extracts. Existing tracked files in
# context/_docx_extract/ remain in git history but should not be
# re-committed; if you need to untrack them entirely, run
#   git rm -r --cached context/_docx_extract/
# in a dedicated commit.
context/_docx_extract/

# IDE / editor
/.vs
/.vscode
CppProperties.json
.idea
cmake-build-debug

# Git recovery artifacts
.git.broken/

# SEC-6: Developer-owned Ed25519 signing keys. Private key MUST never be
# committed. Public key is embedded in port/include/updater_pubkey.h.
dev-keys/
release-keys/
*.sig

# Flatpak
.flatpak-builder

# Extracted ROM data
extracted

# Daily-flow orchestrator per-day operational state (regenerated by each 6 AM run).
# Durable narrative anchor (decisions.json) lives at tools/daily_flow/decisions.json
# and IS committed.
tools/daily_flow/state/

# CodexCoordination is live machine/session/FIFO state. Durable project truth
# belongs in Tools/Workbench/data; coordination state must never be committed.
/.codex-coordination/
