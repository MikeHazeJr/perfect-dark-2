{
  "scenario_name": "mp_capture_the_case_net_carrier_death_smoke",
  "description": "B-1272 / T-NETWORKING-011, networked Capture the Case when a case carrier dies. A listen host and one client start Capture the Case on Complex with three simulants as mp_capture_the_case_net_smoke does (150 s time limit). Once a simulant has carried an enemy case for 1 s, the host kills it (kill_token_holder, chrDamageByMisc). The dying simulant drops the case, which goes back to its home pad (scenarioHandleDroppedToken) and is announced (botinvDrop, SVC_PROP_SPAWN); before B-1272 the briefcase had no session catalog id and the client built it as WEAPON_UNARMED. Passes when the host announces the dropped case as weapon 79, simulants take cases again, and the client never replays a pickup as weapon 1. Each process runs its own schedule; both exit from their results. Written 2026-11-16; port 27268.",
  "tags": [
    "network",
    "combatsim",
    "bots",
    "multiplayer-modes",
    "scenario",
    "b-1272",
    "t-networking-011"
  ],
  "paths_of_interest": [
    "src/game/mplayer/scenarios/capturethecase.inc",
    "src/game/mplayer/scenarios.c",
    "src/game/botinv.c",
    "port/src/net/netmsg.c",
    "port/src/smoke_harness.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 900,
  "install_state": "clean",
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--host",
        "--listen-bind",
        "27268",
        "--launch-mp-room",
        "base:arena_mp_complex",
        "base:capture_the_case",
        "3",
        "--host-autostart",
        "--match-timelimit-sec",
        "150"
      ],
      "wait_for": "NET: created server on port 27268",
      "wait_timeout_seconds": 120,
      "smoke_path": "tools/smoke-verify/fixtures/mp_capture_the_case_net_carrier_death_host.json",
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "SMOKE\\.WAIT: satisfied condition=scenario_token_held",
          "SMOKE\\.KILL_TOKEN_HOLDER: simulant player=[2-4] token=case died=1",
          "BOT\\.DROP: host announced simulant [2-4] weapon=79 syncid=[0-9]+",
          "MANIFEST-HOST: scenario 5 token weapon 79 as '[^']+'"
        ],
        "required_sequences": [
          {
            "name": "dropped-case-announced-and-taken-again",
            "patterns": [
              "SMOKE\\.WAIT: satisfied condition=scenario_token_held",
              "BOT\\.DROP: host announced simulant [2-4] weapon=79 syncid=[0-9]+",
              "SMOKE\\.KILL_TOKEN_HOLDER: simulant player=[2-4] token=case died=1",
              "BOT\\.PICKUP: host sent simulant [2-4] item [0-9]+ weapon=79 "
            ]
          }
        ],
        "forbidden_patterns": [
          "SMOKE\\.KILL_TOKEN_HOLDER: no living simulant",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      }
    },
    {
      "name": "client",
      "log_file": "pd-client.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--connect-host",
        "127.0.0.1:27268"
      ],
      "smoke_path": "tools/smoke-verify/fixtures/mp_capture_the_case_net_carrier_death_client.json",
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=79 "
        ],
        "required_sequences": [
          {
            "name": "client-takes-cases-as-briefcases",
            "patterns": [
              "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=79 ",
              "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=79 "
            ]
          }
        ],
        "forbidden_patterns": [
          "BOT\\.PICKUP: client skipped",
          "BOT\\.PICKUP: client replayed simulant [0-9]+ item [0-9]+ weapon=1 result=",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      }
    }
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "Each process runs its own schedule (smoke_path); this one only bounds the test."
    },
    {
