{
  "scenario_name": "base_animation_source_probe_smoke",
  "description": "B-772 runtime probe: force a base character .pdanim through the public animation.gltf source path, compile it to the catalog-owned animtableentry boundary, then decode frame transforms through the normal game animation consumer.",
  "tags": ["modding", "pdxxx", "animation", "source-gate", "b772", "smoke", "pillar:modding"],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/mod.c",
    "port/src/assetcatalog_load.c",
    "port/src/modasset_compiler.c",
    "port/src/romextract_pdanim_chr.c",
    "port/src/loader_walker_anim.c",
    "tools/smoke-verify/tests/base_animation_source_probe_smoke.json"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 120,
  "install_state": "clean",
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--skip-intro",
    "--debug-probe-animation-source-only",
    "--debug-probe-animation-source",
    "base:animation_big_sneeze"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "catalog bootstrap extracts and walks base character animation archives before the source probe runs." },
    { "at_ms": 90000, "type": "exit", "comment": "exit after cold catalog extraction plus the probe has loaded, compiled, installed, and decoded the source-built animation clip." }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=base_animation_source_probe_smoke",
      "BOOT: --debug-probe-animation-source request id='base:animation_big_sneeze' source_only=1",
      "MODASSET\\.COMPILER: built animation clip 'base:animation_big_sneeze' source=.*base_animation_big_sneeze\\.pdanim::animation\\.gltf.*boundary=animtableentry",
      "CATALOG\\.LIFECYCLE\\.ACTIVATE: activated animation clip 'base:animation_big_sneeze'.*generated=.*\\.pdanimation\\.json",
      "BOOT: --debug-probe-animation-source result id='base:animation_big_sneeze' anim=\\d+ result=OK source=.*base_animation_big_sneeze\\.pdanim::animation\\.gltf frames=\\d+ bytes_per_frame=\\d+ header_len=\\d+ data=0xffffffff frame0_slot=\\d+ frame1_slot=\\d+ sampled_parts=128 non_default_parts=[1-9]\\d* changed_parts=[1-9]\\d*",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum",
      "header\\.tsv",
      "frames\\.tsv",
      "external animation clip build failed",
      "invalid external animation source"
    ],
    "required_counts": [
      { "pattern": "BOOT: --debug-probe-animation-source result id='base:animation_big_sneeze'.*result=OK", "min": 1, "max": 1 }
    ]
  }
}
