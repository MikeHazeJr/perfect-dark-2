  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "vehicle_driver_ready",
      "timeout_ms": 240000,
      "stable_ms": 1000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900,
      "comment": "Boot makes the Maian vehicle (the mod author's recipe) and the level (the Blank Room with a hoverbike that Forge's level document adds), the match starts on that level with no simulants, the hoverbike takes the Maian vehicle's model, and --debug-mount-bike puts Player 0 in its driver seat as soon as the player walks. A match intro, if any, is skipped. The script waits here until the player has driven-seat control for a second."
    },
    {
      "at_ms": 1000,
      "type": "action",
      "name": "ACTION_VEHICLE_ACCELERATE",
      "action": "press",
      "comment": "Drive forward, so the input line and the speed-scaled recovery have speed."
    },
    {
      "at_ms": 1500,
      "type": "action",
      "name": "ACTION_VEHICLE_BOOST",
      "action": "press",
      "comment": "Hold boost: ramping, full after about 1 s of game time (turret locked), overheated after about 4 s."
    },
    {
      "at_ms": 11500,
      "type": "action",
      "name": "ACTION_VEHICLE_BOOST",
      "action": "release",
      "comment": "Let go after 10 s of real time. The boost needs 4 s of game time to overheat, and the game falls behind real time when the frame rate drops under about 20 (B-1234: the Maian vehicle runs at 17 to 41 frames a second in most runs on the test PC; a 5.5 s hold at 17 frames a second gave only 3 s of game time and no overheat). 10 s covers the game running at less than half speed. The crystals stay black while they recover."
    },
    {
      "at_ms": 11500,
      "type": "action",
      "name": "ACTION_VEHICLE_ACCELERATE",
      "action": "release",
      "comment": "Slow down; recovery is faster at low speed."
    },
    {
      "at_ms": 22000,
      "type": "exit",
      "comment": "Scripted exit once the crystals are cool again: 2 to 4 s of game time after letting go, up to about 9 s of real time when the game runs at half speed."
    }
  ],
