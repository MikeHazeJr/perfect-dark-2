{
  "scenario_name": "pdxxx_modder_workflow_smoke",
  "description": "c3844-s110 runtime smoke: package the all-family modder-authored typed .pdxxx example as a strict .pdmod, install it under the normal installed-mod category, enable it, and force representative custom geometry, texture/material, animation, audio, and gameplay-linked scenario/map data through catalog/provider runtime loads.",
  "tags": ["modding", "pdmod", "pdxxx", "source-gate", "custom-assets", "c3844", "s110", "smoke", "pillar:modding"],
  "paths_of_interest": [
    "examples/modding/typed-pdxxx-basic",
    "port/src/modmgr.c",
    "port/src/modarchive.c",
    "port/src/modvfs.c",
    "port/src/assetcatalog_scanner.c",
    "port/src/assetcatalog_load.c",
    "port/src/main.c",
    "tools/smoke-verify/lib/Install-Harness.ps1",
    "tools/smoke-verify/run.ps1",
    "tools/verify_pdxxx_modder_workflow.py"
  ],
  "log_channel_mask": "Mods,Catalog,System,Game,Audio",
  "verbose": 0,
  "timeout_seconds": 170,
  "install_state": "prefilled",
  "remove_paths": [
    "mods/example_typed_pdxxx_basic.pdmod",
    "mods/example_typed_pdxxx_basic",
    "mods/installed/example_typed_pdxxx_basic.pdmod",
    "mods/installed/example_typed_pdxxx_basic",
    "mods/fixture_pdxxx_content.pdmod",
    "mods/fixture_pdxxx_content",
    "mods/installed/fixture_pdxxx_content.pdmod",
    "mods/installed/fixture_pdxxx_content",
    "mods/scenario_generated_nav_fixture.pdmod",
    "mods/scenario_generated_nav_fixture",
    "mods/installed/scenario_generated_nav_fixture.pdmod",
    "mods/installed/scenario_generated_nav_fixture"
  ],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini", "dst": "pd.ini" },
    { "src": "tools/smoke-verify/fixtures/typed_pdxxx_basic_enabled.json", "dst": "mods-enabled.json" }
  ],
  "packed_fixtures": [
    { "src": "examples/modding/typed-pdxxx-basic", "dst": "mods/installed/example_typed_pdxxx_basic.pdmod" }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-net",
    "--portable",
    "--skip-intro",
    "--debug-exit-after-catalog-probes",
    "--debug-load-catalog-assets-source-only",
    "--debug-load-catalog-assets",
    "model=example:tri_mesh,texture=example:tri_texture,material=example:tri_material,animation=example:character_skeletal,arena=example:tri_arena,scenario=example:tri_scenario,mission=example:tri_mission,weapon=example:tri_weapon,sfx=example:tri_click,voice=example:tri_voice,song=example:tri_song",
    "--debug-play-catalog-audio-source-only",
    "--debug-play-catalog-audio",
    "sfx=example:tri_click,voice=example:tri_voice,song=example:tri_song"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "clean portable install, pack the editable all-family example into .pdmod, load it from mods/installed, and run source-only custom catalog/provider probes after mod catalog registration." },
    { "at_ms": 90000, "type": "exit", "comment": "fallback scripted exit; the client normally exits earlier via --debug-exit-after-catalog-probes once representative custom assets have loaded or registered through source-only catalog/provider paths." }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=pdxxx_modder_workflow_smoke",
      "BOOT: --no-net set; netInit\\(\\) skipped",
      "modmgr: loaded mods-enabled\\.json",
      "modmgr: parsed mod\\.json for 'example_typed_pdxxx_basic'.*archive=yes",
      "modmgr: discovered mod \\[\\d+\\] 'example_typed_pdxxx_basic'.*\\[\\.pdmod\\] from 'installed' file=.*installed.*example_typed_pdxxx_basic\\.pdmod sha256=[0-9a-f]+\\.\\.",
      "modmgr: loading mod 'example_typed_pdxxx_basic' from archive '.*installed.*example_typed_pdxxx_basic\\.pdmod'",
      "assetcatalog_scanner: archive example_typed_pdxxx_basic: \\d+ component descriptors registered",
      "BOOT: --debug-load-catalog-assets request type=model id='example:tri_mesh' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=model id='example:tri_mesh' result=OK",
      "BOOT: --debug-load-catalog-assets request type=texture id='example:tri_texture' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=texture id='example:tri_texture' result=OK",
      "BOOT: --debug-load-catalog-assets request type=material id='example:tri_material' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=material id='example:tri_material' result=OK",
      "BOOT: --debug-load-catalog-assets request type=animation id='example:character_skeletal' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=animation id='example:character_skeletal' result=OK",
      "BOOT: --debug-load-catalog-assets animation id='example:character_skeletal' clip=(?:0x)?0*[1-9a-fA-F][0-9a-fA-F]+ entry=(?:0x)?0*[1-9a-fA-F][0-9a-fA-F]+ bytes=[1-9]\\d*",
      "BOOT: --debug-load-catalog-assets request type=arena id='example:tri_arena' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=arena id='example:tri_arena' result=OK",
      "BOOT: --debug-load-catalog-assets request type=scenario id='example:tri_scenario' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=scenario id='example:tri_scenario' result=OK",
      "BOOT: --debug-load-catalog-assets colmesh type=scenario id='example:tri_scenario' ptr=(?:0x)?0*[1-9a-fA-F][0-9a-fA-F]+",
      "BOOT: --debug-load-catalog-assets request type=mission id='example:tri_mission' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=mission id='example:tri_mission' result=OK",
      "BOOT: --debug-load-catalog-assets request type=weapon id='example:tri_weapon' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='example:tri_weapon' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='example:tri_click' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='example:tri_click' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='example:tri_voice' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='example:tri_voice' result=OK",
      "BOOT: --debug-load-catalog-assets request type=audio id='example:tri_song' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=audio id='example:tri_song' result=OK",
      "BOOT: --debug-play-catalog-audio request kind=sfx id='example:tri_click' source_only=1",
      "BOOT: --debug-play-catalog-audio result kind=sfx id='example:tri_click' result=OK",
      "BOOT: --debug-play-catalog-audio request kind=voice id='example:tri_voice' source_only=1",
      "BOOT: --debug-play-catalog-audio result kind=voice id='example:tri_voice' result=OK",
      "BOOT: --debug-play-catalog-audio request kind=song id='example:tri_song' source_only=1",
      "BOOT: --debug-play-catalog-audio result kind=song id='example:tri_song' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "LOUDFAIL\\.FALLBACK",
      "ASSET\\.FALLBACK",
      "result=FAIL",
      "result=MISSING",
      "CATEGORY_MISMATCH",
      "RomProvider:filenum",
      "authored \\.bin",
      "public \\.tsv",
      "External-format archives cannot contain \\.bin",
      "gltf_external_binary_buffers_are_not_allowed",
      "fsFileLoad: could not find file: .*example_typed_pdxxx_basic/.*/mod\\.json",
      "CATALOG\\.LIFECYCLE\\.ACTIVATE: '.*' external .* failed",
      "MODASSET\\.COMPILER: invalid external"
    ],
    "required_counts": [
      { "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK", "min": 11, "max": 11 },
      { "pattern": "BOOT: --debug-play-catalog-audio result kind=.* result=OK", "min": 3, "max": 3 }
    ]
  }
}
