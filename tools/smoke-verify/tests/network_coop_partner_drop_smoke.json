{
  "scenario_name": "network_coop_partner_drop_smoke",
  "description": "T-NETWORKING-007 S1 (Mike, 2026-11-16: a player who drops from a networked co-op mission does not end it). A listen host and one client start co-op Defection on Agent as network_coop_mission_end_smoke does. Once both have usable control, the host times the client out through the production disconnect path (network_timeout_client). The host parks the partner instead of killing it (playerParkForNetwork: out of the prop and room lists, hidden, guards' references cleared, its weapons and health kept), says it dropped out, and plays on alone until --debug-end-mission ends the mission at 60 s with every objective complete. Passes when the host parks player 1, never kills it, shows one results screen (its own), and the client is dropped back to where it could reconnect. Written 2026-11-17; port 27270.",
  "tags": [
    "network",
    "campaign",
    "coop",
    "drop-in-drop-out",
    "multi-process",
    "smoke",
    "t-networking-007"
  ],
  "paths_of_interest": [
    "port/src/net/net.c",
    "src/game/player.c",
    "src/game/propobj.c",
    "port/src/pdmain.c",
    "port/src/smoke_harness.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 900,
  "install_state": "clean",
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--host",
        "--listen-bind",
        "27270",
        "--launch-mp-room",
        "base:defection",
        "base:combat",
        "0",
        "--host-autostart",
        "--host-autostart-mode",
        "coop",
        "--difficulty",
        "agent",
        "--debug-end-mission",
        "60:complete"
      ],
      "wait_for": "NET: created server on port 27270",
      "wait_timeout_seconds": 140,
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "SMOKE\\.WAIT: satisfied condition=gameplay_ready",
          "SMOKE\\.NETWORK: timeout_client client=1 ",
          "NET: parked dropped co-op partner .* \\(player 1\\) retryable=1",
          "COOP\\.PARK: parked player 1 health=",
          "BOOT: --debug-end-mission ending stage=0x[0-9a-f]+ result=complete",
          "GAMELOOP\\.COOP: endscreenPushCoop entry playernum=0 ",
          "SMOKE\\.WAIT: satisfied condition=endscreen_visible"
        ],
        "required_sequences": [
          {
            "name": "partner-parked-then-host-plays-to-the-end",
            "patterns": [
              "SMOKE\\.WAIT: satisfied condition=gameplay_ready",
              "SMOKE\\.NETWORK: timeout_client client=1 ",
              "COOP\\.PARK: parked player 1 health=",
              "NET: parked dropped co-op partner ",
              "BOOT: --debug-end-mission ending stage=",
              "GAMELOOP\\.COOP: endscreenPushCoop entry playernum=0 ",
              "SMOKE\\.WAIT: satisfied condition=endscreen_visible"
            ]
          }
        ],
        "forbidden_patterns": [
          "NET: killed disconnected player",
          "GAMELOOP\\.COOP: endscreenPushCoop entry playernum=1 ",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      },
      "smoke_path": "tools/smoke-verify/fixtures/network_coop_partner_drop_host.json"
    },
    {
      "name": "client",
      "log_file": "pd-client.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--connect-host",
        "127.0.0.1:27270"
      ],
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "SMOKE\\.WAIT: satisfied condition=gameplay_ready",
          "SMOKE\\.WAIT: satisfied condition=network_reconnect_available"
        ],
        "forbidden_patterns": [
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      },
      "smoke_path": "tools/smoke-verify/fixtures/network_coop_partner_drop_client.json"
    }
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "Each process runs its own schedule (smoke_path); this one only bounds the test."
    },
    {
      "at_ms": 840000,
      "type": "exit"
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=network_coop_partner_drop_host",
      "SMOKE: scenario=network_coop_partner_drop_client",
      "NET: created server on port 27270",
      "NET: incoming connection",
      "BOOT: --debug-end-mission armed: seconds=60 result=complete",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "prop with syncid .* does not exist",
      "SVC_NPC_SYNC checksum mismatch",
      "SVC_NPC_SYNC snapshot mismatch",
      "SVC_NPC_SYNC rejected",
      "SVC_NPC_RESYNC rejected",
      "requesting npc resync",
      "NET.STAGE.REPLICATION release=retry",
      "NET.STAGE.REPLICATION ready=rejected",
      "malformed or unknown message 0x4b",
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ROSTER_MISMATCH",
      "MENU\\.GRAPH\\.FIRE .* ok=0",
      "LOBBY: results screen did not open within",
      "GAMELOOP\\.COOP: no next mission",
      "start request failed",
      "BOOT: --debug-end-mission rejected",
      "BOOT: --debug-clone-guard (found no|could not|rejected)",
      "NET\\.NPC: client could not make the host's chr",
      "NET\\.NPC: client has no chr for syncid=",
      "SAVE: Agent Profile serialization failed",
      "PLAYER\\.INIT\\.ROLLBACK",
      "NET: weapon [0-9]+ .* has no session catalog id",
      "NET: model [0-9]+ .* has no session catalog id"
    ],
    "required_counts": [
      {
        "pattern": "SMOKE: scenario=network_coop_partner_drop_(host|client)",
        "min": 2,
        "max": 2
      },
      {
        "pattern": "COOP\\.PARK: parked player ",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "GAMELOOP\\.COOP: endscreenPushCoop entry",
        "min": 1,
        "max": 1
      }
    ]
  }
}
