{
  "scenario_name": "forge_grid_placed_nested_model_smoke",
  "description": "A stock Cyclone Grid match uses a plain prop whose mesh is embedded in the unselected Triangle Weapon archive. The guest accepts the exact arena and weapon owner, loads the prop from the transferred native source, and returns to the same Room after both leases retire.",
  "tags": ["modding", "forge", "network", "pdmesh", "pdweapon", "match-lifecycle", "temporary-content"],
  "paths_of_interest": [
    "port/src/forge_level_io.c",
    "port/src/grid_match_sources.c",
    "port/src/grid_match_runtime.c",
    "port/src/net/netmsg.c",
    "port/src/net/netdistrib.c",
    "port/src/assetcatalog_scanner.c",
    "port/src/pdmain.c",
    "src/game/modeldef.c",
    "src/game/setuputils.c",
    "tools/smoke-verify/fixtures/mod_author/grid_triangle/recipe.json",
    "tools/smoke-verify/fixtures/grid_two_package_guest_process.json"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 570,
  "install_state": "clean",
  "window_focus_transition": {
    "from_process": "host",
    "to_process": "guest",
    "source_wait_for": "INPUTCTX: focus GAINED",
    "wait_for": "INPUTCTX: focus LOST",
    "timeout_seconds": 15,
    "settle_ms": 500
  },
  "remove_paths": ["gpnm-h", "gpnm-g"],
  "fixtures": [
    {
      "src": "dev-mods/grid_two_rooms/grid_two_rooms.pdarena",
      "dst": "grid/templates/grid_two_rooms.pdarena"
    },
    {
      "src": "tools/smoke-verify/fixtures/mod_author/grid_triangle/recipe.json",
      "dst": "gpnm-h/recipes/grid_triangle/recipe.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/weapons/tri_weapon.pdweapon",
      "dst": "gpnm-h/recipes/grid_triangle/tri_weapon.pdweapon"
    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "gpnm-h/mods/.pdmod-migration-done"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "gpnm-h/mods-enabled.json"
    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "gpnm-g/mods/.pdmod-migration-done"
    },
    {
      "src": "tools/smoke-verify/fixtures/no_mods_enabled.json",
      "dst": "gpnm-g/mods-enabled.json"
    }
  ],
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable", "--savedir", "$E/gpnm-h", "--moddir", "$E/gpnm-h/mods",
        "--no-update-check", "--no-sound", "--skip-intro", "--debug-force-first-person",
        "--mod-author", "gpnm-h/recipes/grid_triangle/recipe.json",
        "--debug-grid-share-weapon", "mod:weapon_grid_triangle",
        "--debug-level-tool-new", "original",
        "--debug-level-tool-name", "Grid_Placed_Nested_Model",
        "--debug-grid-room-size", "2100,2700,1800,600,500,390",
        "--debug-forge-level", "mod:arena_grid_placed_nested_model",
        "--debug-forge-level-name", "Grid_Placed_Nested_Model",
        "--debug-forge-level-prop", "mod:weapon_grid_triangle__mesh_tri_mesh",
        "--debug-forge-level-pin", "--debug-forge-level-share",
        "--host", "--listen-bind", "27524",
        "--launch-mp-room", "mod:arena_grid_placed_nested_model", "base:combat", "0",
        "--debug-spawn-weapon", "base:cyclone",
        "--host-autostart", "--match-timelimit-sec", "35"
      ],
      "wait_for": "NET: created server on port 27524",
      "wait_timeout_seconds": 240,
      "assertions": {
        "required_lines": [
          "SAVE: initialized .*gpnm-h",
          "LEVELTOOL\\.ORIGINAL\\.SEED: template=mod_grid_two_rooms:arena_grid_two_rooms seed_catalogued=0",
          "MATCH\\.RESULT: scenario=0 teams=0 chrs=2 netmode=1",
          "NET: CLC_LOBBY_RESYNC from client=1, replaying room state room=1$",
          "LOBBY\\.REVIEW: client=1 reviewing=0 reason=continue"
        ],
        "required_sequences": [
          {
            "name": "host-authors-and-plays-the-placed-weapon-mesh-with-stock-spawn",
            "patterns": [
              "MODAUTHOR\\.RECIPE\\.RESULT result=OK catalog=mod:weapon_grid_triangle",
              "FORGE\\.WEAPON\\.SHARE: granted weapon=mod:weapon_grid_triangle sha256=[0-9a-f]{64} bytes=[1-9][0-9]*",
              "FORGE\\.LEVEL\\.EDIT: made prop setup_[0-9]+ drawn with mod:weapon_grid_triangle__mesh_tri_mesh at ",
              "FORGE\\.LEVEL\\.SAVE\\.OK: template=mod:arena_grid_placed_nested_model catalog=mod:arena_grid_placed_nested_model",
              "FORGE\\.REVISION\\.SHARE: granted arena=mod:arena_grid_placed_nested_model sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.OFFER: host prepared arena=mod:arena_grid_placed_nested_model",
              "NET\\.GRID\\.OFFER: host recorded ready client=1 generation=[1-9][0-9]*",
              "GRID\\.MATCH\\.STAGE: active arena=mod:arena_grid_placed_nested_model epoch=[1-9][0-9]* digest=[0-9a-f]{64}",
              "GRID\\.SPAWN\\.ACTIVE: id=base:cyclone mode=0 weaponnum=11$",
              "MODELDEF\\.SOURCE: loaded catalog model source type=23 filenum=[1-9][0-9]* id=mod:weapon_grid_triangle__mesh_tri_mesh path=.*\\.pdweapon::dependencies/assets/models/weapon\\.pdmesh::model\\.gltf$",
              "MODEL\\.SLOT: custom slot [1-9][0-9]* 'mod:weapon_grid_triangle__mesh_tri_mesh' world scale ",
              "NET\\.GRID\\.RESULT: room=1 generation=[1-9][0-9]* epoch=[1-9][0-9]* reason=1 arena=mod:arena_grid_placed_nested_model revision=[0-9a-f]{64} scores=[0-9a-f]{64} rows=2$",
              "GAMELOOP\\.MP: endscreen EXIT_TO_ROOM",
              "SMOKE: result=scripted_exit scenario=forge_grid_placed_nested_model_smoke"
            ]
          }
        ]
      }
    },
    {
      "name": "guest",
      "log_file": "pd-client.log",
      "smoke_path": "tools/smoke-verify/fixtures/grid_two_package_guest_process.json",
      "boot_args": [
        "--portable", "--savedir", "$E/gpnm-g", "--moddir", "$E/gpnm-g/mods",
        "--no-update-check", "--no-sound", "--skip-intro", "--debug-force-first-person",
        "--connect-host", "127.0.0.1:27524"
      ],
      "wait_for": "NET: SVC_AUTH from server, our ID is 1",
      "wait_timeout_seconds": 235,
      "assertions": {
        "required_lines": [
          "SAVE: initialized .*gpnm-g",
          "NET: SVC_AUTH from server, our ID is 1",
          "DISTRIB\\.GRID: receiving package=[12]/2 id=mod:arena_grid_placed_nested_model verified=[0-9]+ total=[1-9][0-9]*$",
          "DISTRIB\\.GRID: receiving package=[12]/2 id=mod:weapon_grid_triangle verified=[0-9]+ total=[1-9][0-9]*$",
          "MATCH\\.RESULT: scenario=0 teams=0 chrs=2 netmode=2"
        ],
        "required_sequences": [
          {
            "name": "guest-consents-and-loads-the-placed-mesh-from-the-exact-weapon-owner",
            "patterns": [
              "NET: SVC_ROOM_ASSIGN: assigned to room 1$",
              "DISTRIB\\.GRID: temporary packages await consent count=2 bytes=[1-9][0-9]*",
              "SMOKE\\.WAIT\\.GRIDCONSENT: satisfied preparing=1 pending=1 accept_focused=1 input_top=1 keyboard_ready=1",
              "SMOKE\\.ACTION\\.INJECT: player=0 action=24 down=1 .*held_after=1 pressed_after=1",
              "DISTRIB\\.GRID: receiving package=1/2 id=mod:(arena_grid_placed_nested_model|weapon_grid_triangle) verified=0 total=[1-9][0-9]*$",
              "NET\\.GRID\\.TRANSFER: guest approved arena=mod:arena_grid_placed_nested_model packages=2$",
              "DISTRIB\\.GRID: receiving package=2/2 id=mod:(arena_grid_placed_nested_model|weapon_grid_triangle) verified=[1-9][0-9]* total=[1-9][0-9]*$",
              "NET\\.GRID\\.TRANSFER: admitted exact temporary arena=mod:arena_grid_placed_nested_model bytes=[1-9][0-9]*$",
              "NET\\.GRID\\.TRANSFER: admitted exact temporary weapon=mod:weapon_grid_triangle bytes=[1-9][0-9]*$",
              "NET\\.GRID\\.TRANSFER: guest ready arena=mod:arena_grid_placed_nested_model generation=[1-9][0-9]* digest=[0-9a-f]{64}",
              "MATCH: client stage start received",
              "GRID\\.MATCH\\.STAGE: active arena=mod:arena_grid_placed_nested_model epoch=[1-9][0-9]* digest=[0-9a-f]{64}",
              "GRID\\.SPAWN\\.ACTIVE: id=base:cyclone mode=0 weaponnum=11$",
              "MODELDEF\\.SOURCE: loaded catalog model source type=23 filenum=[1-9][0-9]* id=mod:weapon_grid_triangle__mesh_tri_mesh path=.*gpnm-g/grid-session/[0-9a-f]{64}\\.pdweapon::dependencies/assets/models/weapon\\.pdmesh::model\\.gltf$",
              "MODEL\\.SLOT: custom slot [1-9][0-9]* 'mod:weapon_grid_triangle__mesh_tri_mesh' world scale ",
              "NET\\.GRID\\.RESULT: room=1 generation=[1-9][0-9]* epoch=[1-9][0-9]* reason=1 arena=mod:arena_grid_placed_nested_model revision=[0-9a-f]{64} scores=[0-9a-f]{64} rows=2$",
              "GAMELOOP\\.MP: endscreen EXIT_TO_ROOM",
              "NET: CLC_LOBBY_RESYNC sent to server",
              "NET: SVC_ROOM_ASSIGN: assigned to room 1$",
              "NET: SVC_ROOM_SETTINGS: .* stage='mod:arena_grid_placed_nested_model'",
              "SMOKE: result=scripted_exit scenario=forge_grid_temporary_arena_weapon_smoke"
            ]
          },
          {
            "name": "guest-retires-arena-before-resync",
            "patterns": [
              "GAMELOOP\\.MP: endscreen EXIT_TO_ROOM",
              "GRID\\.MATCH\\.LEASE: retired temporary arena=mod:arena_grid_placed_nested_model$",
              "NET: CLC_LOBBY_RESYNC sent to server"
            ]
          },
          {
            "name": "guest-retires-weapon-owner-before-resync",
            "patterns": [
              "GAMELOOP\\.MP: endscreen EXIT_TO_ROOM",
              "GRID\\.MATCH\\.LEASE: retired temporary weapon=mod:weapon_grid_triangle$",
              "NET: CLC_LOBBY_RESYNC sent to server"
            ]
          }
        ],
        "required_counts": [
          { "pattern": "DISTRIB\\.GRID: temporary (arena awaits|packages await) consent", "min": 1, "max": 1 },
          { "pattern": "NET\\.GRID\\.TRANSFER: guest approved", "min": 1, "max": 1 },
          { "pattern": "NET\\.GRID\\.TRANSFER: admitted exact temporary ", "min": 2, "max": 2 },
          { "pattern": "GRID\\.MATCH\\.LEASE: retired temporary ", "min": 2, "max": 2 }
        ],
        "forbidden_patterns": [
          "MODAUTHOR\\.RECIPE\\.RESULT",
          "FORGE\\.WEAPON\\.SHARE: granted",
          "FORGE\\.REVISION\\.SHARE: granted",
          "modmgr: loading mod 'weapon_grid_triangle'",
          "NET\\.GRID\\.OFFER: guest ready arena=mod:arena_grid_placed_nested_model",
          "DISTRIB\\.GRID: receiving package=[1-9][0-9]*/2 id=(?!mod:(arena_grid_placed_nested_model|weapon_grid_triangle) )"
        ]
      }
    }
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait_until", "condition": "network_stage_live", "timeout_ms": 410000, "stable_ms": 1500 },
    { "at_ms": 11000, "type": "wait_until", "condition": "endscreen_visible", "timeout_ms": 75000, "stable_ms": 1000 },
    { "at_ms": 13000, "type": "action", "name": "ACTION_USE", "action": "tap" },
    { "at_ms": 21000, "type": "exit" }
  ],
  "assertions": {
    "required_lines": ["MATCH: stage end reason=timelimit"],
    "required_counts": [
      { "pattern": "GRID\\.SPAWN\\.ACTIVE: id=base:cyclone mode=0 weaponnum=11$", "min": 2, "max": 2 },
      { "pattern": "NET\\.GRID\\.RESULT: room=1 generation=[1-9][0-9]* epoch=[1-9][0-9]* reason=1 arena=mod:arena_grid_placed_nested_model revision=[0-9a-f]{64} scores=[0-9a-f]{64} rows=2$", "min": 2, "max": 2 }
    ],
    "forbidden_patterns": [
      "GRID\\.SPAWN\\.ACTIVE: id=mod:weapon_grid_triangle",
      "BONDGUN\\.SOURCE: loaded catalog model source .*id=mod:weapon_grid_triangle__",
      "WEAPON\\.GRAPH: custom projectile spawned",
      "NET\\.GRID\\.OFFER: (host|guest) refused",
      "NET\\.GRID\\.TRANSFER: (refused|aborted)",
      "NET\\.GRID\\.RESULT: rejected",
      "GRID\\.MATCH\\.LEASE: deferred (weapon )?retirement",
      "GRID\\.MATCH\\.STAGE: activation refused",
      "NET: SVC_MATCH_MANIFEST hash=",
      "LEVELTOOL\\.DEBUG\\.NEW\\.RESULT result=FAIL",
      "MODAUTHOR\\.[A-Z.]*FAIL",
      "PLAYER\\.INIT\\.ROLLBACK",
      "LOUDFAIL\\.ASSETCHAIN",
      "ASSET\\.FALLBACK",
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout"
    ]
  }
}
