      "BOOT: --connect-host armed: addr='127.0.0.1:27267'",
      "BOOT: --host-autostart armed",
      "BOOT: --match-timelimit-sec armed: seconds=150",
      "BOOT: --launch-mp-room arena='base:arena_mp_complex' scenario='base:hold_the_briefcase' bots=3",
      "BOOT: --listen-bind consumed: port=27267 .*result=OK rc=0",
      "BOOT: --connect-host consumed: addr='127.0.0.1:27267' result=OK rc=0",
      "NET: created server on port 27267",
      "NET: connecting to 127\\.0\\.0\\.1:27267",
      "NET: incoming connection",
