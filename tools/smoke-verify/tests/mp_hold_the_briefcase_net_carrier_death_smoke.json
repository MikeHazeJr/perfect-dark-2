{
  "scenario_name": "mp_hold_the_briefcase_net_carrier_death_smoke",
  "description": "B-1272 / T-NETWORKING-011, networked Hold the Briefcase when the briefcase's carrier dies. A listen host and one client start Hold the Briefcase on Complex with three simulants as mp_hold_the_briefcase_net_smoke does (150 s time limit). Once a simulant has carried the briefcase for 1 s, the host kills it through the production damage path (kill_token_holder, chrDamageByMisc). The dying simulant drops the briefcase (botinvDrop announces it with SVC_PROP_SPAWN), and the briefcase has no MP weapon slot, so before B-1272 the match manifest gave it no session catalog id and the client built the dropped case as WEAPON_UNARMED. Passes when the client replays a simulant's pickup of the dropped case as the briefcase (weapon 79) and shows that simulant as its holder. Each process runs its own schedule; both exit from their results. Written 2026-11-16; port 27267.",
  "tags": [
    "network",
    "combatsim",
    "bots",
    "multiplayer-modes",
    "scenario",
    "b-1272",
    "t-networking-011"
  ],
  "paths_of_interest": [
    "src/game/mplayer/scenarios/holdthebriefcase.inc",
    "src/game/mplayer/scenarios.c",
    "src/game/botinv.c",
    "port/src/net/netmsg.c",
    "port/src/smoke_harness.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 900,
  "install_state": "clean",
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--host",
        "--listen-bind",
        "27267",
        "--launch-mp-room",
        "base:arena_mp_complex",
        "base:hold_the_briefcase",
        "3",
        "--host-autostart",
        "--match-timelimit-sec",
        "150"
      ],
      "wait_for": "NET: created server on port 27267",
      "wait_timeout_seconds": 120,
      "smoke_path": "tools/smoke-verify/fixtures/mp_hold_the_briefcase_net_carrier_death_host.json",
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "SMOKE\\.WAIT: satisfied condition=scenario_token_held",
          "SMOKE\\.KILL_TOKEN_HOLDER: simulant player=[2-4] token=briefcase died=1",
          "BOT\\.DROP: host announced simulant [2-4] weapon=79 syncid=[0-9]+",
          "MANIFEST-HOST: scenario 1 token weapon 79 as '[^']+'"
        ],
        "required_sequences": [
          {
            "name": "dropped-briefcase-announced-and-taken",
            "patterns": [
              "SMOKE\\.WAIT: satisfied condition=scenario_token_held",
              "BOT\\.DROP: host announced simulant [2-4] weapon=79 syncid=[0-9]+",
              "SMOKE\\.KILL_TOKEN_HOLDER: simulant player=[2-4] token=briefcase died=1",
              "BOT\\.PICKUP: host sent simulant [2-4] item [0-9]+ weapon=79 ",
              "HTB: briefcase holder -1 -> [2-4] "
            ]
          }
        ],
        "forbidden_patterns": [
          "SMOKE\\.KILL_TOKEN_HOLDER: no living simulant",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      }
    },
    {
      "name": "client",
      "log_file": "pd-client.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--connect-host",
        "127.0.0.1:27267"
      ],
      "smoke_path": "tools/smoke-verify/fixtures/mp_hold_the_briefcase_net_carrier_death_client.json",
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=79 "
        ],
        "required_sequences": [
          {
            "name": "client-takes-the-dropped-briefcase",
            "patterns": [
              "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=79 ",
              "HTB: client briefcase from host holder=[2-4] present=1",
              "HTB: client briefcase from host holder=-1 present=1",
              "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=79 ",
              "HTB: client briefcase from host holder=[2-4] present=1"
            ]
          }
        ],
        "forbidden_patterns": [
          "BOT\\.PICKUP: client skipped",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      }
    }
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "Each process runs its own schedule (smoke_path); this one only bounds the test."
    },
    {
      "at_ms": 840000,
      "type": "exit"
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=mp_hold_the_briefcase_net_carrier_death_host",
      "SMOKE: scenario=mp_hold_the_briefcase_net_carrier_death_client",
