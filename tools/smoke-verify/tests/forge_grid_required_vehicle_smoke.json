    {
      "src": "dev-mods/maian_hover_vehicle/meshes/vehicle/model.parts.json",
      "dst": "grv-h/recipes/hover/meshes/vehicle/model.parts.json"
    },
    {
      "src": "dev-mods/maian_hover_vehicle/meshes/vehicle/model.faces.json",
      "dst": "grv-h/recipes/hover/meshes/vehicle/model.faces.json"
    },
    {
      "src": "dev-mods/maian_hover_vehicle/meshes/vehicle/model.render.json",
      "dst": "grv-h/recipes/hover/meshes/vehicle/model.render.json"
    },
    {
      "src": "dev-mods/maian_hover_vehicle/behavior/variables.json",
