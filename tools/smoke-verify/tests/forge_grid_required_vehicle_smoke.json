{
  "scenario_name": "forge_grid_required_vehicle_smoke",
  "description": "The host authors one native Grid hoverbike placement and shares the original arena and exact vehicle package with a clean guest. The guest loads the embedded model from the digest-named temporary .pdvehicle. The host mounts through the existing smoke bootstrap, then native accelerate, boost and steering inputs move the authored vehicle. Both peers finish and the guest retires both archives before returning to the same Room.",
  "tags": [
    "modding",
    "forge",
    "network",
    "pdvehicle",
    "gameplay",
    "temporary-content"
  ],
  "paths_of_interest": [
    "tools/smoke-verify/fixtures/mod_author/grid_hover_vehicle/recipe.json",
    "dev-mods/maian_hover_vehicle",
    "port/src/forge_level_io.c",
    "port/src/forge_level_doc.cpp",
    "port/src/scenario_source_runtime.c",
    "port/src/asset_runtime.c",
    "port/src/assetcatalog_scanner.c",
    "src/game/setup.c",
    "src/game/bondbike.c",
    "src/game/vehiclegraph.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 570,
  "install_state": "clean",
  "window_focus_transition": {
    "from_process": "host",
    "to_process": "guest",
    "source_wait_for": "INPUTCTX: focus GAINED",
    "wait_for": "INPUTCTX: focus LOST",
    "timeout_seconds": 15,
    "settle_ms": 500
  },
  "remove_paths": [
    "grv-h",
    "grv-g"
  ],
  "fixtures": [
