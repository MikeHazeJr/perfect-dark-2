{
  "scenario_name": "theme_menu_footer_scale_smoke",
  "description": "T-MENUS-002 stress proof: boot the real edited .pdtheme at 1024x576 with 200% UI scale, drive Agent Select with MKB SDL events, and capture the wrapped live-binding footer wholly inside the themed panel.",
  "tags": ["menus", "input", "glyphs", "layout", "pdtheme", "visual", "T-MENUS-002"],
  "paths_of_interest": [
    "port/include/pdgui_layout.h",
    "port/fast3d/pdgui_layout.cpp",
    "port/fast3d/pdgui_menu_agentselect.cpp",
    "port/fast3d/pdgui_menu_solomission.cpp"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 110,
  "install_state": "prefilled",
  "remove_paths": [
    "mods/example_typed_pdxxx_basic.pdmod",
    "mods/example_typed_pdxxx_basic",
    "mods/installed/example_typed_pdxxx_basic.pdmod",
    "mods/installed/example_typed_pdxxx_basic"
  ],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/theme_archive_source_ui200_pd.ini", "dst": "pd.ini" },
    { "src": "tools/smoke-verify/fixtures/typed_pdxxx_basic_enabled.json", "dst": "mods-enabled.json" }
  ],
  "packed_fixtures": [
    { "src": "examples/modding/typed-pdxxx-basic", "dst": "mods/installed/example_typed_pdxxx_basic.pdmod" }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-net",
    "--portable",
    "--skip-intro"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "Allow catalog/theme/font activation and stressed-scale Agent Select rendering." },
    { "at_ms": 70000, "type": "key", "key": "Down", "action": "tap", "comment": "Real MKB SDL navigation with the dynamic action-map footer visible." },
    { "at_ms": 72000, "type": "key", "key": "Up", "action": "tap", "comment": "Return focus without bypassing menu input authority." },
    { "at_ms": 88000, "type": "exit", "comment": "Exit cleanly after both stressed-scale captures." }
  ],
  "screenshots": [
    { "at_ms": 82000, "name": "tri-theme-footer-ui200" },
    { "at_ms": 85000, "name": "tri-theme-footer-ui200-focus" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=theme_menu_footer_scale_smoke",
      "modmgr: parsed mod\\.json for 'example_typed_pdxxx_basic'.*archive=yes",
      "PDGUI theme loader: applied 'example:tri_theme' from '",
      "SMOKE: screenshot at_ms=82000",
      "SMOKE: screenshot at_ms=85000",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "PDTHEME\\.NESTED\\.REJECT",
      "PDGUI theme loader: lifecycle load failed",
      "PDGUI theme loader: parse failed",
      "PDGUI theme loader: consumer preflight failed",
      "ASSET\\.SOURCE_ONLY",
      "LOUDFAIL\\.FALLBACK",
      "ASSET\\.FALLBACK",
      "RomProvider:filenum"
    ],
    "required_counts": [
      { "pattern": "PDGUI theme loader: applied 'example:tri_theme'", "min": 1, "max": 2 }
    ]
  }
}
