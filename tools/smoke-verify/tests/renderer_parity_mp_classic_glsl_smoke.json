    },
    {
      "src": "parity-mp-b.bmp.diff.bmp"
    },
    {
      "src": "parity-mp-b.bmp.parity.json"
    },
    {
      "src": "parity-mp-c.bmp"
    },
    {
      "src": "parity-mp-c.bmp.bgfx.bmp"
    },
    {
      "src": "parity-mp-c.bmp.diff.bmp"
    },
    {
