{
  "scenario_name": "renderer_parity_mp_classic_glsl_smoke",
  "description": "2.0 renderer parity experiment (Workbench D-041): the same run as renderer_parity_mp_smoke with --debug-bgfx-scene-classic-glsl, which builds the bgfx scene program from the GL path's own GLSL 1.30 text (attribute names and vec4 uniform widths changed for bgfx, the arithmetic character for character). Differences that remain in the scene's surfaces do not come from the shader text. 2.0 renderer phase 2a (D5): renderer parity (see renderer_parity_menu_smoke) in a Combat Simulator match on Felicity with two simulants, one placed in view, first person with the match HUD. Three captures after offline gameplay is ready, on the virtual timeline.",
  "tags": [
    "render",
    "bgfx",
    "parity",
    "visual",
    "multiplayer",
    "smoke",
    "classic-glsl"
  ],
  "paths_of_interest": [
    "port/fast3d/scenario_scene_renderer.cpp",
    "port/fast3d/gfx_bgfx.cpp",
    "port/fast3d/gfx_tee.cpp",
    "port/fast3d/gfx_parity.cpp",
    "port/fast3d/scenario_scene_renderer_bgfx.cpp",
    "port/fast3d/shaders/fs_fast3d.sc"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 420,
  "install_state": "current",
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-force-first-person",
    "--launch-mp-room",
    "base:arena_mp_felicity",
    "base:combat",
    "2",
    "--debug-auto-start-match",
    "--debug-place-bot-near-player",
    "--renderer-parity",
    "--debug-bgfx-scene-classic-glsl"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 330000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900
    },
    {
      "at_ms": 3000,
      "type": "screenshot",
      "path": "parity-mp-a.bmp"
    },
    {
      "at_ms": 6000,
      "type": "screenshot",
      "path": "parity-mp-b.bmp"
    },
    {
      "at_ms": 9000,
      "type": "screenshot",
      "path": "parity-mp-c.bmp"
    },
    {
      "at_ms": 11000,
