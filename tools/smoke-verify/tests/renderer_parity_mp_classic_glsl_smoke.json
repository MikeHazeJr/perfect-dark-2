  "assertions": {
    "required_lines": [
      "SMOKE: scenario=renderer_parity_mp_classic_glsl_smoke",
      "bgfx: renderer parity mode",
      "SCENARIO\\.RENDER: --debug-bgfx-scene-classic-glsl: bgfx scene program from the GL path's GLSL text",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready ",
      "SMOKE\\.GLSHOT: captured .*parity-mp-a\\.bmp",
      "PARITY: .*parity-mp-a\\.bmp size=\\d+x\\d+ differing=",
      "PARITY: .*parity-mp-b\\.bmp size=\\d+x\\d+ differing=",
      "PARITY: .*parity-mp-c\\.bmp size=\\d+x\\d+ differing=",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "bgfx: fatal",
      "SMOKE: result=timeout",
      "PARITY: .* size mismatch",
      "PARITY: could not write",
