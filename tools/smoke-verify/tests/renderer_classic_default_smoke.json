{
  "scenario_name": "renderer_classic_default_smoke",
  "description": "2.0 renderer phase 2a (D5): with no renderer flag the client runs the classic GL renderer exactly as before: gfx_init keeps gfx_opengl_api, bgfx is never initialised, and no bgfx code path logs anything. Boots to Agent Select and captures it twice. The wait is core_boot_ready plus time, not agent_select_ready: that condition needs keyboard focus, which a runner in the background does not get.",
  "tags": ["render", "classic", "menu", "smoke"],
  "paths_of_interest": [
    "port/src/video.c",
    "port/fast3d/gfx_pc.cpp",
    "port/fast3d/gfx_bgfx.cpp",
    "port/fast3d/pdgui_render_backend.cpp"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 420,
  "install_state": "current",
  "remove_paths": ["classic-home"],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/agent_smoke.json", "dst": "classic-home/agent_smoke.json" }
  ],
  "boot_args": ["--no-update-check", "--no-sound", "--no-net", "--portable", "--savedir", "./classic-home",
                "--main-menu"],
  "input_sequence": [
    { "at_ms": 0, "type": "wait_until", "condition": "core_boot_ready", "timeout_ms": 300000 },
    { "at_ms": 45000, "type": "screenshot", "path": "classic-agent-select.bmp",
      "comment": "Agent Select is up about 20 s after boot completes (the menu background stage loads first)." },
    { "at_ms": 52000, "type": "screenshot", "path": "classic-agent-select-later.bmp" },
    { "at_ms": 55000, "type": "exit" }
  ],
  "retain_artifacts": [
    { "src": "classic-agent-select.bmp" },
    { "src": "classic-agent-select-later.bmp" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=renderer_classic_default_smoke",
      "MENUPOOL: acquired agent_select",
      "SMOKE\\.GLSHOT: captured .*classic-agent-select\\.bmp",
      "SMOKE\\.GLSHOT: captured .*classic-agent-select-later\\.bmp",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "bgfx: ",
      "PARITY: "
    ],
    "required_counts": []
  }
}
