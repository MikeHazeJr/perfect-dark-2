    { "src": "cp-bot-charge-mid.bmp" },
    { "src": "cp-bot-charge-late.bmp" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=crystal_pistol_bot_charge_smoke",
      "LOADER\\.POOL\\.WEAPON\\.PUBLIC_ADAPTER: installed id=mod_crystal_pistol:crystal_pistol runtime=\\d+ model=\\d+ funcs=2",
      "BONDGUN\\.BOT: fired weapon=\\d+ func=0 bot=\\d+",
      "BONDGUN\\.MODEL3P: chrnum=\\d+ mpindex=[1-9]\\d* weapon=\\d+ loaded=[0-5]/6",
      "BONDGUN\\.CHARGE: start weapon=\\d+ bot=\\d+ func=1 count=6 release_in=90",
      "BONDGUN\\.CHARGE: released weapon=\\d+ bot=\\d+ count=6 launched=6",
      "BONDGUN\\.CRYSTAL: mine armed weapon=\\d+ func=1 owner=\\d+",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.FALLBACK",
      "result=FAIL",
      "BONDGUN\\.MODEL: .*B-1185",
      "skipped=no_owner",
      "BONDGUN\\.BOT: fired weapon=\\d+ func=1",
      "'mod_crystal_pistol:crystal_pistol' public weapon adapter install failed",
      "'mod_crystal_pistol:crystal_pistol' activation failed"
    ],
    "required_counts": [
      {
        "pattern": "SMOKE\\.GLSHOT: captured",
        "min": 3
      }
    ]
  }
}
