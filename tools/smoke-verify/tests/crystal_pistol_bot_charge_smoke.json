      "src": "dev-mods/crystal_pistol",
      "dst": "mods/installed/crystal_pistol.pdmod"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-spawn-at",
    "780,-663,27,27",
    "--debug-force-first-person",
    "--debug-force-first-person-look",
    "0.8174,0,-0.5760",
    "--launch-mp-room",
    "base:arena_mp_felicity",
    "base:combat",
    "1",
    "--debug-spawn-weapon",
    "mod_crystal_pistol:crystal_pistol",
    "--debug-place-bot-near-player",
    "--debug-place-bot-near-player-hold-sec",
    "1",
    "--debug-auto-start-match"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 240000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900,
      "comment": "Wait for first-person Combat Simulator gameplay. The player then stands still; the bot finds it and fights."
    },
    { "at_ms": 3000, "type": "screenshot", "path": "cp-bot-charge-early.bmp", "comment": "The bot in front, firing." },
    { "at_ms": 20000, "type": "screenshot", "path": "cp-bot-charge-mid.bmp" },
    { "at_ms": 60000, "type": "screenshot", "path": "cp-bot-charge-late.bmp" },
    { "at_ms": 62000, "type": "exit", "comment": "A minute of play: long enough for the bot to reach mid range with a full magazine at least once." }
  ],
  "retain_artifacts": [
