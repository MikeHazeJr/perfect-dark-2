{
  "scenario_name": "crystal_pistol_bot_charge_smoke",
  "description": "Crystal pistol (T-MODDING-008) in a simulant's hands. The spawn weapon arms the bot too; public weapons now carry default bot preferences, so the bot keeps the gun instead of going unarmed. It fires primary crystals and, with a full magazine and its target 450..1500 units away, takes the committed charge: every loaded crystal commits, then launches as a vertical fan of proximity mines at the target. The next charge waits for a primary magazine. The player stands still at a fixed spawn and look as the target; the bot starts 240 units in front (held 1 s), so its gun is in view while it fires and BONDGUN.MODEL3P shows the third-person gun losing spent crystals.",
  "tags": [
    "modding",
    "pdxxx",
    "weapon",
    "charge",
    "bots",
    "crystal_pistol",
    "smoke"
  ],
  "paths_of_interest": [
    "dev-mods/crystal_pistol/crystal_pistol.pdweapon",
    "port/src/loader_pool.c",
    "src/game/bondgun_mod.c",
    "src/game/botinv.c",
    "src/game/botact.c",
    "src/game/chraction.c"
  ],
  "log_channel_mask": "game,catalog,render,match,mods,system",
  "verbose": 0,
  "timeout_seconds": 360,
  "install_state": "current",
  "remove_paths": [
    "mods/crystal_pistol.pdmod",
    "mods/crystal_pistol",
    "mods/installed/crystal_pistol.pdmod",
    "mods/installed/crystal_pistol"
  ],
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/needler_visual_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/crystal_pistol_enabled.json",
      "dst": "mods-enabled.json"
