{
  "scenario_name": "mp_hacker_central_local_smoke",
  "description": "Offline Hacker Central on Complex: one human plus three simulants, started through the direct debug match path and ended by a 150 second time limit. Proves the match-start contract for an objective scenario: the launch seed derives the runtime mode from the scenario catalog id, mpStartMatch initializes the scenario, the terminal and the data uplink are placed on real pads (B-1125: an arena without enough Capture the Case pads or ammo crates gets walkable pads added to the bank instead of dividing by zero), the stage loads, the player spawns, the time limit ends the match, and the result witness lists every participant. It does not yet assert an objective scoring event; that needs the per-scenario objective witness. Local scoring (T-NETWORKING-011): a 150 second match gives the simulants time to score, and the result must show at least one nonzero score; MATCH.POINTS lines show who scored and when.",
  "tags": [
    "combatsim",
    "match-start",
    "scenario",
    "multiplayer-modes",
    "scoring"
  ],
  "paths_of_interest": [
    "port/src/net/matchsetup.c",
    "port/src/main.c",
    "src/game/mplayer/mplayer.c",
    "src/game/mplayer/scenarios.c",
    "src/game/lv.c",
    "src/game/mplayer/scenarios/hackthatmac.inc",
    "port/src/scenario_pad_fallback.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 420,
  "install_state": "clean",
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--launch-mp-room",
    "base:arena_mp_complex",
    "base:hacker_central",
    "3",
    "--debug-auto-start-match",
    "--match-timelimit-sec",
    "150"
  ],
  "input_sequence": [
