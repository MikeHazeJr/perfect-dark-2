      "type": "action",
      "name": "ACTION_SKIP_CUTSCENE",
      "action": "press"
    },
    {
      "at_ms": 46000,
      "type": "action",
      "name": "ACTION_SKIP_CUTSCENE",
      "action": "release"
    },
    {
      "at_ms": 55000,
      "type": "action",
      "name": "ACTION_SKIP_CUTSCENE",
      "action": "press"
    },
    {
      "at_ms": 56000,
      "type": "action",
      "name": "ACTION_SKIP_CUTSCENE",
      "action": "release"
    },
    {
      "at_ms": 65000,
      "type": "action",
      "name": "ACTION_SKIP_CUTSCENE",
      "action": "press"
    },
    {
      "at_ms": 66000,
      "type": "action",
      "name": "ACTION_SKIP_CUTSCENE",
      "action": "release"
    },
    {
      "at_ms": 75000,
      "type": "action",
