      "action": "release"
    },
    {
      "at_ms": 310000,
      "type": "exit",
      "comment": "Bounded exit after stage load, a 150 second match and the end screen."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=mp_hacker_central_local_smoke",
      "BOOT: --launch-mp-room arena='base:arena_mp_complex' scenario='base:hacker_central' bots=3",
      "MATCH\\.SCENARIO\\.RULES: reason=launch-mp-room id='base:hacker_central' mode=2 team_based=0 teams_enabled_here=0",
      "BOOT: --debug-auto-start-match consumed",
      "MATCHSTART\\.DIAG: preflight stage_id='base:arena_mp_complex' scenario_id='base:hacker_central' slots=4",
      "PLAYER\\.INIT\\.PREFLIGHT match=ok players=1 bots=3 stage='base:arena_mp_complex' scenario='base:hacker_central'",
      "PLAYER\\.INIT\\.COMMIT match players=1 bots=3",
      "MATCH: options=0x[0-9a-f]{8} onehitkills=0 slowmo=0 scenario=2 ",
      "HTM: terminal 0 placed pad=[1-9][0-9]* prop=ok",
      "HTM: uplink placed pad=[1-9][0-9]* source=(crate|bank) prop=ok",
      "MATCH: player spawned slot=",
      "MATCH: timelimit override applied seconds=150",
      "MATCH: stage end reason=timelimit",
      "MATCH\\.RESULT: scenario=2 teams=0 chrs=4 netmode=0",
      "MODE\\.EVENT: chosen mode=base:hacker_central scenario=2",
      "MODE\\.EVENT: tick mode=base:hacker_central scenario=2 who=-",
      "MODE\\.EVENTS: stage_end mode=base:hacker_central .*tick=[1-9][0-9]* .*spawn=[1-9][0-9]*",
      "MATCH: endscreen shown",
      "SMOKE: result=scripted_exit",
      "MATCH\\.RESULT\\.(CHR|TEAM): .*score=[1-9]"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "PLAYER\\.INIT\\.ROLLBACK",
      "PLAYER\\.INIT\\.PREFLIGHT match=reject",
      "SCENARIO\\.MISS:",
      "HTM: no pad for terminal",
      "HTM: bank holds",
      "HTM: uplink placed pad=0 ",
      "SCENARIO: object model="
    ],
    "required_counts": [
      {
        "pattern": "MATCH\\.RESULT\\.CHR: rank=",
        "min": 4,
        "max": 4
      },
      {
        "pattern": "MATCH\\.RESULT: scenario=",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "MATCH: endscreen shown",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "HTM: terminal 0 placed pad=",
        "min": 1,
        "max": 1
      }
    ]
  }
