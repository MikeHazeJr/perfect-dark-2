{
  "scenario_name": "all_family_source_gate_smoke",
  "description": "c3844 runtime smoke: load every current top-level non-Scenario base typed archive family with that family source-only gate enabled for the individual load.",
  "tags": ["modding", "pdxxx", "source-gate", "c3844", "smoke", "pillar:modding"],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/asset_source_debug.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/fixtures/all_family_source_pd.ini"
  ],
  "log_channel_mask": "audio,render,game,system",
  "verbose": 0,
  "timeout_seconds": 180,
  "install_state": "clean",
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/all_family_source_pd.ini", "dst": "pd.ini" }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-load-catalog-assets-source-only",
    "--debug-exit-after-catalog-probes",
    "--debug-load-catalog-assets",
    "weapon=base:dy357,character=base:character_a51airman,head=base:head_a51faceplate,body=base:a51airman,arena=base:arena_airbase,mission=base:mission_airbase,model=base:model_ar34_hi,animation=base:animation_big_sneeze,texture=base:texture_unlabeled_a,material=base:material_default,skin=base:skin_a51airman_default,effect=base:effect_darken,prop=base:prop_chr,vehicle=base:vehicle_hoverbike,audio=base:sfx_alarm_2,voice=base:voice_cover_me_aiw,song=base:song_sequence_a,ui=base:ui_bg_alt,font=base:font_handelgothicsm,lang=base:lang_ame_en,gamemode=base:capture_the_case,botprofile=base:bot_coward,hud=base:hud_ammo,theme=base:theme_blackgold"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "catalog bootstrap extracts and walks base typed archives before source-only typed-load requests fire." },
    { "at_ms": 90000, "type": "exit", "comment": "exit after cold catalog extraction plus all requested typed assets have loaded or emitted source-only failures." }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=all_family_source_gate_smoke",
      "BOOT: --debug-load-catalog-assets request type=weapon id='base:dy357' source_only=1",
      "BOOT: --debug-load-catalog-assets result type=weapon id='base:dy357' result=OK",
      "BOOT: --debug-load-catalog-assets result type=character id='base:character_a51airman' result=OK",
      "BOOT: --debug-load-catalog-assets result type=head id='base:head_a51faceplate' result=OK",
      "BOOT: --debug-load-catalog-assets result type=body id='base:a51airman' result=OK",
      "BOOT: --debug-load-catalog-assets result type=arena id='base:arena_airbase' result=OK",
      "BOOT: --debug-load-catalog-assets result type=mission id='base:mission_airbase' result=OK",
      "BOOT: --debug-load-catalog-assets result type=model id='base:model_ar34_hi' result=OK",
      "BOOT: --debug-load-catalog-assets result type=animation id='base:animation_big_sneeze' result=OK",
      "BOOT: --debug-load-catalog-assets result type=texture id='base:texture_unlabeled_a' result=OK",
      "BOOT: --debug-load-catalog-assets result type=material id='base:material_default' result=OK",
      "BOOT: --debug-load-catalog-assets result type=skin id='base:skin_a51airman_default' result=OK",
      "BOOT: --debug-load-catalog-assets result type=effect id='base:effect_darken' result=OK",
      "BOOT: --debug-load-catalog-assets result type=prop id='base:prop_chr' result=OK",
      "BOOT: --debug-load-catalog-assets result type=vehicle id='base:vehicle_hoverbike' result=OK",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:sfx_alarm_2' result=OK",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:voice_cover_me_aiw' result=OK",
      "BOOT: --debug-load-catalog-assets result type=audio id='base:song_sequence_a' result=OK",
      "BOOT: --debug-load-catalog-assets result type=ui id='base:ui_bg_alt' result=OK",
      "BOOT: --debug-load-catalog-assets result type=font id='base:font_handelgothicsm' result=OK",
      "BOOT: --debug-load-catalog-assets result type=lang id='base:lang_ame_en' result=OK",
      "BOOT: --debug-load-catalog-assets result type=gamemode id='base:capture_the_case' result=OK",
      "BOOT: --debug-load-catalog-assets result type=botprofile id='base:bot_coward' result=OK",
      "BOOT: --debug-load-catalog-assets result type=hud id='base:hud_ammo' result=OK",
      "BOOT: --debug-load-catalog-assets result type=theme id='base:theme_blackgold' result=OK",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "has no public FileProvider source",
      "result=FAIL",
      "result=MISSING",
      "RomProvider:filenum"
    ],
    "required_counts": [
      { "pattern": "BOOT: --debug-load-catalog-assets result type=.* result=OK", "min": 24, "max": 24 }
    ]
  }
}
