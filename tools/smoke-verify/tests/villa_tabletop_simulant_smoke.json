{
  "scenario_name": "villa_tabletop_simulant_smoke",
  "description": "A NormalSim uses Bot Jump and ordinary Hold orders to land on Villa's room 17 coffee table, stay on the same live prop, then walk off to the room floor. The fixture places the bot once and tracks its live identity and the table's dynamic collision.",
  "tags": ["combatsim", "movement", "jump", "collision", "simulants", "tabletop"],
  "paths_of_interest": ["port/src/smoke_harness.c", "src/game/bot.c", "src/game/chr.c", "src/lib/capsule.c", "src/lib/meshcollision.c"],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 360,
  "install_state": "current",
  "boot_args": [
    "--no-update-check", "--no-sound", "--no-net", "--portable",
    "--launch-mp-room", "base:arena_villa", "base:combat", "1",
    "--debug-auto-start-match", "--debug-mp-options", "0x10000000"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait_until", "condition": "offline_gameplay_ready", "timeout_ms": 330000, "stable_ms": 1000, "assist_action": "ACTION_SKIP_CUTSCENE", "assist_condition": "cutscene_skip_ready", "assist_hold_ms": 1200 },
    { "at_ms": 100, "type": "movement_tabletop", "name": "place_simulant" },
    { "at_ms": 5500, "type": "movement_tabletop", "name": "walk_off" },
    { "at_ms": 9500, "type": "movement_tabletop", "name": "verify" },
    { "at_ms": 9600, "type": "exit" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=villa_tabletop_simulant_smoke",
      "BOOT: --launch-mp-room direct match start",
      "BOOT: --debug-mp-options applied -- user=0x10000000",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready"
    ],
    "required_sequences": [
      {
        "name": "simulant-coffee-table-landing-and-walk-off",
        "patterns": [
          "SMOKE\\.TABLETOP: phase=table_measured pos=",
          "SMOKE\\.TABLETOP: phase=table_bound command=492 model=base:model_cv_coffee_table pad=428 room=17 collision=dynamic_mesh",
          "SMOKE\\.TABLETOP: phase=place actor=simulant .* room=17 feet=-?[0-9]+\\.",
          "BOT\\.JUMP: chrnum=[0-9]+ reason=OBST",
          "SMOKE\\.TABLETOP: phase=takeoff",
          "SMOKE\\.TABLETOP: phase=land .* room=17 feet=-?[0-9]+\\..* support=table",
          "SMOKE\\.TABLETOP: phase=stay .* room=17 feet=-?[0-9]+\\..* support=table",
          "SMOKE\\.TABLETOP: phase=drop",
          "SMOKE\\.TABLETOP: phase=lower_land .* room=17 feet=-?[0-9]+\\.",
          "SMOKE\\.TABLETOP: result=pass actor=simulant",
          "SMOKE: result=scripted_exit"
        ]
      }
    ],
    "required_counts": [{ "pattern": "SMOKE\\.TABLETOP: phase=place", "min": 1, "max": 1 }],
    "forbidden_patterns": [
      "SMOKE\\.TABLETOP: result=fail", "SMOKE: result=movement_ledge_failed",
      "SMOKE\\.WAIT: timeout", "EXCEPTION_ACCESS_VIOLATION", "FATAL: "
    ]
  }
}
