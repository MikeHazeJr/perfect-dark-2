{
  "scenario_name": "needler_mod_manager_lifecycle_smoke",
  "description": "V-009 production Mod Manager lifecycle smoke: install and activate the public Needler .pdmod, disable it through the real checkbox and Apply modal, then re-enable and apply again in the same ordinary client process.",
  "tags": ["modding", "pdmod", "pdxxx", "weapon", "effect", "lifecycle", "mod-manager", "mouse", "v009", "smoke", "pillar:modding"],
  "paths_of_interest": [
    "dev-mods/needler",
    "port/src/main.c",
    "port/src/pdmain.c",
    "port/src/smoke_harness.c",
    "port/fast3d/pdgui_modding_hub.cpp",
    "port/src/modmgr.c",
    "port/src/assetcatalog_load.c",
    "tools/smoke-verify/fixtures/needler_lifecycle_pd.ini",
    "tools/smoke-verify/fixtures/needler_enabled.json"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 130,
  "install_state": "clean",
  "remove_paths": [
    "mods/needler.pdmod",
    "mods/needler",
    "mods/installed/needler.pdmod",
    "mods/installed/needler"
  ],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/needler_lifecycle_pd.ini", "dst": "pd.ini" },
    { "src": "tools/smoke-verify/fixtures/needler_enabled.json", "dst": "mods-enabled.json" }
  ],
  "packed_fixtures": [
    { "src": "dev-mods/needler", "dst": "mods/installed/needler.pdmod" }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--skip-intro",
    "--debug-load-catalog-assets",
    "weapon=mod_needler:needler",
    "--launch-modding-hub"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "Cold extraction, public Needler registration and one real typed activation complete before the production Mod Manager opens." },
    { "at_ms": 68000, "type": "wait", "comment": "The deferred launcher has opened tool 0 after the ordinary menu is active." },
    { "at_ms": 70000, "type": "mouse_move", "x": 210, "y": 338 },
    { "at_ms": 70500, "type": "mouse", "x": 210, "y": 338, "button": "left", "action": "click", "comment": "Disable Needler through the real installed-mod checkbox." },
    { "at_ms": 73500, "type": "mouse_move", "x": 465, "y": 548 },
    { "at_ms": 74000, "type": "mouse", "x": 465, "y": 548, "button": "left", "action": "click", "comment": "Apply the disable through production modmgrApplyChanges." },
    { "at_ms": 81000, "type": "mouse_move", "x": 640, "y": 365 },
    { "at_ms": 81500, "type": "mouse", "x": 640, "y": 365, "button": "left", "action": "click", "comment": "Dismiss the production Apply complete modal." },
    { "at_ms": 85000, "type": "mouse_move", "x": 210, "y": 338 },
    { "at_ms": 85500, "type": "mouse", "x": 210, "y": 338, "button": "left", "action": "click", "comment": "Re-enable Needler through the same live Mod Manager row." },
    { "at_ms": 88500, "type": "mouse_move", "x": 465, "y": 548 },
    { "at_ms": 89000, "type": "mouse", "x": 465, "y": 548, "button": "left", "action": "click", "comment": "Apply the re-enable in the same process." },
    { "at_ms": 96000, "type": "mouse_move", "x": 640, "y": 365 },
    { "at_ms": 96500, "type": "mouse", "x": 640, "y": 365, "button": "left", "action": "click", "comment": "Dismiss the second production Apply complete modal." },
    { "at_ms": 110000, "type": "exit", "comment": "Exit after the re-enabled catalog rescan and final UI capture." }
  ],
  "screenshots": [
    { "at_ms": 68000, "name": "needler-enabled-before-disable" },
    { "at_ms": 72000, "name": "needler-disabled-pending-apply" },
    { "at_ms": 79000, "name": "needler-disable-apply-complete" },
    { "at_ms": 87000, "name": "needler-enabled-pending-apply" },
    { "at_ms": 94000, "name": "needler-enable-apply-complete" },
    { "at_ms": 104000, "name": "needler-enabled-final" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=needler_mod_manager_lifecycle_smoke",
      "BOOT: --debug-load-catalog-assets request type=weapon id='mod_needler:needler' source_only=0",
      "BOOT: --debug-load-catalog-assets result type=weapon id='mod_needler:needler' result=OK",
      "BOOT: --launch-modding-hub consumed -> production Mod Manager tool 0",
      "MODHUB: opened on tool 0",
      "modmgr: apply complete -- no stage restart",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "LOUDFAIL\\.FALLBACK",
      "ASSET\\.FALLBACK",
      "RomProvider:filenum",
      "result=FAIL",
      "result=MISSING"
    ],
    "required_counts": [
      { "pattern": "modmgr: applying changes", "min": 2, "max": 2 },
      { "pattern": "modmgr: apply complete -- no stage restart", "min": 2, "max": 2 },
      { "pattern": "SMOKE: mouse tap-press btn=1 xy=\\(210,338\\)", "min": 2, "max": 2 },
      { "pattern": "SMOKE: mouse tap-press btn=1 xy=\\(465,548\\)", "min": 2, "max": 2 },
      { "pattern": "SMOKE: mouse tap-press btn=1 xy=\\(640,365\\)", "min": 2, "max": 2 }
    ]
  }
}
