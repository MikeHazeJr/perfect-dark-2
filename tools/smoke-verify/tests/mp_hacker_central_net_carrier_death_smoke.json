{
  "scenario_name": "mp_hacker_central_net_carrier_death_smoke",
  "description": "B-1209 / T-NETWORKING-011, networked Hacker Central when the uplink's carrier dies. A listen host and one client start Hacker Central on Complex with three simulants as mp_hacker_central_net_smoke does (150 s time limit). Once a simulant has carried the uplink for 1 s, the host kills it through the production damage path (kill_token_holder, chrDamageByMisc). The original drops no uplink at a carrier's death: htmTick makes a new one at a crate, and the host must announce it (scenarioNetAnnounceProp, SVC_PROP_SPAWN then SVC_PROP_MOVE), or a client never sees it and skips every pickup of it (B-1209). Passes when the client replays a simulant's pickup of the new uplink and shows that simulant as its holder, with no skipped pickup. Each process runs its own schedule; both exit from their results. Written 2026-11-16; port 27259.",
  "tags": [
    "network",
    "combatsim",
    "bots",
    "multiplayer-modes",
    "scenario",
    "b-1209",
    "t-networking-011"
  ],
  "paths_of_interest": [
    "src/game/mplayer/scenarios/hackthatmac.inc",
    "src/game/mplayer/scenarios.c",
    "port/src/net/netmsg.c",
    "port/src/smoke_harness.c",
    "src/game/bot.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 900,
  "install_state": "clean",
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--host",
        "--listen-bind",
        "27259",
        "--launch-mp-room",
        "base:arena_mp_complex",
        "base:hacker_central",
        "3",
        "--host-autostart",
        "--match-timelimit-sec",
        "150"
      ],
      "wait_for": "NET: created server on port 27259",
      "wait_timeout_seconds": 120,
      "smoke_path": "tools/smoke-verify/fixtures/mp_hacker_central_net_carrier_death_host.json",
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "SMOKE\\.WAIT: satisfied condition=scenario_token_held",
          "SMOKE\\.KILL_TOKEN_HOLDER: simulant player=[2-4] token=uplink died=1",
          "SCENARIO\\.NET: host announced the new uplink syncid=[0-9]+ pos=\\([^)]*\\) rc=0"
        ],
        "required_sequences": [
          {
            "name": "replacement-uplink-announced-and-taken",
            "patterns": [
              "SMOKE\\.WAIT: satisfied condition=scenario_token_held",
              "SMOKE\\.KILL_TOKEN_HOLDER: simulant player=[2-4] token=uplink died=1",
              "HTM: uplink placed pad=[1-9][0-9]* source=(crate|bank) prop=ok",
              "SCENARIO\\.NET: host announced the new uplink syncid=[0-9]+ pos=\\([^)]*\\) rc=0",
              "BOT\\.PICKUP: host sent simulant [2-4] item [0-9]+ weapon=46 ",
              "HTM: uplink holder -1 -> [2-4] "
            ]
          }
        ],
        "forbidden_patterns": [
          "SMOKE\\.KILL_TOKEN_HOLDER: no living simulant",
          "SCENARIO\\.NET: host announced the new uplink .* rc=[1-9]",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      }
    },
    {
      "name": "client",
      "log_file": "pd-client.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--connect-host",
        "127.0.0.1:27259"
      ],
      "smoke_path": "tools/smoke-verify/fixtures/mp_hacker_central_net_carrier_death_client.json",
      "assertions": {
        "required_lines": [
          "SMOKE\\.WAIT: satisfied condition=network_stage_live",
          "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=46 "
        ],
        "required_sequences": [
          {
            "name": "client-takes-the-replacement-uplink",
            "patterns": [
              "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=46 ",
              "HTM: client uplink from host holder=[2-4] present=1",
              "HTM: client uplink from host holder=-1 present=1",
              "BOT\\.PICKUP: client replayed simulant [2-4] item [0-9]+ weapon=46 ",
              "HTM: client uplink from host holder=[2-4] present=1"
            ]
          }
        ],
        "forbidden_patterns": [
          "BOT\\.PICKUP: client skipped",
          "SMOKE\\.WAIT: (timeout|pending_tap)"
        ]
      }
    }
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "Each process runs its own schedule (smoke_path); this one only bounds the test."
    },
    {
