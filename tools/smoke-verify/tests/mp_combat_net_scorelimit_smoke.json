{
  "scenario_name": "mp_combat_net_scorelimit_smoke",
  "description": "T-NETWORKING-011: networked Combat ended by the score limit. Listen host plus one client on loopback, Felicity, three simulants, port 27266, --match-scorelimit 1 on the host (a real setup value that travels in the start message) and a 240 second time limit as a backstop. The first kill ends the match on the host by the score limit (the stage end line names it, no time-limit end is logged), the client follows on SVC_STAGE_END, and both sides log a result with all five characters and a leader with a nonzero score. Same start path as mp_combat_net_bots_smoke. B-1305: --debug-mp-options 0x10200001 (the default Bot Jumping and Spawn With Weapon plus One-Hit Kills) makes the first hit the first kill, so the score-limit end does not wait on a kill by chance: a full 240 s match with every simulant shielded had none.",
  "tags": [
    "network",
    "combatsim",
    "bots",
    "match-lifecycle",
    "multiplayer-modes",
    "scoring"
  ],
  "paths_of_interest": [
    "src/game/bot.c",
    "port/src/net/net.c",
    "port/src/net/netmsg.c",
    "src/game/mplayer/mplayer.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 560,
  "install_state": "clean",
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--host",
        "--listen-bind",
        "27266",
        "--launch-mp-room",
        "base:arena_mp_felicity",
        "base:combat",
        "3",
        "--host-autostart",
        "--match-timelimit-sec",
        "240",
        "--match-scorelimit",
        "1",
        "--debug-mp-options",
        "0x10200001"
      ],
      "wait_for": "NET: created server on port 27266",
      "wait_timeout_seconds": 120
    },
    {
      "name": "client",
      "log_file": "pd-client.log",
      "boot_args": [
        "--portable",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--connect-host",
        "127.0.0.1:27266"
      ]
    }
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait",
      "comment": "Both processes share this schedule. The host arms --listen-bind and fires netStartServer on the first mainTick where g_NetInit is true (-> 'NET: created server on port 27200', the runner's barrier), seeds g_MatchConfig from --launch-mp-room, and arms --host-autostart. The client arms --connect-host and connects after the barrier. Once the client reaches CLSTATE_LOBBY on the host (slot 1) and a ~2s settle elapses, --host-autostart fires netLobbyRequestStartWithSims exactly once; the ready gate runs a 3s countdown (client answers manifest READY), then SVC_STAGE_START loads the arena on both sides. The match ends at the forced 35s time limit."
    },
    {
      "at_ms": 480000,
      "type": "exit",
      "comment": "Scripted clean exit at 480 s: the D: boot (about 200 s to the host's autostart), the countdown and load, a match of at most 240 s (the score limit ends it at the first kill) and the end screen."
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=mp_combat_net_scorelimit_smoke",
      "BOOT: --listen-bind armed: port=27266",
      "BOOT: --connect-host armed: addr='127.0.0.1:27266'",
      "BOOT: --host-autostart armed",
      "BOOT: --debug-mp-options applied -- user=0x10200001",
      "MATCH: options=0x10200001 onehitkills=1 slowmo=0 scenario=0 ",
      "BOOT: --match-timelimit-sec armed: seconds=240",
      "BOOT: --launch-mp-room arena='base:arena_mp_felicity' scenario='base:combat' bots=3",
      "BOOT: --listen-bind consumed: port=27266 .*result=OK rc=0",
      "BOOT: --connect-host consumed: addr='127.0.0.1:27266' result=OK rc=0",
      "NET: created server on port 27266",
      "NET: connecting to 127\\.0\\.0\\.1:27266",
      "NET: incoming connection",
      "NET: connected to server, sending CLC_AUTH",
      "NET: client slot \\d+ assigned to peer",
      "BOOT: --host-autostart firing",
      "BOOT: --host-autostart consumed: result=OK rc=0",
      "MANIFEST-SP: load 'base:arena_mp_felicity'",
      "MATCH: server stage start",
      "MATCH: client stage start received",
      "MATCH: player spawned slot=0",
      "MATCH: player spawned slot=1",
      "MATCH: scores replicated",
      "MATCH: stage end reason=scorelimit scorelimit=1 teamscorelimit=0",
      "MATCH: endscreen shown",
      "PARTICIPANTS: 5 active \\(2 players, 3 bots\\)",
      "MATCH\\.RESULT: scenario=0 teams=0 chrs=5 netmode=1",
      "MATCH\\.RESULT: scenario=0 teams=0 chrs=5 netmode=2",
      "MATCH: final scores published before stage end room=",
      "BOOT: --match-scorelimit applied: score=1",
      "MATCH\\.RESULT\\.CHR: rank=0 chr=[0-9]+ team=[0-9]+ score=[1-9]"
    ],
    "forbidden_patterns": [
      "BOOT: --no-net set; netInit\\(\\) skipped",
      "NET: could not init ENet, disabling networking",
      "NET: could not create ENet host on port \\d+",
      "NET: could not connect to ",
      "NET: connection rejected: protocol mismatch",
      "BOOT: --listen-bind cannot fire:",
      "BOOT: --connect-host cannot fire:",
      "BOOT: --listen-bind consumed: port=27266 .*result=FAILED",
      "BOOT: --connect-host consumed: addr='127\\.0\\.0\\.1:27266' result=FAILED",
      "BOOT: --host-autostart consumed: result=FAILED",
      "MATCHSETUP: cannot resolve stage ",
      "MATCHSETUP: no players configured",
      "MATCHSTART\\.DIAG: BAILED",
      "MATCHSTART\\.DIAG: abort reason=",
      "CATALOG\\.LIFECYCLE\\.LOAD: .*type mismatch",
      "MANIFEST-SP: load failed 'base:arena_mp_felicity'",
      "MANIFEST\\.LIFECYCLE\\.(REJECT|ROLLBACK)",
      "MANIFEST-(SP|MP): .*rejected; current manifest preserved",
      "SPAWN.ORCH: no pool slot",
      "SPAWN.ORCH:.*unresolved duplicate",
      "SPAWN: could not resolve room",
      "MENU: watchdog",
      "MENUPOOL legacy-stack leak",
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.LOAD: .*unrecoverable",
      "BOT\\.PICKUP: client skipped",
      "NET: malformed or unknown message 0x4[dD]",
      "MATCH: stage end reason=timelimit",
      "BOOT: --match-scorelimit expects"
    ],
    "required_counts": [
      {
        "pattern": "NET: created server on port 27266",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "NET: incoming connection",
        "min": 1
      },
      {
        "pattern": "NET: connected to server, sending CLC_AUTH",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "MANIFEST-SP: load 'base:arena_mp_felicity'",
        "min": 2
      },
      {
        "pattern": "MATCH: player spawned slot=\\d+",
        "min": 2
      },
      {
        "pattern": "MATCH: server stage start",
        "min": 1
      },
      {
        "pattern": "SMOKE: result=scripted_exit",
        "min": 1
      },
      {
        "pattern": "PARTICIPANTS: 5 active \\(2 players, 3 bots\\)",
        "min": 2
      },
      {
        "pattern": "MATCH\\.RESULT: scenario=0 teams=0 chrs=5 netmode=",
        "min": 2,
        "max": 2
      },
      {
        "pattern": "MATCH\\.RESULT\\.CHR: rank=",
        "min": 10,
        "max": 10
      },
      {
        "pattern": "BOT\\.PICKUP: host sent simulant",
        "min": 0
      },
      {
        "pattern": "BOT\\.PICKUP: client replayed simulant",
        "min": 0
      },
      {
