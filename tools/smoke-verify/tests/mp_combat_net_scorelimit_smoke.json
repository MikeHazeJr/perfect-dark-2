        "min": 0
      },
      {
        "pattern": "MATCH: stage end reason=",
        "min": 1,
        "max": 1
      },
      {
        "pattern": "MATCH\\.RESULT\\.CHR: rank=0 chr=[0-9]+ team=[0-9]+ score=[1-9]",
        "min": 2,
        "max": 2
      }
    ]
  }
}
