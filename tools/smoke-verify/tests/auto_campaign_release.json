{
  "scenario_name": "auto_campaign_release",
  "description": "T-TESTS-002 canonical full base-campaign release run. One ordinary PerfectDark.exe process loads a PC-native agent, starts Defection through the production mission-start entry, completes all 17 base missions through the scoped objective helper and authoritative endscreen/save/unlock path, advances through the production ImGui bridge, and exits only after Credits is live. A second ordinary client reloads the same agent JSON and verifies all 17 best times persisted. The runner retains both structured evidence reports, final agent save, and aggregate log with binary and fixture hashes.",
  "tags": ["campaign", "release", "t-tests-002", "milestone-1", "multi-process", "save"],
  "paths_of_interest": [
    "port/src/autocampaign.c",
    "port/src/campaign_run.c",
    "port/src/campaign_evidence.c",
    "port/src/savefile.c",
    "port/fast3d/pdgui_bridge.c",
    "src/game/objectives.c",
    "src/game/endscreen.c",
    "src/game/mainmenu.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 1680,
  "install_state": "clean",
  "remove_paths": [
    "campaign_release_run.json",
    "campaign_release_verify.json",
    "agent_smoke.json"
  ],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/agent_smoke.json", "dst": "agent_smoke.json" }
  ],
  "processes": [
    {
      "name": "campaign-live-run",
      "log_file": "pd-client.log",
      "smoke_path": "tools/smoke-verify/fixtures/campaign_release_run_process.json",
      "snapshot_log_file": "pd-campaign-live-run.log",
      "snapshot_exit_timeout_seconds": 30,
      "boot_args": [
        "--no-update-check",
        "--no-sound",
        "--no-net",
        "--portable",
        "--skip-intro",
        "--launch-load-agent",
        "smoke",
        "--auto-campaign",
        "0",
        "--auto-campaign-fast",
        "--auto-campaign-difficulty",
        "0"
      ],
      "wait_for": "SMOKE: result=campaign_complete .* code=0",
      "wait_timeout_seconds": 1500
    },
    {
      "name": "campaign-restart-verify",
      "log_file": "pd-client.log",
      "smoke_path": "tools/smoke-verify/fixtures/campaign_release_verify_process.json",
      "snapshot_log_file": "pd-campaign-restart-verify.log",
      "snapshot_exit_timeout_seconds": 30,
      "boot_args": [
        "--no-update-check",
        "--no-sound",
        "--no-net",
        "--portable",
        "--skip-intro",
        "--launch-load-agent",
        "smoke",
        "--auto-campaign-verify",
        "0",
        "--auto-campaign-difficulty",
        "0"
      ],
      "wait_for": "SMOKE: result=campaign_verified .* code=0",
      "wait_timeout_seconds": 120
    }
  ],
  "retain_artifacts": [
    { "src": "campaign_release_run.json" },
    { "src": "campaign_release_verify.json" },
    { "src": "agent_smoke.json", "name": "agent_smoke_after_campaign.json" }
  ],
  "assertions": {
    "required_lines": [
      "CAMPAIGN\\.AUTO: plan profile='smoke' difficulty=0 start=0 final=16 missions=17",
      "CAMPAIGN\\.AUTO: loaded plan=0 idx=0 stage_id='base:defection'",
      "CAMPAIGN\\.AUTO: completed plan=16 idx=16 stage_id='base:skedarruins'",
      "CAMPAIGN\\.AUTO: routed plan=16 idx=16 stage_id='base:skedarruins' route_to='system:credits'",
      "CAMPAIGN\\.AUTO: credits verified live profile='smoke' missions=17 difficulty=0",
      "CAMPAIGN\\.AUTO: persisted verification complete profile='smoke' missions=17",
      "SMOKE: result=campaign_complete .* code=0",
      "SMOKE: result=campaign_verified .* code=0"
    ],
    "forbidden_patterns": [
      "CAMPAIGN\\.AUTO: failed reason=",
      "SMOKE: result=campaign_failed",
      "SMOKE: result=timeout",
      "ACCESS_VIOLATION",
      "EXCEPTION:",
      "FATAL: ",
      "LOUDFAIL\\.LOAD: .*unrecoverable",
      "catalog miss.*fallback",
      "numeric fallback"
    ],
    "required_counts": [
      { "pattern": "CAMPAIGN\\.AUTO: loaded plan=", "min": 17, "max": 17 },
      { "pattern": "CAMPAIGN\\.AUTO: completed plan=", "min": 17, "max": 17 },
      { "pattern": "CAMPAIGN\\.AUTO: routed plan=", "min": 17, "max": 17 },
      { "pattern": "CAMPAIGN\\.AUTO: persisted plan=", "min": 17, "max": 17 },
      { "pattern": "SAVE: Agent Profile v3 committed name='smoke'", "min": 18, "max": 18 },
      { "pattern": "BOOT: --launch-load-agent consumed: name='smoke' result=OK", "min": 2, "max": 2 }
    ]
  }
}
