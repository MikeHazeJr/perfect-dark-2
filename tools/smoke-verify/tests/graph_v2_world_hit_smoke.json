{
  "scenario_name": "graph_v2_world_hit_smoke",
  "description": "Run only after separate target/aim qualification with the same frozen client. Armed setup selects a queried real visible unshielded human bot in normal offline MP and raises only its maximum health. Native camera/query geometry determines aim; actual ray/chrHit damage must match independently authored 3/9 then 6/12 times observed body-part scaling. Both hands/modes, public source replacement, closed gate, recursive rejection, dispatch retirement and context loss after actual damage are required. Missing or mismatched applied-damage witnesses fail; no manual acceptance claim.",
  "tags": [
    "runtime",
    "weapon",
    "graph-v2",
    "world-hit",
    "c3842"
  ],
  "paths_of_interest": [
    "port/src/weapon_graph_v2_runtime.cpp",
    "port/src/weapon_nested_runtime_harness.c",
    "src/game/prop.c",
    "src/game/bondgun.c",
    "tools/smoke-verify/generate_weapon_mesh_ingress_fixtures.py"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 240,
  "install_state": "clean",
  "weapon_mesh_ingress_fixtures": true,
  "fixtures": [
    {
      "src": "tools/smoke-verify/tests/graph_v2_world_hit_smoke.json",
