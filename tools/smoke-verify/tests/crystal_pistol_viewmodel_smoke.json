{
  "scenario_name": "crystal_pistol_viewmodel_smoke",
  "description": "Crystal pistol test mod: the public OBJ held model, its catalog body texture and its muzzle/hold parts load from dev-mods/crystal_pistol and render in first person in an ordinary Combat Simulator match. Modelled on needler_viewmodel_visibility_smoke.",
  "tags": [
    "modding",
    "pdxxx",
    "weapon",
    "viewmodel",
    "visual",
    "crystal_pistol",
    "smoke"
  ],
  "paths_of_interest": [
    "dev-mods/crystal_pistol/crystal_pistol.pdweapon",
    "dev-mods/crystal_pistol/crystal_pistol_body.pdtexture",
    "port/src/modasset_compiler.c",
    "port/src/catalog_model_generation.cpp",
    "src/game/bondgun.c"
  ],
  "log_channel_mask": "game,catalog,render,match,mods,system",
  "verbose": 0,
  "timeout_seconds": 300,
  "install_state": "current",
  "remove_paths": [
    "mods/crystal_pistol.pdmod",
    "mods/crystal_pistol",
    "mods/installed/crystal_pistol.pdmod",
    "mods/installed/crystal_pistol"
  ],
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/needler_visual_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/crystal_pistol_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "packed_fixtures": [
    {
      "src": "dev-mods/crystal_pistol",
      "dst": "mods/installed/crystal_pistol.pdmod"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-generated-mesh-render-audit",
    "--debug-force-first-person",
    "--launch-mp-room",
    "base:arena_mp_felicity",
    "base:combat",
    "0",
    "--debug-spawn-weapon",
    "mod_crystal_pistol:crystal_pistol",
    "--debug-auto-start-match"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 240000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900,
      "comment": "Fresh installs extract and walk every typed archive first; wait for ordinary first-person Combat Simulator gameplay with the pistol as the spawn weapon."
    },
    { "at_ms": 2000, "type": "screenshot", "path": "cp-viewmodel-a.bmp", "comment": "Held model at rest." },
    { "at_ms": 3000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press", "comment": "One crystal; the muzzle flash shows for a frame." },
    { "at_ms": 3016, "type": "screenshot", "path": "cp-viewmodel-flash-a.bmp" },
    { "at_ms": 3033, "type": "screenshot", "path": "cp-viewmodel-flash-b.bmp" },
    { "at_ms": 3100, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    { "at_ms": 4000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press" },
    { "at_ms": 4016, "type": "screenshot", "path": "cp-viewmodel-flash-c.bmp" },
    { "at_ms": 4100, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    {
      "at_ms": 5000,
      "type": "exit",
      "comment": "Exit after the rest capture and two shots."
    }
  ],
  "retain_artifacts": [
    { "src": "cp-viewmodel-a.bmp" },
    { "src": "cp-viewmodel-flash-a.bmp" },
    { "src": "cp-viewmodel-flash-b.bmp" },
    { "src": "cp-viewmodel-flash-c.bmp" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=crystal_pistol_viewmodel_smoke",
      "modmgr: loading mod 'crystal_pistol' from archive '.*installed.*crystal_pistol\\.pdmod'",
      "PDWEAPON\\.NESTED\\.MESH_SOURCE: owner=mod_crystal_pistol:crystal_pistol id=mod_crystal_pistol:crystal_pistol_model action=claimed",
      "LOADER\\.POOL\\.WEAPON\\.PUBLIC_ADAPTER: installed id=mod_crystal_pistol:crystal_pistol runtime=\\d+ model=\\d+ funcs=2",
      "BONDGUN\\.SOURCE: loaded catalog model source filenum=\\d+ id=mod_crystal_pistol:crystal_pistol_model",
      "MODASSET\\.RENDER: generated source modeldef rendered id=mod_crystal_pistol:crystal_pistol_model",
      "BOOT: --debug-force-first-person active: stagenum=0x43 frame=\\d+ before=\\d+ after=0 frames=900",
      "LOG\\.WPN\\.DIAG: playerRenderHud branch=fp_render cameramode=0",
      "BONDGUN\\.FLASH: weapon=\\d+ hand=0 parts=1",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "ASSET\\.SOURCE_ONLY",
      "LOUDFAIL\\.FALLBACK",
      "ASSET\\.FALLBACK",
      "RomProvider:filenum",
      "result=FAIL",
      "result=MISSING",
      "CATEGORY_MISMATCH",
      "references unknown texture catalog id",
      "did not resolve to a catalog texture",
      "selected public texture source unavailable",
      "integer-native quantization warning source=.*crystal_pistol",
      "'mod_crystal_pistol:crystal_pistol' public weapon adapter install failed",
      "'mod_crystal_pistol:crystal_pistol' activation failed"
    ],
    "required_counts": [
      {
        "pattern": "BONDGUN\\.SOURCE: loaded catalog model source filenum=\\d+ id=mod_crystal_pistol:crystal_pistol_model",
        "min": 1
      },
      {
        "pattern": "MODASSET\\.RENDER: generated source modeldef rendered id=mod_crystal_pistol:crystal_pistol_model",
        "min": 1
      },
      {
        "pattern": "BONDGUN\\.FLASH: weapon=\\d+ hand=0 parts=1",
        "min": 2
      },
      {
        "pattern": "SMOKE\\.GLSHOT: captured",
        "min": 4
      }
    ]
  }
}
