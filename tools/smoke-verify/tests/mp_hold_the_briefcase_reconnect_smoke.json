          },
          {
            "pattern": "NET.RECONNECT.INVENTORY client=0",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET.RECONNECT.INVENTORY client=1",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET.RECONNECT.PLAYER_STATE client=1 dead=1 apply=snapshot live_side_effects=0 drops=0 score=0 owner_cleanup=0",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET.RECONNECT.CLIENT commit=accepted",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET.RECONNECT.CLIENT transaction=complete",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "stage-start presentation previous_tickmode=[0-9]+ next_tickmode=[0-9]+ stale_cutscene_retired=[01]",
            "min": 1,
            "max": 2
          },
          {
            "pattern": "SMOKE.WAIT: satisfied condition=network_stage_live",
            "min": 2,
            "max": 2
          },
          {
            "pattern": "SMOKE.WAIT: satisfied condition=gameplay_ready",
            "min": 2,
            "max": 2
          },
          {
            "pattern": "COMBAT: SHOT_FIRED .*weapon=11(?: |$)",
            "min": 1,
            "max": 60
          },
          {
            "pattern": "NET.RECONNECT.TEARDOWN retryable=0 credential_retained=0",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "SCENARIO\\.STATE: first state from host scenario=1",
            "min": 2,
            "max": 2
          },
          {
            "pattern": "HTB: client briefcase from host holder=-?[0-9]+",
            "min": 2
          }
        ],
        "forbidden_patterns": [
          "SMOKE: result=network_reconnect_failed",
          "SMOKE: result=network_retire_held_weapon_failed",
          "NET: connection rejected",
          "SMOKE: result=timeout",
          "EXCEPTION_ACCESS_VIOLATION",
          "ACCESS_VIOLATION",
          "FATAL: "
        ]
      }
    }
  ],
  "input_sequence": [
    {
      "at_ms": 200000,
      "type": "exit",
      "comment": "Each process uses its own bounded smoke_path; this parent schedule is only a fallback."
    }
  ],
  "assertions": {
    "required_lines": [
      "NET.RECONNECT.PRESERVE client=1 player=1",
      "PLAYER.INIT.COMMIT reconnect client=1 player=1",
      "NET.RECONNECT.GAMEPLAY client=1 player=1 .*server_accepted=1",
      "SMOKE.WAIT: satisfied condition=network_reconnect_available",
      "SMOKE.NETWORK: reconnect rc=0",
      "NET.RECONNECT.CLIENT commit=accepted client=1 ordered_snapshot=complete",
      "NET.RECONNECT.PLAYER_STATE client=1 dead=1 apply=snapshot live_side_effects=0 drops=0 score=0 owner_cleanup=0",
      "SMOKE.NETWORK: retired_prop_absent client=1 .*authoritative_present=0 read_only=1 production_cleanup=1",
      "NET.RECONNECT.RESYNC.PREPARE client=1 .*terminal_absent=0 first_terminal_absent=0 exact_set=1",
