{
  "scenario_name": "boot_smoke",
  "description": "Boot to title screen on a clean install. Catches the B-324 class (NULL weapon pool at gun reset), B-318 class (walker emits zero rows on empty per-asset dirs), and B-326 class (ROM at the wrong install path).",
  "tags": ["boot", "catalog", "stability"],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/romextract*.c",
    "port/src/loader_*.c",
    "port/src/assetcatalog*.c",
    "port/src/catalog_*.c",
    "port/src/boot_*.c",
    "src/game/bondgun*.c",
    "src/game/invitems.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 120,
  "install_state": "clean",
  "boot_args": ["--no-update-check", "--no-sound"],
  "input_sequence": [
    { "at_ms": 0,     "type": "wait", "comment": "let boot run, no scripted input" },
    { "at_ms": 90000, "type": "exit", "comment": "boot smoke is log-based; exit before timeout when boot has settled" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=boot_smoke",
      "Asset Catalog: \\d+ entries registered",
      "LOADER\\.UNIVERSAL\\.SUMMARY:",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.LOAD: .*unrecoverable"
    ],
    "required_counts": [
      { "pattern": "memp heap at", "min": 1, "max": 1 }
    ]
  }
}
