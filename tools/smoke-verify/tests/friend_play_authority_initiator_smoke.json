{
  "scenario_name": "friend_play_authority_initiator_smoke",
  "description": "D-003 option A ordinary-client friend-play proof with the initiator elected as the sole authority. The invitee launches first and accepts through signed presence, the initiator then starts the in-client listen host and publishes a typed signed match route, and the invitee performs one idempotent route join. Only the authority owns the packed/enabled Needler fixture and the spawn request; the clean joiner receives the public package through the authoritative ready gate before ordinary first-person gameplay/render verification.",
  "tags": ["network", "social", "friend-play", "authority-first", "presence-v5", "listen-host", "manifest", "distribution", "needler", "v009", "smoke"],
  "paths_of_interest": [
    "port/src/net/group_session.c",
    "port/src/presence.c",
    "port/src/net/net.c",
    "port/src/net/net_match_route.c",
    "tools/smoke-verify/generate_friend_play_identity.py",
    "dev-mods/needler",
    "tools/smoke-verify/run.ps1"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 260,
  "install_state": "clean",
  "separate_process_installs": true,
  "remove_paths": [
    "mods/needler.pdmod",
    "mods/needler",
    "mods/installed/needler.pdmod",
    "mods/installed/needler",
    "mods/weapons/mod_needler:needler",
    "mods/.temp/received/needler",
    "mods/.temp/pdmod/needler"
  ],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/needler_source_pd.ini", "dst": "pd.ini" }
  ],
  "processes": [
    {
      "name": "invitee",
      "friend_play_identity": "invitee",
      "log_file": "pd-client.log",
      "fixtures": [
        { "src": "tools/smoke-verify/fixtures/no_mods_enabled.json", "dst": "mods-enabled.json" }
      ],
      "boot_args": [
        "--no-update-check",
        "--portable",
        "--launch-load-agent",
        "invitee",
        "--debug-presence-port",
        "28106",
        "--debug-friend-play-role",
        "invitee",
        "--debug-friend-play-auto-accept",
        "--debug-friend-play-upload-kbps",
        "1000",
        "--port",
        "27210",
        "--launch-mp-room",
        "base:arena_chicago",
        "base:combat",
        "0",
        "--host-autostart",
        "--match-timelimit-sec",
        "120",
        "--debug-generated-mesh-render-audit",
        "--debug-effect-runtime-audit",
        "--debug-force-first-person"
      ],
      "wait_for": "FRIENDPLAY: role=invitee ready",
      "wait_timeout_seconds": 140,
      "assertions": {
        "required_lines": [
          "BOOT: --launch-load-agent armed: name='invitee'",
          "BOOT: --launch-load-agent consumed: name='invitee' result=OK",
          "FRIENDPLAY: role=invitee ready local=0x[0-9a-f]+ peer=0x[0-9a-f]+ upload_kbps=1000 auto_invite=0 auto_accept=1",
          "FRIENDPLAY: role=invitee invite accepted peer=0x[0-9a-f]+ rc=0",
          "GROUP.SESSION: authority elected handle=0x07a68cc7 kbps=9000 local=0",
          "GROUP.MATCH: pre-connect authority latched handle=0x07a68cc7 local=0",
          "PRESENCE: accepted signed match route authority=0x07a68cc7 flags=0x[0-9a-f]+ port=27210 fresh=1",
          "GROUP.MATCH: join attempt authority=0x07a68cc7 route_kind=match-server flags=0x[0-9a-f]+ count=1",
          "GROUP.MATCH: authority latched handle=0x07a68cc7 transport=client route_flags=0x[0-9a-f]+",
          "NET: connected to server, sending CLC_AUTH",
          "MATCH: client stage start received",
          "DISTRIB: recv begin 'mod_needler:needler'",
          "DISTRIB: SHA-256 verified for 'mod_needler:needler'",
          "DISTRIB: transactionally staged received archive at .* pending catalog admission",
          "DISTRIB\\.CATALOG\\.ADMISSION: id=mod_needler:needler scanner_result=[1-9]\\d*",
          "MANIFEST: check passed .* sending READY",
          "SMOKE: result=scripted_exit"
        ],
        "forbidden_patterns": [
          "GROUP.MATCH: server start attempt",
          "NET: created server on port 27210",
          "GROUP.MATCH: join attempt.*count=[2-9]",
          "GROUP.MATCH: server start attempt.*count=[2-9]",
          "GROUP.SESSION: handing peer",
          "probe endpoint.*netStartClient",
          "relay descriptor.*netStartClient",
          "P2P\\.(LAN|STUN|UPNP|ICE).*netStartClient",
          "GROUP.SESSION: auxiliary probe.*netStartClient",
          "EXCEPTION_ACCESS_VIOLATION",
          "ACCESS_VIOLATION",
          "FATAL: ",
          "SMOKE: result=timeout",
          "LOUDFAIL\\.FALLBACK",
          "ASSET\\.FALLBACK",
          "RomProvider:filenum",
          "result=FAIL",
          "result=MISSING",
          "CATEGORY_MISMATCH"
        ],
        "required_counts": [
          { "pattern": "GROUP.MATCH: join attempt authority=0x07a68cc7 route_kind=match-server flags=0x[0-9a-f]+ count=1", "min": 1, "max": 1 },
          { "pattern": "NET: connected to server, sending CLC_AUTH", "min": 1, "max": 1 },
          { "pattern": "MATCH: client stage start received", "min": 1, "max": 1 }
        ]
      }
    },
    {
      "name": "initiator",
      "friend_play_identity": "initiator",
      "log_file": "pd-client.log",
      "fixtures": [
        { "src": "tools/smoke-verify/fixtures/needler_enabled.json", "dst": "mods-enabled.json" }
      ],
      "packed_fixtures": [
        { "src": "dev-mods/needler", "dst": "mods/installed/needler.pdmod" }
      ],
      "boot_args": [
        "--no-update-check",
        "--portable",
        "--launch-load-agent",
        "initiator",
        "--debug-presence-port",
        "28105",
        "--debug-friend-play-role",
        "initiator",
        "--debug-friend-play-auto-invite",
        "--debug-friend-play-upload-kbps",
        "9000",
        "--port",
        "27210",
        "--launch-mp-room",
        "base:arena_chicago",
        "base:combat",
        "0",
        "--host-autostart",
        "--match-timelimit-sec",
        "120",
        "--debug-generated-mesh-render-audit",
        "--debug-effect-runtime-audit",
        "--debug-force-first-person",
        "--debug-spawn-weapon",
        "mod_needler:needler"
      ],
      "assertions": {
        "required_lines": [
          "BOOT: --launch-load-agent armed: name='initiator'",
          "BOOT: --launch-load-agent consumed: name='initiator' result=OK",
          "FRIENDPLAY: role=initiator ready local=0x[0-9a-f]+ peer=0x[0-9a-f]+ upload_kbps=9000 auto_invite=1 auto_accept=0",
          "FRIENDPLAY: role=initiator invite sent peer=0x[0-9a-f]+ rc=0",
          "GROUP.SESSION: authority elected handle=0x07a68cc7 kbps=9000 local=1",
          "GROUP.MATCH: pre-connect authority latched handle=0x07a68cc7 local=1",
          "GROUP.MATCH: server start attempt authority=0x07a68cc7 count=1",
          "NET: created server on port 27210",
          "GROUP.MATCH: authority latched handle=0x07a68cc7 transport=listen-host",
          "GROUP.SESSION: published typed match route authority=0x07a68cc7 flags=0x[0-9a-f]+ port=27210",
          "MANIFEST-HOST: built [1-9]\\d* entries",
          "NET: ready gate: client \\d+ NEED_ASSETS \\(\\d+ missing\\), queuing transfer",
          "DISTRIB: sending 'mod_needler:needler' to",
          "NET: ready gate: client \\d+ READY",
          "MATCH: server stage start",
          "MATCH-START: writing SVC_STAGE_START, stage_session=[1-9]\\d*, stage_id='base:arena_chicago'",
          "NET: mpStartMatch server activeMask=0x[0-9a-f]+ players=2 \\(dedicated=0\\)",
          "SPAWN: player 0 spawned with weapon \\d+ .*auto-equipped to right hand",
          "BONDGUN\\.SOURCE: loaded catalog model source filenum=\\d+ id=mod_needler:needler_model",
          "MODASSET\\.RENDER: generated source modeldef rendered id=mod_needler:needler_model",
          "LOG\\.WPN\\.DIAG: playerRenderHud branch=fp_render cameramode=0",
          "EFFECT\\.GAMEPLAY\\.AUDIT: committed asset=mod_needler:pink_burst_effect",
          "EFFECT\\.PRESENTATION\\.RENDER\\.AUDIT: instance=\\d+ snapshots=[1-9]\\d* channel=2 shader=needler_pink_burst",
          "\\[[0-9]{2}:[0-9]{2}\\.[0-9]{2}\\] shutdown"
        ],
        "forbidden_patterns": [
          "GROUP.MATCH: join attempt",
          "GROUP.MATCH: server start attempt.*count=[2-9]",
          "GROUP.SESSION: handing peer",
          "probe endpoint.*netStartClient",
          "relay descriptor.*netStartClient",
          "P2P\\.(LAN|STUN|UPNP|ICE).*netStartClient",
          "GROUP.SESSION: auxiliary probe.*netStartClient",
          "EXCEPTION_ACCESS_VIOLATION",
          "ACCESS_VIOLATION",
          "FATAL: ",
          "SMOKE: result=timeout",
          "LOUDFAIL\\.FALLBACK",
          "ASSET\\.FALLBACK",
          "RomProvider:filenum",
          "result=FAIL",
          "result=MISSING",
          "CATEGORY_MISMATCH"
        ],
        "required_counts": [
          { "pattern": "GROUP.MATCH: server start attempt authority=0x07a68cc7 count=1", "min": 1, "max": 1 },
          { "pattern": "NET: created server on port 27210", "min": 1, "max": 1 },
          { "pattern": "MATCH: server stage start", "min": 1, "max": 1 }
        ]
      }
    }
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "The invitee boots first so its ordinary client is presence-ready before the initiator sends the invite. The typed signed route, ready-gated package transfer, and server-authoritative match must complete before visual captures." },
    { "at_ms": 65000, "type": "action", "name": "ACTION_AIM_DOWN", "action": "press", "comment": "Exercise the first peer after the route, transfer, and match-start gates." },
    { "at_ms": 68000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press" },
    { "at_ms": 69000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    { "at_ms": 72000, "type": "action", "name": "ACTION_FIRE_MODE", "action": "press" },
    { "at_ms": 73000, "type": "action", "name": "ACTION_FIRE_MODE", "action": "release" },
    { "at_ms": 74000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press" },
    { "at_ms": 75000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    { "at_ms": 78000, "type": "action", "name": "ACTION_AIM_DOWN", "action": "release" },
    { "at_ms": 120000, "type": "action", "name": "ACTION_AIM_DOWN", "action": "press", "comment": "Exercise the later-starting peer through the same ordinary gameplay consumers." },
    { "at_ms": 124000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press" },
    { "at_ms": 125000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    { "at_ms": 128000, "type": "action", "name": "ACTION_FIRE_MODE", "action": "press" },
    { "at_ms": 129000, "type": "action", "name": "ACTION_FIRE_MODE", "action": "release" },
    { "at_ms": 130000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press" },
    { "at_ms": 131000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    { "at_ms": 134000, "type": "action", "name": "ACTION_AIM_DOWN", "action": "release" },
    { "at_ms": 175000, "type": "exit", "comment": "Exit both isolated clients after route establishment, manifest distribution, stage start, and gameplay/render execution. V-009 image proof runs as its independent capture gate." }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=friend_play_authority_initiator_smoke",
      "FRIENDPLAY: role=invitee ready local=0x[0-9a-f]+ peer=0x[0-9a-f]+ upload_kbps=1000",
      "FRIENDPLAY: role=initiator ready local=0x[0-9a-f]+ peer=0x[0-9a-f]+ upload_kbps=9000",
      "FRIENDPLAY: role=initiator invite sent peer=0x[0-9a-f]+ rc=0",
      "FRIENDPLAY: role=invitee invite accepted peer=0x[0-9a-f]+ rc=0",
      "GROUP.SESSION: authority elected handle=0x07a68cc7 kbps=9000 local=0",
      "GROUP.SESSION: authority elected handle=0x07a68cc7 kbps=9000 local=1",
      "GROUP.MATCH: pre-connect authority latched handle=0x07a68cc7 local=(0|1)",
      "PRESENCE: accepted signed match route authority=0x07a68cc7 flags=0x[0-9a-f]+ port=27210 fresh=1",
      "GROUP.SESSION: published typed match route authority=0x07a68cc7 flags=0x[0-9a-f]+ port=27210",
      "GROUP.SESSION: auxiliary probe (open|exhausted|could not start) peer=0x[0-9a-f]+",
      "GROUP.MATCH: authority latched handle=0x07a68cc7 transport=(listen-host|client)( route_flags=0x[0-9a-f]+)?",
      "NET: incoming connection",
      "MANIFEST-MP: transition .* entries in authoritative server manifest",
      "DISTRIB: all transfers complete \\(1 received\\)",
      "MANIFEST: check passed .* sending READY",
      "MATCH-START: client received SVC_STAGE_START, stage_session=[1-9]\\d*",
      "MATCH-START: stage_session=[1-9]\\d* resolved to stagenum=0x1d",
      "CATALOG\\.LIFECYCLE\\.ACTIVATE: activated weapon metadata payload 'mod_needler:needler'",
      "WEAPONGRAPH\\.EFFECT\\.INGEST: id=mod_needler:pink_burst_effect",
      "EFFECT\\.GAMEPLAY\\.AUDIT: committed asset=mod_needler:pink_burst_effect",
      "EFFECT\\.PRESENTATION\\.RENDER\\.AUDIT: instance=\\d+ snapshots=[1-9]\\d* channel=2 shader=needler_pink_burst",
      "\\[[0-9]{2}:[0-9]{2}\\.[0-9]{2}\\] shutdown",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "GROUP.SESSION: handing peer",
      "probe endpoint.*netStartClient",
      "relay descriptor.*netStartClient",
      "P2P\\.(LAN|STUN|UPNP|ICE).*netStartClient",
      "GROUP.SESSION: auxiliary probe.*netStartClient",
      "GROUP.MATCH: server start attempt.*count=[2-9]",
      "GROUP.MATCH: join attempt.*count=[2-9]",
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.ASSETCHAIN",
      "LOUDFAIL\\.FALLBACK",
      "ASSET\\.FALLBACK",
      "RomProvider:filenum",
      "DISTRIB: transfer set failed",
      "DISTRIB: catalog rejected",
      "NET: ready gate: client \\d+ DECLINED",
      "result=FAIL",
      "result=MISSING",
      "CATEGORY_MISMATCH"
    ],
    "required_counts": [
      { "pattern": "SMOKE: scenario=friend_play_authority_initiator_smoke", "min": 2, "max": 2 },
      { "pattern": "GROUP.MATCH: pre-connect authority latched handle=0x07a68cc7 local=(0|1)", "min": 2, "max": 2 },
      { "pattern": "GROUP.MATCH: server start attempt authority=0x07a68cc7 count=1", "min": 1, "max": 1 },
      { "pattern": "GROUP.MATCH: join attempt authority=0x07a68cc7 route_kind=match-server flags=0x[0-9a-f]+ count=1", "min": 1, "max": 1 },
      { "pattern": "NET: created server on port 27210", "min": 1, "max": 1 },
      { "pattern": "NET: connected to server, sending CLC_AUTH", "min": 1, "max": 1 },
      { "pattern": "MATCH: server stage start", "min": 1, "max": 1 },
      { "pattern": "MATCH: client stage start received", "min": 1, "max": 1 },
      { "pattern": "GROUP.MATCH: authority latched handle=0x07a68cc7 transport=listen-host", "min": 1, "max": 1 },
      { "pattern": "GROUP.MATCH: authority latched handle=0x07a68cc7 transport=client route_flags=0x[0-9a-f]+", "min": 1, "max": 1 },
      { "pattern": "DISTRIB: all transfers complete \\(1 received\\)", "min": 2, "max": 2 },
      { "pattern": "EFFECT\\.GAMEPLAY\\.AUDIT: committed asset=mod_needler:pink_burst_effect", "min": 1 },
      { "pattern": "EFFECT\\.PRESENTATION\\.RENDER\\.AUDIT: .*shader=needler_pink_burst", "min": 1 },
      { "pattern": "\\[[0-9]{2}:[0-9]{2}\\.[0-9]{2}\\] shutdown", "min": 2, "max": 2 },
