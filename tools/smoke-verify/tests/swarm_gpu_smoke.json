{
  "scenario_name": "swarm_gpu_smoke",
  "description": "c115 re-author: boot directly into Swarm-GPU via --launch-scenario swarm_gpu (skips Settings -> Debug -> Test Scenarios menu nav entirely + the mouse-only GPU radio click). Verifies GL >= 4.3 probe, compute shader compile+link, TESTSCEN.LAUNCH: Swarm-GPU, BENCHMARK.SWARM.GPU log line, and ladder progression (4 -> 8 -> 16 -> 32 -> 64 -> 128). Surfaces B-311 (128-bot FATAL display-list crash) and the SWARM_GPU_MAX=256 hard cap. Ladder driven via action injection of ACTION_TESTSCEN_CYCLE_COUNT (focus-independent).",
  "tags": ["debug", "swarm", "gpu", "benchmark", "scaling", "compute"],
  "paths_of_interest": [
    "port/fast3d/swarm_gpu.cpp",
    "port/src/testscenarios.c",
    "port/src/swarm_test.c",
    "port/fast3d/gfx_sdl2.cpp",
    "port/src/main.c",
    "port/src/actionmap.cpp"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 240,
  "install_state": "clean",
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--launch-scenario",
    "swarm_gpu"
  ],
  "input_sequence": [
    { "at_ms": 0,      "type": "wait", "comment": "boot path: --launch-scenario seeds testScenarioLaunch(SWARM_GPU) post-catalog-init. GL probe + compute shader compile happens on first dispatch. SAME GAP AS SWARM_CPU: player pos uninitialised at first launch, respawn fails, endscreen_solo pushes imgui_menu IMC, cycler suppressed. Workaround: dismiss endscreen via ACTION_USE so the scenario re-launches with the player properly positioned." },
    { "at_ms": 12000, "type": "action", "name": "ACTION_USE",        "action": "tap", "comment": "dismiss endscreen_solo continue -- restart match" },
    { "at_ms": 18000, "type": "action", "name": "ACTION_CANCEL_USE", "action": "tap", "comment": "fallback: cancel endscreen to main_menu" },
    { "at_ms": 22000, "type": "action", "name": "ACTION_USE",        "action": "tap", "comment": "advance whatever transient screen remains" },
    { "at_ms": 40000,  "type": "action", "name": "ACTION_TESTSCEN_CYCLE_COUNT", "action": "tap", "comment": "cycle 4 -> 8" },
    { "at_ms": 50000,  "type": "action", "name": "ACTION_TESTSCEN_CYCLE_COUNT", "action": "tap", "comment": "cycle 8 -> 16" },
    { "at_ms": 60000,  "type": "action", "name": "ACTION_TESTSCEN_CYCLE_COUNT", "action": "tap", "comment": "cycle 16 -> 32" },
    { "at_ms": 70000,  "type": "action", "name": "ACTION_TESTSCEN_CYCLE_COUNT", "action": "tap", "comment": "cycle 32 -> 48" },
    { "at_ms": 80000,  "type": "action", "name": "ACTION_TESTSCEN_CYCLE_COUNT", "action": "tap", "comment": "cycle 48 -> 64 (at SWARM_GPU_SAFE_MAX)" },
    { "at_ms": 90000,  "type": "action", "name": "ACTION_TESTSCEN_CYCLE_COUNT", "action": "tap", "comment": "cycle 64 -> 128 (crosses SAFE_MAX, B-311 FATAL candidate)" },
    { "at_ms": 150000, "type": "exit", "comment": "scripted exit" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=swarm_gpu_smoke",
      "BOOT: --launch-scenario 'swarm_gpu' -> testScenarioLaunch",
      "BOOT: --no-net set; netInit\\(\\) skipped",
      "TESTSCEN\\.LAUNCH: Swarm-GPU",
      "BENCHMARK\\.SWARM\\.GPU"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.LOAD: .*unrecoverable"
    ],
    "required_counts": [
      { "pattern": "BENCHMARK\\.SWARM\\.GPU", "min": 1 }
    ]
  }
}
