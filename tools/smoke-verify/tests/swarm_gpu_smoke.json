    { "at_ms": 150000, "type": "exit",  "comment": "wrap up -- harness scripted exit" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=swarm_gpu_smoke",
      "BENCHMARK\\.SWARM\\.GPU"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
