    { "at_ms": 12000,  "type": "key",   "key": "Return", "action": "tap", "comment": "enter main menu" },
    { "at_ms": 15000,  "type": "key",   "key": "Escape", "action": "tap", "comment": "close any leftover dialog" },

    { "at_ms": 17000,  "type": "key",   "key": "Down",   "action": "tap", "comment": "main menu: walk down toward Settings" },
    { "at_ms": 17500,  "type": "key",   "key": "Down",   "action": "tap" },
    { "at_ms": 18000,  "type": "key",   "key": "Down",   "action": "tap" },
