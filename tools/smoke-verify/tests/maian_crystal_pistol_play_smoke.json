  "assertions": {
    "required_lines": [
      "SMOKE: scenario=maian_crystal_pistol_play_smoke",
      "MODAUTHOR\\.RECIPE\\.BEGIN path='.*maian_crystal_pistol.recipe\\.json'",
      "MODAUTHOR\\.SAVE\\.OK kind=weapon catalog=mod:weapon_maian_crystal_pistol mod_id=mod\\.weapon_maian_crystal_pistol updated=0",
      "MODAUTHOR\\.ENABLE\\.OK mod_id=mod\\.weapon_maian_crystal_pistol restart_count=0",
      "MODAUTHOR\\.CATALOG\\.OK catalog=mod:weapon_maian_crystal_pistol type=\\d+ enabled=1 bundled=0 category='mod\\.weapon_maian_crystal_pistol'",
      "MODAUTHOR\\.RECIPE\\.RESULT result=OK catalog=mod:weapon_maian_crystal_pistol",
      "BOOT: --debug-auto-start-match consumed",
      "BOOT: --launch-mp-room direct match start",
      "BOOT: --debug-spawn-weapon 'mod:weapon_maian_crystal_pistol' \\(SPECIFIC\\)",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready .*stable_ms=3000",
      "SETUP: user-picked spawn weapon 'mod:weapon_maian_crystal_pistol' num=\\d+ preserved",
      "SPAWN: player 0 spawned with weapon \\d+ \\(.*\\) -- auto-equipped to right hand",
      "BONDGUN\\.SOURCE: loaded catalog model source filenum=\\d+ id=mod:weapon_maian_crystal_pistol__mesh_tri_mesh",
      "MODELDEF\\.SOURCE: loaded catalog model source type=\\d+ filenum=\\d+ id=mod:weapon_maian_crystal_pistol__mesh_needle",
      "SMOKE: result=scripted_exit"
