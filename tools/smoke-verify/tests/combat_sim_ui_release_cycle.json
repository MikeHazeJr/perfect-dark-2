{
  "scenario_name": "combat_sim_ui_release_cycle",
  "description": "B-1076 ordinary-client lifecycle gate. It loads a staged agent through the production Agent Select transaction, walks the real Main Menu and Play graph into Combat Simulator, lets the Room-owned auto-start one-shot fire the same start_match scene edge as the visible button, waits on typed offline gameplay and endscreen state, activates the real Play Again action, then repeats a Room-originated second match. The fixture proves each match request releases its complete menu owner before stage publication and never relies on menu/input watchdog repair.",
  "tags": ["combatsim", "agent-select", "menu", "lifecycle", "ordinary-client", "release", "b1076"],
  "paths_of_interest": [
    "port/src/combat_sim_verify.c",
    "port/include/smoke_readiness.h",
    "port/src/smoke_readiness.c",
    "port/src/smoke_harness.c",
    "port/fast3d/pdgui_menu_agentselect.cpp",
    "port/fast3d/pdgui_menu_mainmenu.cpp",
    "port/fast3d/pdgui_menu_room.cpp",
    "port/fast3d/pdgui_menu_endscreen.cpp",
    "src/game/mplayer/mplayer.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 540,
  "install_state": "clean",
  "remove_paths": [
    "combat-sim-ui-cycle-home"
  ],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/agent_smoke.json", "dst": "combat-sim-ui-cycle-home/agent_smoke.json" }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--savedir",
    "./combat-sim-ui-cycle-home",
    "--debug-auto-start-match",
    "--debug-combat-sim-cycles",
    "2",
    "--match-timelimit-sec",
    "18"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait", "comment": "Allow clean extraction and the ordinary title path to settle." },
    { "at_ms": 112000, "type": "action", "name": "ACTION_USE", "action": "tap", "comment": "Open Agent Select through the production title accept path." },
    { "at_ms": 130000, "type": "action", "name": "ACTION_USE", "action": "tap", "comment": "Activate the only staged JSON profile and enter the live Main Menu." },
    { "at_ms": 140000, "type": "action", "name": "ACTION_MENU_UP", "action": "tap", "comment": "Clamp restored Main Menu focus to the first Play row without assuming persisted cursor state." },
    { "at_ms": 140500, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 141000, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 141500, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 142000, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 142500, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 143000, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 143500, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 144000, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 144500, "type": "action", "name": "ACTION_MENU_UP", "action": "tap" },
    { "at_ms": 146000, "type": "action", "name": "ACTION_USE", "action": "tap", "comment": "Main Menu Play accept." },
    { "at_ms": 148000, "type": "action", "name": "ACTION_MENU_DOWN", "action": "tap", "comment": "Move from Solo Missions to Combat Simulator in the Play subview." },
    { "at_ms": 149000, "type": "action", "name": "ACTION_USE", "action": "tap", "comment": "Open the real solo Room; its one-shot start fires only after the leader footer exists." },
    { "at_ms": 150000, "type": "wait_until", "condition": "offline_gameplay_ready", "timeout_ms": 120000, "stable_ms": 2000, "comment": "Require a continuously updated, controllable offline Combat Simulator player after the first Room scene edge and stage load." },
    { "at_ms": 151000, "type": "wait_until", "condition": "endscreen_visible", "timeout_ms": 60000, "stable_ms": 1000, "comment": "Wait for the first production time-limit end and stable results surface." },
    { "at_ms": 152500, "type": "action", "name": "ACTION_USE", "action": "tap", "comment": "Activate the real Play Again action-bar widget." },
    { "at_ms": 153000, "type": "wait_until", "condition": "offline_gameplay_ready", "timeout_ms": 120000, "stable_ms": 2000, "comment": "Require the Room-return auto-start to reach a second independently loaded and controllable match." },
    { "at_ms": 154000, "type": "wait_until", "condition": "endscreen_visible", "timeout_ms": 60000, "stable_ms": 1000, "comment": "Require the second complete match and results surface." },
    { "at_ms": 156000, "type": "exit", "comment": "Exit with the second endscreen as the one legitimate active UI owner." }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=combat_sim_ui_release_cycle",
      "SAVE: initialized .*combat-sim-ui-cycle-home",
      "MENUPOOL: acquired agent_select",
      "MENU\\.GRAPH\\.FIRE source=agent_select edge=load",
      "AGENT\\.SESSION: activation committed name='smoke' source=json",
      "MENUPOOL: released agent_select",
      "MENUPOOL: acquired main_menu",
      "MENU\\.GRAPH\\.FIRE source=main_menu edge=solo_play",
      "MENU\\.GRAPH\\.FIRE source=main_solo_view edge=combat_simulator",
      "MENUPOOL: acquired room",
      "MATCH\\.CYCLE: armed target=2 kill_entries=0 matrix_delay_sec=18 start_mode=room",
      "BOOT: --match-timelimit-sec armed: seconds=18",
      "ROOM: --debug-auto-start-match -- firing Start Match",
      "MENU\\.GRAPH\\.FIRE source=room edge=start_match",
      "MATCH\\.CYCLE: start ordinal=1 target=2 path=room",
      "TRANSITION\\.STAGE\\.PREP reason='mpStartMatch' flags=0x02",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready .*stable_ms=2000 stable_elapsed_ms=(?:2[0-9]{3}|[3-9][0-9]{3}|[1-9][0-9]{4,})",
      "MATCH\\.CYCLE: end ordinal=1 target=2 matrix_applied=0",
      "SMOKE\\.WAIT: satisfied condition=endscreen_visible .*stable_ms=1000 stable_elapsed_ms=(?:1[0-9]{3}|[2-9][0-9]{3}|[1-9][0-9]{4,})",
      "MENU\\.GRAPH\\.FIRE source=endscreen_mp edge=continue",
      "MATCH\\.CYCLE: return ordinal=1 starts=1 target=2 rearm=1",
      "ROOM\\.CONFIG: adopted existing setup",
      "MATCH\\.CYCLE: consuming room auto-start next_ordinal=2 target=2",
      "MATCH\\.CYCLE: start ordinal=2 target=2 path=room",
      "MATCH\\.CYCLE: end ordinal=2 target=2 matrix_applied=0",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "MATCH\\.CYCLE: config rejected",
      "MATCH\\.STATS\\.FIXTURE: rejected",
      "MENU: watchdog",
      "INPUTCTX watchdog",
      "MENUPOOL: released [1-9][0-9]* legacy-stack leak slot",
      "MENUPOOL legacy-stack leak: \\[",
      "MENUPOOL: drift",
      "PLAYER\\.INIT\\.ROLLBACK",
      "PLAYER\\.INIT\\.PREFLIGHT match=reject",
      "filemgrSaveOrLoad",
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "SMOKE: result=wait_timeout"
    ],
    "required_counts": [
      { "pattern": "MENU\\.GRAPH\\.FIRE source=agent_select edge=load", "min": 1, "max": 1 },
      { "pattern": "MENU\\.GRAPH\\.FIRE source=main_menu edge=solo_play", "min": 1, "max": 1 },
      { "pattern": "MENU\\.GRAPH\\.FIRE source=main_solo_view edge=combat_simulator", "min": 1, "max": 1 },
      { "pattern": "MENU\\.GRAPH\\.FIRE source=room edge=start_match", "min": 2, "max": 2 },
      { "pattern": "TRANSITION\\.STAGE\\.PREP reason='mpStartMatch' flags=0x02", "min": 2, "max": 2 },
      { "pattern": "MATCH\\.CYCLE: start ordinal=", "min": 2, "max": 2 },
      { "pattern": "MATCH\\.CYCLE: end ordinal=", "min": 2, "max": 2 },
      { "pattern": "MATCH: endscreen shown", "min": 2, "max": 2 },
      { "pattern": "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready", "min": 2, "max": 2 },
      { "pattern": "SMOKE\\.WAIT: satisfied condition=endscreen_visible", "min": 2, "max": 2 },
      { "pattern": "MENUPOOL: acquired room", "min": 2, "max": 2 },
      { "pattern": "MENUPOOL: released room", "min": 2, "max": 2 },
      { "pattern": "MENUPOOL: acquired agent_select", "min": 1, "max": 1 },
      { "pattern": "MENUPOOL: released agent_select", "min": 1, "max": 1 }
    ]
  }
}
