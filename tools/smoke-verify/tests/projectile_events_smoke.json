      "PROJECTILE\\.RULE: came_to_rest weapon=base:devastator func=primary object=base:grenaderound [^\\n]*modules=spend_fuse native=spend_fuse",
      "PROJECTILE\\.EVENT: spawned weapon=base:grenade func=secondary ",
      "PROJECTILE\\.EVENT: spawned weapon=base:nbomb func=primary ",
