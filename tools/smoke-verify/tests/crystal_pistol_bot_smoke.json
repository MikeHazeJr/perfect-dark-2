{
  "scenario_name": "crystal_pistol_bot_smoke",
  "description": "Crystal pistol (T-MODDING-008) against a simulant: one bot is held in front of the player; three crystals stick into it and detonate as a cluster, then a charged volley of crystal mines is launched toward it and the mines arm where they land.",
  "tags": [
    "modding",
    "pdxxx",
    "weapon",
    "projectile",
    "bots",
    "crystal_pistol",
    "smoke"
  ],
  "paths_of_interest": [
    "dev-mods/crystal_pistol/crystal_pistol.pdweapon",
    "src/game/bondgun_mod.c",
    "src/game/propobj.c"
  ],
  "log_channel_mask": "game,catalog,render,match,mods,system",
  "verbose": 0,
  "timeout_seconds": 300,
  "install_state": "current",
  "remove_paths": [
    "mods/crystal_pistol.pdmod",
    "mods/crystal_pistol",
    "mods/installed/crystal_pistol.pdmod",
    "mods/installed/crystal_pistol"
  ],
  "fixtures": [
    {
      "src": "tools/smoke-verify/fixtures/needler_visual_pd.ini",
      "dst": "pd.ini"
    },
    {
      "src": "tools/smoke-verify/fixtures/crystal_pistol_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "packed_fixtures": [
    {
      "src": "dev-mods/crystal_pistol",
      "dst": "mods/installed/crystal_pistol.pdmod"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--launch-mp-room",
    "base:arena_mp_felicity",
    "base:combat",
    "1",
    "--debug-spawn-weapon",
    "mod_crystal_pistol:crystal_pistol",
    "--debug-place-bot-near-player",
    "--debug-place-bot-near-player-hold-sec",
    "20",
    "--debug-auto-start-match"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 240000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900,
      "comment": "Wait for first-person Combat Simulator gameplay; the bot is placed in front of the player shortly after."
    },
    { "at_ms": 3500, "type": "screenshot", "path": "cp-bot-placed.bmp" },
    { "at_ms": 4000, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "tap" },
    { "at_ms": 4400, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "tap" },
    { "at_ms": 4700, "type": "screenshot", "path": "cp-bot-two-stuck.bmp" },
    { "at_ms": 4800, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "tap", "comment": "The third crystal in the bot completes the cluster." },
    { "at_ms": 5150, "type": "screenshot", "path": "cp-bot-cluster.bmp" },
    { "at_ms": 6000, "type": "action", "name": "ACTION_FIRE_MODE", "action": "tap" },
    { "at_ms": 10500, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "press", "comment": "After the regrow, charge and launch a volley toward the bot." },
    { "at_ms": 10550, "type": "action", "name": "ACTION_FIRE_PRIMARY", "action": "release" },
    { "at_ms": 12500, "type": "screenshot", "path": "cp-bot-mines.bmp" },
    { "at_ms": 16000, "type": "exit" }
  ],
  "retain_artifacts": [
    { "src": "cp-bot-placed.bmp" },
    { "src": "cp-bot-two-stuck.bmp" },
    { "src": "cp-bot-cluster.bmp" },
    { "src": "cp-bot-mines.bmp" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=crystal_pistol_bot_smoke",
      "BOOT: --debug-place-bot-near-player consumed: bot=.* result=OK",
      "BONDGUN\\.CRYSTAL: landed weapon=\\d+ func=0 owner=0 at=\\(.*\\) embedded=1",
      "BONDGUN\\.CRYSTAL: cluster detonated weapon=\\d+ func=0 owner=0 count=3",
      "BONDGUN\\.CHARGE: released weapon=\\d+ player=0 count=6 launched=6 dead=0 sockets=6",
      "BONDGUN\\.CRYSTAL: mine armed weapon=\\d+ func=1 owner=0",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.FALLBACK",
      "result=FAIL",
      "BONDGUN\\.MODEL: .*B-1185",
      "'mod_crystal_pistol:crystal_pistol' public weapon adapter install failed",
      "'mod_crystal_pistol:crystal_pistol' activation failed"
    ],
    "required_counts": [
      {
        "pattern": "SMOKE\\.GLSHOT: captured",
        "min": 4
      }
    ]
  }
}
