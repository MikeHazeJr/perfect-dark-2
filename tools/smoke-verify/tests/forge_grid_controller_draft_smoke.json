{
  "scenario_name": "forge_grid_controller_draft_smoke",
  "description": "Open Level File, play the draft, and return through the same actions used by Grid controller navigation.",
  "tags": [
    "modding",
    "forge",
    "arena",
    "pdarena",
    "input",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/fast3d/pdgui_forge_editor.cpp",
    "port/src/actionmap.cpp",
    "port/src/forge_level_io.c",
    "src/game/forgemode.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 420,
  "install_state": "clean",
  "remove_paths": [
    "mods/blank_room"
  ],
  "fixtures": [
    {"src": "dev-mods/blank_room/mod.json", "dst": "mods/blank_room/mod.json"},
    {"src": "dev-mods/blank_room/blank_room.pdarena", "dst": "mods/blank_room/blank_room.pdarena"},
    {"src": "tools/smoke-verify/fixtures/blank_room_enabled.json", "dst": "mods-enabled.json"}
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--launch-forge-level",
    "mod_blank_room:arena_blank_room"
  ],
  "input_sequence": [
    {"at_ms": 0, "type": "wait_until", "condition": "forge_editor_ready", "timeout_ms": 160000, "stable_ms": 300},
    {"at_ms": 300, "type": "action", "name": "ACTION_FORGE_SIDEBAR_ACTIVATE", "action": "tap"},
    {"at_ms": 450, "type": "wait_until", "condition": "forge_level_file_open", "timeout_ms": 15000, "stable_ms": 300},
    {"at_ms": 850, "type": "action", "name": "ACTION_FORGE_TAB_NEXT", "action": "tap"},
    {"at_ms": 1250, "type": "action", "name": "ACTION_FORGE_SIDEBAR_ACTIVATE", "action": "tap"},
    {"at_ms": 1450, "type": "wait_until", "condition": "offline_gameplay_ready", "timeout_ms": 90000, "stable_ms": 1000},
    {"at_ms": 1850, "type": "action", "name": "ACTION_FORGE_TOGGLE", "action": "tap"},
    {"at_ms": 2100, "type": "wait_until", "condition": "forge_level_file_open", "timeout_ms": 90000, "stable_ms": 500},
    {"at_ms": 2500, "type": "exit"}
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=forge_grid_controller_draft_smoke"
    ],
    "required_sequences": [
      {
        "name": "Open the document, play its draft, and return through mapped actions",
        "patterns": [
          "SMOKE\\.WAIT: satisfied condition=forge_editor_ready ",
          "FORGE\\.LEVEL\\.OPEN: arena=mod_blank_room:arena_blank_room ",
          "SMOKE\\.WAIT: satisfied condition=forge_level_file_open at_ms=450 ",
          "FORGE\\.DRAFT\\.PREPARED: arena=mod_blank_room:arena_blank_room revision=[0-9a-f]{64} bytes=[1-9][0-9]* unsaved=0",
          "FORGE\\.DRAFT\\.BIND: stage=0x[0-9a-f]+",
          "FORGE\\.DRAFT\\.PLAYING: stage=0x[0-9a-f]+",
          "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready at_ms=1450 ",
          "FORGE\\.DRAFT\\.RETURNED: stage=0x[0-9a-f]+ unsaved=0 undo=0",
          "SMOKE\\.WAIT: satisfied condition=forge_level_file_open at_ms=2100 ",
          "SMOKE: result=scripted_exit"
        ]
      }
    ],
    "required_counts": [
      {"pattern": "FORGE\\.DRAFT\\.PREPARED: arena=mod_blank_room:arena_blank_room revision=[0-9a-f]{64} bytes=[1-9][0-9]* unsaved=0", "min": 1, "max": 1},
      {"pattern": "FORGE\\.DRAFT\\.BIND: stage=0x[0-9a-f]+", "min": 1, "max": 1},
      {"pattern": "FORGE\\.DRAFT\\.PLAYING: stage=0x[0-9a-f]+", "min": 1, "max": 1},
      {"pattern": "FORGE\\.DRAFT\\.RETURNED: stage=0x[0-9a-f]+ unsaved=0 undo=0", "min": 1, "max": 1}
    ],
    "forbidden_patterns": [
      "FORGE\\.DRAFT\\.DEBUG\\.(OK|FAIL)",
      "PLAYER\\.INIT\\.ROLLBACK",
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout"
    ]
  }
}
