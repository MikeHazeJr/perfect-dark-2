{
  "scenario_name": "menu_virtual_controller_handoff",
  "description": "Hold two SDL virtual controllers in their normal gameplay slots. Verify player 1 leaves the menu untouched while player 0 is present, then navigates and enters/exits Settings after player 0 disconnects. Verify a fresh player 0 device reclaims those controls while player 1 keeps its assignment.",
  "tags": ["menus", "input", "virtual-controller", "handoff"],
  "log_channel_mask": "all",
  "verbose": 1,
  "timeout_seconds": 260,
  "install_state": "clean",
  "remove_paths": ["controller-handoff-home"],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/agent_smoke.json", "dst": "controller-handoff-home/agent_smoke.json" }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--savedir",
    "./controller-handoff-home",
    "--main-menu"
  ],
  "input_sequence": [
    { "at_ms": 0, "type": "wait_until", "condition": "agent_select_ready", "timeout_ms": 180000, "stable_ms": 250 },
    { "at_ms": 250, "type": "controller_attach", "slot": 0 },
    { "at_ms": 550, "type": "controller_attach", "slot": 1 },
    { "at_ms": 850, "type": "controller_button", "slot": 0, "button": "a", "action": "press", "comment": "Select the staged Agent on the original player 0 controller." },
    { "at_ms": 950, "type": "controller_button", "slot": 0, "button": "a", "action": "release" },
    { "at_ms": 1200, "type": "wait_until", "condition": "main_menu_play_ready", "timeout_ms": 15000, "stable_ms": 250 },
    { "at_ms": 1450, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "press", "comment": "The secondary controller must leave Play focused while player 0 is present." },
    { "at_ms": 1550, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "release" },
    { "at_ms": 1750, "type": "wait_until", "condition": "main_menu_play_ready", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 2000, "type": "controller_detach", "slot": 0, "comment": "Player 1's existing SDL instance remains live throughout the handoff." },
    { "at_ms": 2300, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "press" },
    { "at_ms": 2400, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "release" },
    { "at_ms": 2600, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "press" },
    { "at_ms": 2700, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "release" },
    { "at_ms": 2900, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "press" },
    { "at_ms": 3000, "type": "controller_button", "slot": 1, "button": "dpdown", "action": "release" },
    { "at_ms": 3250, "type": "wait_until", "condition": "main_menu_settings_focused", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 3500, "type": "controller_button", "slot": 1, "button": "a", "action": "press" },
    { "at_ms": 3600, "type": "controller_button", "slot": 1, "button": "a", "action": "release" },
    { "at_ms": 3850, "type": "wait_until", "condition": "settings_video_ready", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 4100, "type": "screenshot", "path": "controller-handoff-player1-settings.bmp" },
    { "at_ms": 4350, "type": "controller_button", "slot": 1, "button": "b", "action": "press" },
    { "at_ms": 4450, "type": "controller_button", "slot": 1, "button": "b", "action": "release" },
    { "at_ms": 4700, "type": "wait_until", "condition": "main_menu_play_ready", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 4950, "type": "controller_attach", "slot": 0, "comment": "The replacement controller occupies the empty player 0 slot." },
    { "at_ms": 5200, "type": "controller_button", "slot": 0, "button": "dpdown", "action": "press" },
    { "at_ms": 5300, "type": "controller_button", "slot": 0, "button": "dpdown", "action": "release" },
    { "at_ms": 5500, "type": "controller_button", "slot": 0, "button": "dpdown", "action": "press" },
    { "at_ms": 5600, "type": "controller_button", "slot": 0, "button": "dpdown", "action": "release" },
    { "at_ms": 5800, "type": "controller_button", "slot": 0, "button": "dpdown", "action": "press" },
    { "at_ms": 5900, "type": "controller_button", "slot": 0, "button": "dpdown", "action": "release" },
    { "at_ms": 6150, "type": "wait_until", "condition": "main_menu_settings_focused", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 6400, "type": "controller_button", "slot": 0, "button": "a", "action": "press" },
    { "at_ms": 6500, "type": "controller_button", "slot": 0, "button": "a", "action": "release" },
    { "at_ms": 6750, "type": "wait_until", "condition": "settings_video_ready", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 7000, "type": "screenshot", "path": "controller-handoff-player0-settings.bmp" },
    { "at_ms": 7250, "type": "controller_button", "slot": 0, "button": "b", "action": "press" },
    { "at_ms": 7350, "type": "controller_button", "slot": 0, "button": "b", "action": "release" },
    { "at_ms": 7600, "type": "wait_until", "condition": "main_menu_play_ready", "timeout_ms": 5000, "stable_ms": 250 },
    { "at_ms": 7850, "type": "controller_detach", "slot": 0 },
    { "at_ms": 8100, "type": "controller_detach", "slot": 1 },
    { "at_ms": 8350, "type": "exit" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=menu_virtual_controller_handoff",
      "AGENT\\.SESSION: activation committed name='smoke' source=json",
      "SMOKE\\.PAD: event=attached instance=\\d+ player=0 virtual=1 peer_instance=-1 ",
      "SMOKE\\.PAD: event=attached instance=(\\d+) player=1 virtual=1 peer_instance=(?!\\1 )\\d+ ",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=1 virtual=1 accept=0 cancel=0 .*context=imgui_menu down=0 primary_present=1 frontend_instance=(?!\\1$)\\d+$",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=1 virtual=1 accept=0 cancel=0 .*context=imgui_menu down=1 primary_present=0 frontend_instance=\\1$",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=1 virtual=1 accept=1 cancel=0 .*context=imgui_menu down=0 primary_present=0 frontend_instance=\\1$",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=1 virtual=1 accept=0 cancel=1 .*context=imgui_menu down=0 primary_present=0 frontend_instance=\\1$",
      "SMOKE\\.PAD: event=attached instance=(\\d+) player=0 virtual=1 peer_instance=(?!\\1 )\\d+ ",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=0 virtual=1 accept=0 cancel=0 .*context=imgui_menu down=1 primary_present=1 frontend_instance=\\1$",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=0 virtual=1 accept=1 cancel=0 .*context=imgui_menu down=0 primary_present=1 frontend_instance=\\1$",
      "SMOKE\\.PAD: event=state_observed instance=(\\d+) player=0 virtual=1 accept=0 cancel=1 .*context=imgui_menu down=0 primary_present=1 frontend_instance=\\1$",
      "SMOKE\\.PAD: event=detached instance=\\d+ player=1 neutral_observed=1 removed_observed=1 virtual=1 peer_instance=-1$",
      "SMOKE\\.GLSHOT: captured [0-9]+x[0-9]+ -> controller-handoff-player1-settings\\.bmp",
      "SMOKE\\.GLSHOT: captured [0-9]+x[0-9]+ -> controller-handoff-player0-settings\\.bmp",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=(?:timeout|wait_|controller_)",
      "SMOKE\\.PAD: failure",
      "SMOKE\\.PAD: event=terminal_cleanup",
      "SMOKE\\.ACTION\\.INJECT",
      "MENU\\.GRAPH\\.FIRE .* ok=0"
    ],
    "required_counts": [
      { "pattern": "SMOKE\\.PAD: event=attached .*player=0 virtual=1", "min": 2, "max": 2 },
      { "pattern": "SMOKE\\.PAD: event=attached .*player=1 virtual=1", "min": 1, "max": 1 },
      { "pattern": "SMOKE\\.PAD: event=detached .*player=0 neutral_observed=1 removed_observed=1 virtual=1 peer_instance=\\d+", "min": 2, "max": 2 },
      { "pattern": "SMOKE\\.WAIT: satisfied condition=main_menu_play_ready ", "min": 4, "max": 4 },
      { "pattern": "SMOKE\\.WAIT: satisfied condition=main_menu_settings_focused ", "min": 2, "max": 2 },
      { "pattern": "SMOKE\\.WAIT: satisfied condition=settings_video_ready ", "min": 2, "max": 2 }
    ]
  },
  "retain_artifacts": [
    { "src": "controller-handoff-player1-settings.bmp", "name": "controller-handoff-player1-settings.bmp" },
    { "src": "controller-handoff-player0-settings.bmp", "name": "controller-handoff-player0-settings.bmp" }
  ]
}
