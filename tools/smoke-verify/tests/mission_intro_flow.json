{
  "scenario_name": "mission_intro_flow",
  "description": "Drives Main Menu -> Solo Play -> Solo Missions -> first mission -> Agent difficulty -> Accept -> intro cutscene -> first stage tick. Verifies the solo-mission menu graph chain (MENU_TYPE_SOLO_MISSION start/back, scene-op), the cutscene push, and stage 0x02 (dataDyne Central) first-tick stability. Surfaces gaps in mission selection, difficulty pick, accept, intro cutscene, and first stage tick paths.",
  "tags": ["menu", "solo", "mission", "cutscene", "stability"],
  "paths_of_interest": [
    "port/fast3d/pdgui_menu_solomission.cpp",
    "src/game/menutick.c",
    "src/game/lv.c",
    "src/game/player.c",
    "port/src/menugraph.c",
    "src/lib/main.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 240,
  "install_state": "clean",
  "boot_args": [
    "--no-update-check",
    "--no-sound"
  ],
  "input_sequence": [
    { "at_ms": 0,     "type": "wait",  "comment": "boot to title screen" },
    { "at_ms": 12000, "type": "key",   "key": "Return", "action": "tap", "comment": "advance past PD logo / intro" },
    { "at_ms": 13500, "type": "key",   "key": "Return", "action": "tap" },
    { "at_ms": 15000, "type": "key",   "key": "Return", "action": "tap", "comment": "open Main Menu" },
    { "at_ms": 17000, "type": "key",   "key": "Up",     "action": "tap", "comment": "ensure selection at top" },
    { "at_ms": 17500, "type": "key",   "key": "Up",     "action": "tap" },
    { "at_ms": 18000, "type": "key",   "key": "Down",   "action": "tap", "comment": "Solo Play row" },
    { "at_ms": 18500, "type": "key",   "key": "Return", "action": "tap", "comment": "enter Solo Play" },
    { "at_ms": 21000, "type": "key",   "key": "Return", "action": "tap", "comment": "Solo Missions (default sub-row)" },
    { "at_ms": 24000, "type": "key",   "key": "Return", "action": "tap", "comment": "select first mission (dataDyne Central)" },
    { "at_ms": 28000, "type": "key",   "key": "Return", "action": "tap", "comment": "Agent difficulty (default)" },
    { "at_ms": 31000, "type": "key",   "key": "Return", "action": "tap", "comment": "Accept Mission" },
    { "at_ms": 35000, "type": "wait",  "comment": "let intro cutscene + stage 0x02 first-tick settle" },
    { "at_ms": 90000, "type": "exit",  "comment": "scripted exit; harness force-exits at timeout_seconds" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=mission_intro_flow",
      "Asset Catalog: \\d+ entries registered",
      "MENU\\.GRAPH\\.FIRE source=solo_mission",
      "LV\\.DIAG: first-render",
      "SMOKE: result=(scripted_exit|timeout)"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.LOAD: .*unrecoverable",
      "MENU\\.GRAPH\\.FIRE .* ok=0"
    ],
    "required_counts": []
  }
}
