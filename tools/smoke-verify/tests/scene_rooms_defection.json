{
  "scenario_name": "scene_rooms_defection",
  "description": "Visual check (B-1266, B-1267): Defection through --launch-mission. Five screenshots of the intro, which is not skipped for them (its camera looks at the dataDyne building from outside), then five at the start looking ahead, down, left, back and right. The scene must hold every triangle the ROM draws for the stage (19,780 in 167 rooms; the export used to leave out 14 rooms with 10,479 of them, the exterior among them) and draw 18,292 of them with back faces culled, as the room display lists do.",
  "tags": [
    "solo",
    "mission",
    "render",
    "visual"
  ],
  "paths_of_interest": [
    "port/src/romextract_pdarena.c",
    "port/fast3d/scenario_scene_renderer.cpp",
    "tools/verify_scene_rooms_against_rom.py"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 300,
  "install_state": "current",
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--launch-mission",
    "0x30",
    "--difficulty",
    "agent"
  ],
  "input_sequence": [
