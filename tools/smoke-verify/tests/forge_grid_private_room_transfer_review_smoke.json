{
  "scenario_name": "forge_grid_private_room_transfer_review_smoke",
  "description": "The listen host stages an exact native room extension during private Combat and offers its arena bytes to the authenticated creator after explicit mutual consent. The creator already has the real external model but has never installed the staged arena. Both retain the same verified source cache without activating or installing the variant. An ordinary Room peer receives no review or stage traffic. Continue retires the review and the original private stage.",
  "tags": [
    "modding",
    "forge",
    "network",
    "shared-draft",
    "private-playtest",
    "smoke",
    "structural-staging",
    "structural-review",
    "prepared-sources",
    "staged-transfer"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/net/grid_edit_room_net.c",
    "port/src/net/netmsg.c",
    "port/src/pdmain.c",
    "src/game/bg.c",
    "port/src/forge_room_builder.cpp",
    "port/src/grid_match_runtime.c",
    "port/src/forge_level_io.c",
    "port/src/net/grid_edit_room_wire.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 720,
  "install_state": "clean",
  "remove_paths": [
    "grid-transfer-review-host",
    "grid-transfer-review-creator",
    "grid-transfer-review-ordinary"
  ],
