    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "grid-transfer-review-creator/mods/.pdmod-migration-done"
    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "grid-transfer-review-ordinary/mods/.pdmod-migration-done"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/mod.json",
      "dst": "grid-transfer-review-host/mods/example_typed_pdxxx_basic/mod.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/meshes/tri_mesh.pdmesh",
      "dst": "grid-transfer-review-host/mods/example_typed_pdxxx_basic/meshes/tri_mesh.pdmesh"
    },
    {
      "src": "tools/smoke-verify/fixtures/typed_pdxxx_basic_enabled.json",
      "dst": "grid-transfer-review-host/mods-enabled.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/mod.json",
      "dst": "grid-transfer-review-creator/mods/example_typed_pdxxx_basic/mod.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/meshes/tri_mesh.pdmesh",
      "dst": "grid-transfer-review-creator/mods/example_typed_pdxxx_basic/meshes/tri_mesh.pdmesh"
    },
    {
      "src": "tools/smoke-verify/fixtures/typed_pdxxx_basic_enabled.json",
      "dst": "grid-transfer-review-creator/mods-enabled.json"
    }
  ],
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--savedir",
        "$E/grid-transfer-review-host",
        "--moddir",
        "$E/grid-transfer-review-host/mods",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--debug-level-tool-new",
        "original",
        "--debug-level-tool-name",
        "Grid_Playtest_Source",
        "--debug-grid-room-size",
        "2100,2700,1800,600,500,390",
        "--debug-forge-level",
