      "wait_timeout_seconds": 240,
      "assertions": {
        "required_sequences": [
          {
            "name": "creator-verifies-the-transferred-arena-without-installing-or-joining",
            "patterns": [
              "NET: SVC_AUTH from server, our ID is 1",
              "NET: SVC_ROOM_ASSIGN: assigned to room [0-9]+",
              "NET\\.GRID\\.EDIT: verified baseline and accepted creator grant",
              "SMOKE\\.GRID\\.PLAYTEST: creator sent ambient=137 host_epoch=[1-9][0-9]* room=[0-9]+ lobby=1",
              "NET\\.GRID\\.EDIT: observed revision=2 author=2",
              "SMOKE\\.GRID\\.DRAFT: role=creator revision=2 ambient=137",
              "SMOKE\\.GRID\\.TRANSFER: creator baseline room=[0-9]+ catalog=[1-9][0-9]* stage=0x[0-9a-f]+ variant_absent=1 model=example:tri_mesh",
              "NET\\.GRID\\.REVIEW\\.TRANSFER: consented role=creator serial=[1-9][0-9]* bytes=[1-9][0-9]*",
              "NET\\.GRID\\.REVIEW\\.TRANSFER: verified serial=[1-9][0-9]* arena=mod:arena_grid_extension_staged bytes=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.PREPARED: retained role=creator serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.TRANSFER: released serial=[1-9][0-9]* reason=verified",
              "SMOKE\\.GRID\\.EXTENSION: creator transferred room=[0-9]+ generation=1 epoch=[1-9][0-9]* revision=2 serial=[1-9][0-9]* sha256=[0-9a-f]{64} installed=0 catalog=[1-9][0-9]* stage=0x[0-9a-f]+",
              "SMOKE\\.GRID\\.DRAFT: role=creator closed room=[0-9]+ lobby=1",
              "SMOKE: result=grid_draft_complete .*code=0"
            ]
          }
        ],
        "required_lines": [
          "SAVE: initialized .*grid-transfer-review-creator",
          "FORGE\\.LEVEL\\.EDIT: made decoration setup_[0-9]+ drawn with example:tri_mesh",
          "NET\\.GRID\\.REVIEW\\.PREPARED: released serial=[1-9][0-9]* reason=[A-Za-z_-]+"
        ],
        "required_counts": [
          {
            "pattern": "NET\\.GRID\\.REVIEW\\.PREPARED: retained role=creator",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET\\.GRID\\.REVIEW\\.TRANSFER: consented role=creator",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET\\.GRID\\.REVIEW\\.TRANSFER: verified serial=",
            "min": 1,
            "max": 1
          }
        ],
        "forbidden_patterns": [
          "NET\\.GRID\\.OFFER: guest",
          "SVC_STAGE_START read",
          "SVC_STAGE_END read",
          "NET\\.GRID\\.RESULT:",
          "GRID\\.MATCH\\.STAGE: active",
          "SMOKE\\.GRID\\.EXTENSION: creator authored locally",
          "PDARENA\\.SCENARIO: owner=mod:arena_grid_extension_staged"
