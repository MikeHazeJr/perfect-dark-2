{
  "scenario_name": "vehicle_flow",
  "description": "Vehicle-IMC + bondbike smoke. Boot directly to STAGE_CITRAINING (--skip-intro -> 0x26, uses FILE_USETUPDISH which contains a hoverbike at PAD_DISH_01F9). After stage load completes, hold W to walk forward while occasionally tapping F (ACTION_USE / ACTION_VEHICLE_EXIT) to interact with any hoverbike encountered. If mount succeeds, drive briefly with W/S/A/D, then F to dismount. Best-effort exploration: scripted reach to the bike pad is not guaranteed, so assertions are conservative -- the harness surfaces vehicle IMC fire lines and any post-B-298 wiring gap as findings rather than hard fails. Verifies bondbike init/tick path and imcVehicleMount/Dismount lifecycle hooks (port/src/inputlayer.c onVehicleDriverPush/Pop -> imcActivate g_ImcVehicle).",
  "tags": ["vehicle", "input", "imc", "bondbike", "stability"],
  "paths_of_interest": [
    "src/game/bondbike.c",
    "src/game/bondmove.c",
    "port/include/actionmap.h",
    "port/src/actionmap.cpp",
    "port/src/inputlayer.c",
    "src/setups/setupdish.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 240,
  "install_state": "clean",
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--skip-intro"
  ],
  "input_sequence": [
    { "at_ms": 0,      "type": "wait",  "comment": "boot phase: --skip-intro sets g_StageNum=STAGE_CITRAINING (0x26) and routes through agent select -> main menu -> CI free-roam" },

    { "at_ms": 18000,  "type": "key",   "key": "Return", "action": "tap", "comment": "agent_select accept: MENU.GRAPH.FIRE source=agent_select edge=load -> opens main menu" },
    { "at_ms": 21000,  "type": "key",   "key": "Escape", "action": "tap", "comment": "main menu CLOSE via ESC -> CI free-roam (lvIsPaused 1 -> 0). DO NOT press Escape again or it pauses + reopens main menu." },

    { "at_ms": 24000,  "type": "key",   "key": "W",      "action": "press",   "comment": "phase 1 -- walk forward exploring for hoverbike at PAD_DISH_01F9" },
    { "at_ms": 27000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "interact attempt #1 (ACTION_USE -> currentPlayerTryMountHoverbike if in range)" },
    { "at_ms": 30000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "interact attempt #2" },
    { "at_ms": 33000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "interact attempt #3" },
    { "at_ms": 36000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "interact attempt #4" },
    { "at_ms": 39000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "interact attempt #5" },
    { "at_ms": 42000,  "type": "key",   "key": "W",      "action": "release", "comment": "stop forward motion" },

    { "at_ms": 44000,  "type": "key",   "key": "A",      "action": "press",   "comment": "phase 2 -- strafe / look-around for bike from another vantage" },
    { "at_ms": 47000,  "type": "key",   "key": "A",      "action": "release" },
    { "at_ms": 47500,  "type": "key",   "key": "W",      "action": "press",   "comment": "walk forward again" },
    { "at_ms": 50000,  "type": "key",   "key": "F",      "action": "tap" },
    { "at_ms": 53000,  "type": "key",   "key": "F",      "action": "tap" },
    { "at_ms": 56000,  "type": "key",   "key": "F",      "action": "tap" },
    { "at_ms": 59000,  "type": "key",   "key": "W",      "action": "release" },

    { "at_ms": 61000,  "type": "key",   "key": "D",      "action": "press",   "comment": "phase 3 -- strafe right" },
    { "at_ms": 64000,  "type": "key",   "key": "D",      "action": "release" },
    { "at_ms": 64500,  "type": "key",   "key": "W",      "action": "press" },
    { "at_ms": 67000,  "type": "key",   "key": "F",      "action": "tap" },
    { "at_ms": 70000,  "type": "key",   "key": "F",      "action": "tap" },
    { "at_ms": 73000,  "type": "key",   "key": "F",      "action": "tap" },
    { "at_ms": 75000,  "type": "key",   "key": "W",      "action": "release" },

    { "at_ms": 78000,  "type": "key",   "key": "W",      "action": "press",   "comment": "phase 4 -- drive-test segment: if vehicle IMC mounted, W = ACTION_VEHICLE_ACCELERATE" },
    { "at_ms": 82000,  "type": "key",   "key": "A",      "action": "press",   "comment": "if mounted: ACTION_VEHICLE_STEER_LEFT" },
    { "at_ms": 84000,  "type": "key",   "key": "A",      "action": "release" },
    { "at_ms": 85000,  "type": "key",   "key": "D",      "action": "press",   "comment": "if mounted: ACTION_VEHICLE_STEER_RIGHT" },
    { "at_ms": 87000,  "type": "key",   "key": "D",      "action": "release" },
    { "at_ms": 88000,  "type": "key",   "key": "W",      "action": "release" },
    { "at_ms": 89000,  "type": "key",   "key": "S",      "action": "press",   "comment": "if mounted: ACTION_VEHICLE_BRAKE" },
    { "at_ms": 91000,  "type": "key",   "key": "S",      "action": "release" },

    { "at_ms": 93000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "dismount attempt (ACTION_VEHICLE_EXIT -> bmoveSetMode(MOVEMODE_WALK))" },
    { "at_ms": 95000,  "type": "key",   "key": "F",      "action": "tap",     "comment": "dismount retry in case first tap mis-aligned" },

    { "at_ms": 97000,  "type": "wait",  "comment": "settle, allow any deferred dismount / scene work to complete" },
    { "at_ms": 110000, "type": "exit",  "comment": "scripted exit -- findings live in the log regardless of mount success" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=vehicle_flow",
      "Asset Catalog: \\d+ entries registered",
      "boot stage set to 0x26",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "LOUDFAIL\\.LOAD: .*unrecoverable"
    ],
    "required_counts": []
  }
}
