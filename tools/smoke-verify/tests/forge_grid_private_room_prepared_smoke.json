{
  "scenario_name": "forge_grid_private_room_prepared_smoke",
  "description": "Author and install an exact room extension independently in the creator profile before connecting. The listen host stages the same extension during private Combat. Each peer reads its own native arena and standalone model packages, retains an exact preparation cache, and confirms the matching review in the same Room. Continue retires the proof and the original world without playing the staged Variant.",
  "tags": [
    "modding",
    "forge",
    "network",
    "shared-draft",
    "private-playtest",
    "smoke",
    "structural-staging",
    "structural-review",
    "prepared-sources"
  ],
  "paths_of_interest": [
    "port/src/main.c",
    "port/src/net/grid_edit_room_net.c",
    "port/src/net/netmsg.c",
    "port/src/pdmain.c",
    "src/game/bg.c",
    "port/src/forge_room_builder.cpp",
    "port/src/grid_match_runtime.c",
    "port/src/forge_level_io.c",
    "port/src/net/grid_edit_room_wire.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 720,
  "install_state": "clean",
  "remove_paths": [
    "grid-prepared-host",
    "grid-prepared-creator",
    "grid-prepared-ordinary"
  ],
  "fixtures": [
    {
      "src": "dev-mods/grid_two_rooms/grid_two_rooms.pdarena",
      "dst": "grid/templates/grid_two_rooms.pdarena"
    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "grid-prepared-host/mods/.pdmod-migration-done"
    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "grid-prepared-creator/mods/.pdmod-migration-done"
    },
    {
      "src": "tools/smoke-verify/fixtures/pdmod_migration_done.txt",
      "dst": "grid-prepared-ordinary/mods/.pdmod-migration-done"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/mod.json",
      "dst": "grid-prepared-host/mods/example_typed_pdxxx_basic/mod.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/meshes/tri_mesh.pdmesh",
      "dst": "grid-prepared-host/mods/example_typed_pdxxx_basic/meshes/tri_mesh.pdmesh"
    },
    {
      "src": "tools/smoke-verify/fixtures/typed_pdxxx_basic_enabled.json",
      "dst": "grid-prepared-host/mods-enabled.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/mod.json",
      "dst": "grid-prepared-creator/mods/example_typed_pdxxx_basic/mod.json"
    },
    {
      "src": "examples/modding/typed-pdxxx-basic/meshes/tri_mesh.pdmesh",
      "dst": "grid-prepared-creator/mods/example_typed_pdxxx_basic/meshes/tri_mesh.pdmesh"
    },
    {
      "src": "tools/smoke-verify/fixtures/typed_pdxxx_basic_enabled.json",
      "dst": "grid-prepared-creator/mods-enabled.json"
    }
  ],
  "processes": [
    {
      "name": "host",
      "log_file": "pd-host.log",
      "boot_args": [
        "--portable",
        "--savedir",
        "$E/grid-prepared-host",
        "--moddir",
        "$E/grid-prepared-host/mods",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--debug-level-tool-new",
        "original",
        "--debug-level-tool-name",
        "Grid_Playtest_Source",
        "--debug-grid-room-size",
        "2100,2700,1800,600,500,390",
        "--debug-forge-level",
        "mod:arena_grid_playtest_source",
        "--debug-forge-level-name",
        "Grid_Playtest_Draft",
        "--debug-forge-level-prop",
        "example:tri_mesh",
        "--debug-forge-level-decoration",
        "--debug-forge-level-atmosphere",
        "--debug-forge-level-pin",
        "--host",
        "--listen-bind",
        "27489",
        "--launch-mp-room",
        "mod:arena_grid_playtest_draft",
        "base:combat",
        "3",
        "--host-autostart",
        "--host-autostart-peers",
        "2",
        "--debug-grid-private-draft",
        "host",
        "--debug-grid-private-room-extension",
        "--debug-grid-private-prepared-review"
      ],
      "wait_for": "NET: created server on port 27489",
      "wait_timeout_seconds": 240,
      "assertions": {
        "required_sequences": [
          {
            "name": "host-and-creator-match-prepared-sources-without-activating-the-variant",
            "patterns": [
              "LEVELTOOL\\.ORIGINAL\\.SEED: template=mod_grid_two_rooms:arena_grid_two_rooms seed_catalogued=0",
              "FORGE\\.REVISION\\.PIN: arena=mod:arena_grid_playtest_draft sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.EDIT: granted client=1",
              "GRID\\.PLAYTEST: prepared room=[0-9]+ arena=mod:arena_grid_playtest_draft",
              "NET\\.GRID\\.PLAYTEST: roster room=[0-9]+ players=1 bots=3 ready_mask=0x00000001",
              "GRID\\.MATCH\\.STAGE: active arena=mod:arena_grid_playtest_draft epoch=[1-9][0-9]* digest=[0-9a-f]{64}",
              "GRID\\.PLAYTEST: active room=[0-9]+ epoch=[1-9][0-9]* arena=mod:arena_grid_playtest_draft",
              "GRID\\.PLAYTEST: applied visual ambient epoch=[1-9][0-9]* revision=1 enabled=1 brightness=104",
              "GRID\\.PLAYTEST\\.LIGHT: stage=0x[0-9a-f]+ ambient=104 rooms=[1-9][0-9]* sample_room=[1-9][0-9]* native=[0-9.]+ rendered=[0-9.]+",
              "SMOKE\\.GRID\\.PLAYTEST: release_creator room=[0-9]+ generation=1 epoch=[1-9][0-9]*",
              "NET\\.GRID\\.EDIT: committed revision=2 author=2",
              "GRID\\.PLAYTEST: applied visual ambient epoch=[1-9][0-9]* revision=2 enabled=1 brightness=137",
              "GRID\\.PLAYTEST\\.LIGHT: stage=0x[0-9a-f]+ ambient=137 rooms=[1-9][0-9]* sample_room=[1-9][0-9]* native=[0-9.]+ rendered=[0-9.]+",
              "SMOKE\\.GRID\\.PLAYTEST: rendered edit epoch=[1-9][0-9]* revision=2 before=[0-9.]+ native=[0-9.]+ after=[0-9.]+",
              "GRID\\.MATCH\\.PREFLIGHT: detached arena=mod:arena_grid_extension_staged scenario=mod:arena_grid_extension_staged__[A-Za-z0-9_]+ sha256=[0-9a-f]{64}",
              "GRID\\.MATCH\\.PREFLIGHT: extension walk arena=mod:arena_grid_extension_staged sha256=[0-9a-f]{64} starts=8 links=16",
              "GRID\\.PLAYTEST: staged native variant=mod:arena_grid_extension_staged revision=2 room=2 extension=300 active_epoch=[1-9][0-9]* draft_generation=1 sha256=[0-9a-f]{64} parent=[0-9a-f]{64}",
              "SMOKE\\.GRID\\.EXTENSION: resident unchanged epoch=[1-9][0-9]* catalog=[1-9][0-9]* revision=2 room1_max=0 room2_max=2700 refused_length=1400 sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW: offered creator=1 serial=[1-9][0-9]* epoch=[1-9][0-9]* revision=2 arena=mod:arena_grid_extension_staged",
              "NET\\.GRID\\.REVIEW\\.DEPS: offered serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.PREPARED: retained role=host serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.PREPARED: matched creator=1 serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.CANDIDATE: prepared serial=[1-9][0-9]* epoch=[1-9][0-9]* entries=[1-9][0-9]* packages=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW: creator=1 replied serial=[1-9][0-9]* result=4",
              "SMOKE\\.GRID\\.EXTENSION: review prepared room=[0-9]+ generation=1 epoch=[1-9][0-9]* revision=2 serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET: SVC_STAGE_END published and committed, returning to lobby",
              "GAMELOOP\\.MP: endscreen EXIT_TO_ROOM",
              "GRID\\.MATCH\\.ROOM: world retired room=[0-9]+",
              "SMOKE\\.GRID\\.EXTENSION: prepared review retired room=[0-9]+ epoch=[1-9][0-9]* revision=2 creator_lobby=1 ordinary_lobby=1",
              "SMOKE\\.GRID\\.DRAFT: role=host closed room=[0-9]+ creator_lobby=1 ordinary_lobby=1",
              "SMOKE: result=grid_draft_complete .*code=0"
            ]
          }
        ],
        "required_lines": [
          "SAVE: initialized .*grid-prepared-host",
          "SCENARIO\\.SOURCE: resolved room domain 'mod:arena_grid_playtest_draft__[a-zA-Z0-9_]+' rooms=3 declared=3 mesh_max=2 portal_max=2",
          "PLAYER\\.INIT\\.COMMIT lobby-start room=[0-9]+ mode=0 players=1 bots=3",
          "NET\\.MATCH\\.AUDIENCE room=[0-9]+ admitted=0x00000001 sent=0x00000000 lobby_retained=2 failed=0",
          "SIMULANT: spawning done total=3",
          "GRID\\.STAGED\\.SOURCES: verified arena=mod:arena_grid_extension_staged revision=[0-9a-f]{64} entries=([4-9]|[1-9][0-9]+) packages=([3-9]|[1-9][0-9]+) digest=[0-9a-f]{64}",
          "FORGE\\.LEVEL\\.EDIT: made decoration setup_[0-9]+ drawn with example:tri_mesh",
          "NET\\.GRID\\.REVIEW\\.PREPARED: released serial=[1-9][0-9]* reason=[A-Za-z_-]+"
        ],
        "forbidden_patterns": [
          "NET\\.GRID\\.EDIT: (invited|granted) client=2",
          "GRID\\.MATCH\\.STAGE: active arena=mod:arena_grid_extension_staged",
          "GRID\\.PLAYTEST: staged native variant=mod:arena_grid_extension_too_long",
          "NET\\.GRID\\.REVIEW: creator=[0-9]+ replied serial=[0-9]+ result=[123]",
          "NET\\.GRID\\.REVIEW\\.DEPS: unavailable"
        ],
        "required_counts": [
          {
            "pattern": "GRID\\.PLAYTEST: staged native variant=",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET\\.GRID\\.PLAYTEST: roster room=[0-9]+ players=1 bots=3 ready_mask=0x00000001",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET\\.MATCH\\.AUDIENCE room=[0-9]+ admitted=0x00000001 sent=0x00000000 lobby_retained=2 failed=0",
            "min": 1,
            "max": 1
          },
          {
            "pattern": "NET\\.GRID\\.REVIEW\\.PREPARED: retained role=host",
            "min": 1,
            "max": 1
          }
        ]
      }
    },
    {
      "name": "creator",
      "log_file": "pd-grid-creator.log",
      "boot_args": [
        "--portable",
        "--savedir",
        "$E/grid-prepared-creator",
        "--moddir",
        "$E/grid-prepared-creator/mods",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--debug-level-tool-new",
        "original",
        "--debug-level-tool-name",
        "Grid_Playtest_Source",
        "--debug-grid-room-size",
        "2100,2700,1800,600,500,390",
        "--debug-forge-level",
        "mod:arena_grid_playtest_source",
        "--debug-forge-level-name",
        "Grid_Playtest_Draft",
        "--debug-forge-level-prop",
        "example:tri_mesh",
        "--debug-forge-level-decoration",
        "--debug-forge-level-atmosphere",
        "--debug-forge-level-pin",
        "--connect-host",
        "127.0.0.1:27489",
        "--debug-grid-private-draft",
        "creator",
        "--debug-grid-private-room-extension",
        "--debug-grid-private-prepared-review"
      ],
      "wait_for": "NET: SVC_AUTH from server, our ID is 1",
      "wait_timeout_seconds": 240,
      "assertions": {
        "required_sequences": [
          {
            "name": "creator-authors-before-connecting-and-independently-matches-the-staged-candidate",
            "patterns": [
              "SMOKE\\.GRID\\.EXTENSION: creator authored locally arena=mod:arena_grid_extension_staged sha256=[0-9a-f]{64} parent=[0-9a-f]{64} before_connect=1",
              "NET: SVC_AUTH from server, our ID is 1",
              "NET: SVC_ROOM_ASSIGN: assigned to room [0-9]+",
              "NET\\.GRID\\.EDIT: verified baseline and accepted creator grant",
              "SMOKE\\.GRID\\.PLAYTEST: creator sent ambient=137 host_epoch=[1-9][0-9]* room=[0-9]+ lobby=1",
              "NET\\.GRID\\.EDIT: observed revision=2 author=2",
              "SMOKE\\.GRID\\.DRAFT: role=creator revision=2 ambient=137",
              "GRID\\.STAGED\\.SOURCES: verified arena=mod:arena_grid_extension_staged revision=[0-9a-f]{64} entries=([4-9]|[1-9][0-9]+) packages=([3-9]|[1-9][0-9]+) digest=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.DEPS: local verified serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "NET\\.GRID\\.REVIEW\\.PREPARED: retained role=creator serial=[1-9][0-9]* sha256=[0-9a-f]{64}",
              "SMOKE\\.GRID\\.EXTENSION: creator prepared room=[0-9]+ generation=1 epoch=[1-9][0-9]* revision=2 serial=[1-9][0-9]* sha256=[0-9a-f]{64} installed=1",
              "SMOKE\\.GRID\\.DRAFT: role=creator closed room=[0-9]+ lobby=1",
              "SMOKE: result=grid_draft_complete .*code=0"
            ]
          }
        ],
        "required_lines": [
          "SAVE: initialized .*grid-prepared-creator",
          "FORGE\\.LEVEL\\.EDIT: made decoration setup_[0-9]+ drawn with example:tri_mesh",
          "NET\\.GRID\\.REVIEW\\.PREPARED: released serial=[1-9][0-9]* reason=[A-Za-z_-]+"
        ],
        "required_counts": [
          {
            "pattern": "NET\\.GRID\\.REVIEW\\.PREPARED: retained role=creator",
            "min": 1,
            "max": 1
          }
        ],
        "forbidden_patterns": [
          "NET\\.GRID\\.OFFER: guest",
          "SVC_STAGE_START read",
          "SVC_STAGE_END read",
          "NET\\.GRID\\.RESULT:",
          "GRID\\.MATCH\\.STAGE: active"
        ]
      }
    },
    {
      "name": "ordinary",
      "log_file": "pd-grid-ordinary.log",
      "boot_args": [
        "--portable",
        "--savedir",
        "$E/grid-prepared-ordinary",
        "--moddir",
        "$E/grid-prepared-ordinary/mods",
        "--no-update-check",
        "--no-sound",
        "--skip-intro",
        "--connect-host",
        "127.0.0.1:27489",
        "--debug-grid-private-draft",
        "ordinary",
        "--debug-grid-private-room-extension",
        "--debug-grid-private-prepared-review"
      ],
      "assertions": {
        "required_sequences": [
          {
            "name": "ordinary-peer-stays-through-normal-host-shutdown",
            "patterns": [
              "NET: SVC_AUTH from server, our ID is 2",
              "NET: SVC_ROOM_ASSIGN: assigned to room [0-9]+",
              "SMOKE\\.GRID\\.DRAFT: role=ordinary client=2 room=[0-9]+ lobby=1",
              "NET: disconnected from server: Server is shutting down \\(1\\)",
              "SMOKE\\.GRID\\.DRAFT: role=ordinary disconnected room=[0-9]+",
              "SMOKE: result=grid_draft_complete .*code=0"
            ]
          }
        ],
        "required_lines": [
          "SAVE: initialized .*grid-prepared-ordinary"
        ],
        "forbidden_patterns": [
          "NET\\.GRID\\.EDIT\\.WIRE: received",
          "NET\\.GRID\\.OFFER: guest",
          "SVC_STAGE_START read",
          "SVC_STAGE_END read",
          "NET\\.GRID\\.RESULT:",
          "GRID\\.MATCH\\.STAGE: active",
          "NET\\.GRID\\.REVIEW\\.PREPARED:",
          "SMOKE\\.GRID\\.EXTENSION: creator authored locally"
        ]
      }
    }
  ],
  "input_sequence": [],
  "assertions": {
    "forbidden_patterns": [
      "SMOKE\\.GRID\\.DRAFT: failed",
      "SMOKE: result=timeout",
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: "
    ]
  }
}
