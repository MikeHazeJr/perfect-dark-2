{
  "scenario_name": "forge_grid_atmosphere_smoke",
  "description": "Author sky color, fog, ambient room brightness, and a catalog soundtrack in the Blank Room. Save the arena through Level File and verify the normal stage loader applies each rule during play.",
  "tags": [
    "modding",
    "forge",
    "arena",
    "pdarena",
    "smoke",
    "pillar:modding"
  ],
  "paths_of_interest": [
    "port/src/forge_level_io.c",
    "port/src/forge_level_doc.cpp",
    "port/src/scenario_stage_rules.cpp",
    "port/src/scenario_source_runtime.c",
    "src/game/env.c",
    "src/game/stagemusic.c"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 300,
  "install_state": "clean",
  "remove_paths": [
    "mods/blank_room",
    "mods/MP Maps/arena_grid_atmosphere"
  ],
  "fixtures": [
    {
      "src": "dev-mods/blank_room/mod.json",
      "dst": "mods/blank_room/mod.json"
    },
    {
      "src": "dev-mods/blank_room/blank_room.pdarena",
      "dst": "mods/blank_room/blank_room.pdarena"
    },
    {
      "src": "tools/smoke-verify/fixtures/blank_room_enabled.json",
      "dst": "mods-enabled.json"
    }
  ],
  "boot_args": [
    "--no-update-check",
    "--no-sound",
    "--no-net",
    "--portable",
    "--debug-forge-level",
    "mod_blank_room:arena_blank_room",
    "--debug-forge-level-name",
    "Grid_Atmosphere",
    "--debug-forge-level-atmosphere",
    "--launch-mp-room",
    "mod:arena_grid_atmosphere",
    "base:combat",
    "3",
    "--debug-auto-start-match"
  ],
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 240000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900
    },
    {
      "at_ms": 8000,
      "type": "exit"
    }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=forge_grid_atmosphere_smoke",
      "FORGE\\.LEVEL\\.EDIT: authored stage atmosphere",
      "FORGE\\.LEVEL\\.SAVE\\.OK: template=mod_blank_room:arena_blank_room catalog=mod:arena_grid_atmosphere",
      "SCENARIO\\.SOURCE: atmosphere for 'mod:arena_grid_atmosphere__[^']*' sky=1 rgb=15,35,75 fog=1 range=120,480 ambient=1 level=104 music='base:song_sequence_b' track=1 source=stage.json",
      "ENV\\.ATMOSPHERE: stage=0x[0-9a-f]+ sky=15,35,75 fog=1 range=120,480",
      "SCENARIO\\.SOURCE: atmosphere default room=1 brightness=104",
      "MUSIC: musicStartPrimary track=1 ",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready .*stable_ms=3000",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "SMOKE: result=timeout",
      "MODAUTHOR\\.[A-Z.]*FAIL",
      "FORGE\\.LEVEL\\.[A-Z.]*FAIL",
      "stage\\.json of .* refused"
    ]
  }
}
