  "assertions": {
    "required_lines": [
      "SMOKE: scenario=maian_vehicle_boost_smoke",
      "MODAUTHOR\\.SAVE\\.OK kind=vehicle catalog=mod:vehicle_maian_hover mod_id=mod\\.vehicle_maian_hover updated=0",
      "MODAUTHOR\\.CATALOG\\.OK catalog=mod:vehicle_maian_hover type=\\d+ enabled=1 bundled=0",
      "MODAUTHOR\\.RECIPE\\.RESULT result=OK catalog=mod:vehicle_maian_hover",
      "PDVEHICLE\\.MODEL: id=mod:vehicle_maian_hover model=mod:vehicle_maian_hover__\\S+ modelnum=\\d+ filenum=\\d+",
      "BOOT: --no-net set; netInit\\(\\) skipped",
      "BOOT: --launch-mission 'base:escape' -> stagenum=",
      "BOOT: --debug-mount-bike armed",
      "BOOT: --debug-swap-vehicle mod:vehicle_maian_hover armed",
      "SMOKE\\.WAIT: satisfied condition=offline_gameplay_ready",
      "VEHICLE\\.SWAP: hoverbike modelnum 58 -> \\d+ \\(mod:vehicle_maian_hover\\)",
      "VEHICLE\\.SWAP: modelnum \\d+ takes the world scale of modelnum 58 \\(409/4096\\)",
      "BOOT: --debug-mount-bike consumed: .*result=MOUNTED",
      "SMOKE\\.WAIT: satisfied condition=vehicle_driver_ready",
      "VEHICLE: input .*accel=(?:[1-9][0-9]*\\.[0-9]+|0\\.[0-9]*[1-9][0-9]*)",
      "VEHICLE: input .*boost=1\\.00",
      "VEHICLE\\.BOOST: modelnum=\\d+ boost and heat on: boost_speed=7\\.00 ramp=240 overheat=960 overheated_boost=0\\.50 recover=480 ticks240",
      "VEHICLE\\.BOOST: modelnum=\\d+ phase cool -> ramping",
      "VEHICLE\\.BOOST: modelnum=\\d+ phase ramping -> full .*turret_locked=1",
      "VEHICLE\\.BOOST: modelnum=\\d+ phase full -> overheated .*turret_locked=1",
      "VEHICLE\\.BOOST: modelnum=\\d+ part 140 hidden \\(crystals black\\)",
      "VEHICLE\\.BOOST: modelnum=\\d+ phase overheated -> recovering",
      "VEHICLE\\.BOOST: modelnum=\\d+ phase recovering -> cool .*turret_locked=0",
      "VEHICLE\\.BOOST: modelnum=\\d+ part 140 shown \\(crystals cool\\)",
      "SMOKE: result=scripted_exit"
