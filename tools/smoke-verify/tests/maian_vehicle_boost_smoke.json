      "at_ms": 16000,
      "type": "action",
      "name": "ACTION_VEHICLE_BOOST",
      "action": "release",
      "comment": "Let go after 5.5 s: the crystals stay black while they recover."
    },
    {
      "at_ms": 16000,
      "type": "action",
      "name": "ACTION_VEHICLE_ACCELERATE",
      "action": "release",
      "comment": "Slow down; recovery is faster at low speed."
    },
    {
      "at_ms": 23000,
      "type": "exit",
