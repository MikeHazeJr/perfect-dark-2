    },
    {
      "at_ms": 9000,
      "type": "wait_until",
      "condition": "offline_gameplay_ready",
      "timeout_ms": 45000,
      "stable_ms": 500,
      "comment": "Player 0 is on foot with control, so the armed mount hook can fire."
    },
    {
      "at_ms": 9000,
      "type": "wait_until",
      "condition": "vehicle_driver_ready",
      "timeout_ms": 60000,
      "stable_ms": 1000,
