{
  "scenario_name": "asset_audio_public_source_smoke",
  "description": "Verify the stock intro typing cues retain every PCM frame at the native playback clock. Verify the base SFX and voice walkers use public source controls and preserve the active row when edits are invalid.",
  "tags": [
    "runtime",
    "assets",
    "audio",
    "source-authority",
    "transaction"
  ],
  "timeout_seconds": 90,
  "install_state": "clean",
  "boot_args": [
    "--no-update-check",
    "--no-net",
    "--portable",
    "--skip-intro",
    "--debug-asset-audio-public-source"
  ],
  "input_sequence": [],
  "assertions": {
    "required_lines": [
      "ASSET\\.AUDIO\\.PUBLIC: case=base_packed_keymap_source_controls_and_provider result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: witness=base_packed_keymap id=base:sfx_unlabeled_avrm .*provider=FileProvider source_rate_hz=22050 .*result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: case=base_intro_typing_uses_native_sample_clock result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: witness=base_intro_typing id=base:sfx_unlabeled_pz source_soundnum=441 source_rate_hz=22050 decoded_frames=21664 expected_frames=21664 result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: witness=base_intro_typing id=base:sfx_unlabeled_qb source_soundnum=443 source_rate_hz=22050 decoded_frames=112 expected_frames=112 result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: case=sfx_walker_public_source_controls result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: case=voice_walker_public_source_and_metadata result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: case=walker_replacement_ignores_stale_private_echoes result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: case=malformed_public_control_preserves_live_row result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: case=missing_public_member_preserves_live_row result=PASS",
      "ASSET\\.AUDIO\\.PUBLIC: passed=7 cases=7 result=PASS",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "ASSET\\.AUDIO\\.PUBLIC: .*result=FAIL",
      "SMOKE: result=timeout",
      "EXCEPTION_ACCESS_VIOLATION",
      "refusing native bank fallback"
    ],
    "required_counts": [
      {
        "pattern": "ASSET\\.AUDIO\\.PUBLIC: case=.* result=PASS",
        "min": 7,
        "max": 7
      }
    ]
  }
}
