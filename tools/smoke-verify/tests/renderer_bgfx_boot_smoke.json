{
  "scenario_name": "renderer_bgfx_boot_smoke",
  "description": "2.0 renderer phase 2a (D5): --renderer bgfx presents through bgfx's OpenGL backend on its own, not only beside the classic renderer. Boots to Agent Select and the Main Menu and captures the window, which in bgfx mode is the back buffer bgfx drew. Screenshots sit on the virtual timeline after each readiness wait.",
  "tags": ["render", "bgfx", "visual", "menu", "smoke"],
  "paths_of_interest": [
    "port/fast3d/gfx_bgfx.cpp",
    "port/fast3d/imgui_impl_bgfx.cpp",
    "port/fast3d/scenario_scene_renderer_bgfx.cpp",
    "third_party/bgfx-pd/CMakeLists.txt"
  ],
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 360,
  "install_state": "current",
  "remove_paths": ["bgfx-home"],
  "fixtures": [
    { "src": "tools/smoke-verify/fixtures/agent_smoke.json", "dst": "bgfx-home/agent_smoke.json" }
  ],
  "boot_args": ["--no-update-check", "--no-sound", "--no-net", "--portable", "--savedir", "./bgfx-home",
                "--main-menu", "--renderer", "bgfx"],
  "input_sequence": [
    { "at_ms": 0, "type": "wait_until", "condition": "agent_select_ready", "timeout_ms": 300000, "stable_ms": 3000 },
    { "at_ms": 2500, "type": "screenshot", "path": "bgfx-agent-select.bmp" },
    { "at_ms": 4000, "type": "key", "key": "Return", "action": "tap" },
    { "at_ms": 4250, "type": "wait_until", "condition": "main_menu_play_ready", "timeout_ms": 30000, "stable_ms": 3000 },
    { "at_ms": 7500, "type": "screenshot", "path": "bgfx-main-menu.bmp" },
    { "at_ms": 9000, "type": "exit" }
  ],
  "retain_artifacts": [
    { "src": "bgfx-agent-select.bmp" },
    { "src": "bgfx-main-menu.bmp" }
  ],
  "assertions": {
    "required_lines": [
      "SMOKE: scenario=renderer_bgfx_boot_smoke",
      "bgfx: using the bgfx renderer \\(OpenGL backend\\)",
      "bgfx: renderer OpenGL",
      "SMOKE\\.WAIT: satisfied condition=main_menu_play_ready ",
      "SMOKE\\.GLSHOT: captured .*bgfx-agent-select\\.bmp",
      "SMOKE\\.GLSHOT: captured .*bgfx-main-menu\\.bmp",
      "SMOKE: result=scripted_exit"
    ],
    "forbidden_patterns": [
      "EXCEPTION_ACCESS_VIOLATION",
      "FATAL: ",
      "bgfx: fatal",
      "SMOKE: result=timeout",
      "using the classic OpenGL renderer"
    ],
    "required_counts": []
  }
}
