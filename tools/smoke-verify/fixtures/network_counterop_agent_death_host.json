      "timeout_ms": 300000,
      "at_ms": 0,
      "comment": "The ordinary ready gate, typed stage publication, load, allocation and spawn are live."
    },
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "gameplay_ready",
      "timeout_ms": 60000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900,
      "comment": "Usable control, with one bounded Skip if the authored intro owns input."
    },
    {
      "at_ms": 15000,
      "type": "kill_player",
      "comment": "The agent (host player 0) dies through playerDie: the counter-operative's win."
    },
    {
      "type": "wait_until",
      "condition": "endscreen_visible",
      "timeout_ms": 90000,
      "stable_ms": 1000,
      "at_ms": 0,
      "comment": "The agent's own results, a failed mission, after the death animation."
    },
    {
      "at_ms": 12000,
      "type": "exit",
      "comment": "Scripted clean exit after the client has left its results."
    }
  ]
}
