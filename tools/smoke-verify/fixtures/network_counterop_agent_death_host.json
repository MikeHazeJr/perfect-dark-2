{
  "scenario_name": "network_counterop_agent_death_host",
  "description": "Host schedule for network_counterop_agent_death_smoke.",
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 600,
  "input_sequence": [
    {
      "type": "wait_until",
