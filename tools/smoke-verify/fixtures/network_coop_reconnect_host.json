{
  "scenario_name": "network_coop_reconnect_host",
  "description": "Host schedule for network_coop_reconnect_smoke.",
  "log_channel_mask": "all",
  "verbose": 0,
  "timeout_seconds": 860,
  "input_sequence": [
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "network_stage_live",
      "timeout_ms": 300000,
      "comment": "The client joined, the ready gate ran and the mission is live on the host."
    },
    {
      "at_ms": 0,
      "type": "wait_until",
      "condition": "gameplay_ready",
      "timeout_ms": 60000,
      "stable_ms": 3000,
      "assist_action": "ACTION_SKIP_CUTSCENE",
      "assist_condition": "cutscene_skip_ready",
      "assist_hold_ms": 900,
      "comment": "Usable co-op control, with one bounded Skip if the authored intro owns input."
    },
    {
      "at_ms": 5000,
      "type": "network_timeout_client",
      "client_id": 1,
      "comment": "The partner drops: the production timeout path for client 1."
    },
    {
      "at_ms": 5000,
      "type": "wait_until",
      "condition": "endscreen_visible",
      "timeout_ms": 300000,
      "stable_ms": 1000,
      "comment": "The host plays on; the partner rejoins; --debug-end-mission ends the mission at 150 s."
    },
    {
      "at_ms": 9000,
      "type": "exit",
      "comment": "Scripted clean exit 4 s (script time) after the host's results."
    }
  ]
}
