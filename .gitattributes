# Priority L bug-queue (e), 2026-04-25 — pin line endings to prevent the
# repeated CRLF flip auto-commits the auditor flagged.  Mirrors the
# .editorconfig contract (`end_of_line = lf` for all files by default).
#
# - Default: detect text vs binary, normalise text to LF in the index.
# - Windows-only scripts (.bat, .cmd, .ps1) keep CRLF in the working tree
#   because Windows shell hosts misbehave on bare-LF input.
# - Common binary types are flagged so Git never tries to diff/normalise.
# - Generated headers (versioninfo.h, updater_pubkey.h) are tracked but
#   their content is regenerated by the build; pin to LF for consistency.

# Default: auto-detect text, normalise to LF in the index.
* text=auto eol=lf

# C / C++ source and headers — LF.
*.c        text eol=lf
*.cc       text eol=lf
*.cpp      text eol=lf
*.cxx      text eol=lf
*.h        text eol=lf
*.hpp      text eol=lf
*.hxx      text eol=lf
*.inc      text eol=lf
*.s        text eol=lf
*.S        text eol=lf

# Build / project files — LF.
*.cmake             text eol=lf
CMakeLists.txt      text eol=lf
Makefile            text eol=lf
*.mk                text eol=lf
*.in                text eol=lf

# Documentation and config — LF.
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.ini     text eol=lf
*.toml    text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf

# Shell scripts (run from MSYS/bash) — LF.
*.sh      text eol=lf

# Python — LF.
*.py      text eol=lf

# Asset descriptors — LF.
*.glsl    text eol=lf
*.frag    text eol=lf
*.vert    text eol=lf

# Windows-only scripts — CRLF (cmd.exe / PowerShell expect it).
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary types — never normalise, never diff.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.bmp     binary
*.tga     binary
*.ico     binary
*.icns    binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.gz      binary
*.tar     binary
*.7z      binary
*.exe     binary
*.dll     binary
*.so      binary
*.a       binary
*.lib     binary
*.obj     binary
*.o       binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.psd     binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.flac    binary
*.mp4     binary
*.bin     binary
*.dat     binary
*.rom     binary
*.iso     binary
*.z64     binary
*.n64     binary
*.v64     binary
